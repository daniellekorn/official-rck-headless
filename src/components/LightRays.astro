---
/**
 * LightRays — soft volumetric "streaming light" that radiates from a center
 * point, fading toward the edges so it reads as glow rather than hard lines
 * (cue: yukollella.com). Built from a masked conic-gradient, so the beams are
 * crisp vector rays but with soft, gradient edges — no draw-on "popping".
 *
 * Drop it as the first child of a `relative` wrapper and the light radiates
 * from that wrapper's center, spilling past its edges. Decorative + inert.
 *
 * Motion: the field slowly breathes (spreads out, eases back) and drifts in
 * rotation — both continuous, so there is no restart "jump". Honors
 * prefers-reduced-motion by holding a static glow.
 */
interface Props {
	/** Number of beams around the full circle. */
	count?: number;
	/** Beam color (any CSS color). Defaults to brand gold-400. */
	color?: string;
	/** Peak opacity of the light field. */
	opacity?: number;
	/** Breathing cycle (spread out → ease back), in ms. */
	duration?: number;
	/**
	 * Motion style:
	 * - "drift" (default): slow circular spin + gentle breathe (current homepage look)
	 * - "sunbeams": parallel warm beams stream diagonally past the element,
	 *   drifting like sun through a window (the chosen homepage look — see #024)
	 * - "burst": rays shoot outward and retract, on a loop
	 * - "burst-static": rays shoot outward once on load, then hold
	 * - "spiral": counter-rotating layers + zoom — fancy spiral
	 * - "sweep": a single bright wedge rotates like a lighthouse beam
	 */
	variant?: "drift" | "sunbeams" | "burst" | "burst-static" | "spiral" | "sweep";
	/** Extra classes for sizing/placement of the (square) light field. */
	class?: string;
}

const {
	count = 40,
	color = "#dfb030",
	opacity = 0.45,
	duration = 8000,
	variant = "drift",
	class: className = "",
} = Astro.props;

const period = 360 / count;
const vars = [
	`--rck-rc:${color}`,
	`--rck-period:${period}deg`,
	`--rck-opacity:${opacity}`,
	`--rck-dur:${duration}ms`,
].join(";");
---

<div
	class:list={["rck-rays pointer-events-none absolute left-1/2 top-1/2 -z-10 aspect-square -translate-x-1/2 -translate-y-1/2", `rck-rays--${variant}`, className]}
	aria-hidden="true"
	style={vars}
>
	<div class="rck-rays__spread">
		<div class="rck-rays__beams"></div>
	</div>
</div>

<style is:global>
	.rck-rays {
		/* keep it square regardless of the width class passed in */
		isolation: isolate;
	}
	.rck-rays__spread,
	.rck-rays__beams {
		position: absolute;
		inset: 0;
	}
	.rck-rays__spread {
		opacity: var(--rck-opacity);
		animation: rck-rays-breathe var(--rck-dur) ease-in-out infinite;
		will-change: transform, opacity;
	}
	.rck-rays__beams {
		/* Crisp vector beams with soft gradient edges: each `period` ramps
		   transparent → color → transparent, so the rays never hard-edge. */
		background: repeating-conic-gradient(
			from 0deg,
			color-mix(in srgb, var(--rck-rc), transparent 100%) 0deg,
			var(--rck-rc) calc(var(--rck-period) / 2),
			color-mix(in srgb, var(--rck-rc), transparent 100%) var(--rck-period)
		);
		/* fade the center (so light reads as coming from behind the element)
		   and the outer edge (volumetric falloff) */
		-webkit-mask-image: radial-gradient(closest-side, transparent 4%, #000 14%, #000 72%, transparent 99%);
		mask-image: radial-gradient(closest-side, transparent 4%, #000 14%, #000 72%, transparent 99%);
		animation: rck-rays-drift calc(var(--rck-dur) * 16) linear infinite;
		will-change: transform;
	}

	@keyframes rck-rays-breathe {
		0%,
		100% {
			transform: scale(0.99);
			opacity: calc(var(--rck-opacity) * 0.85);
		}
		50% {
			transform: scale(1.03);
			opacity: var(--rck-opacity);
		}
	}
	@keyframes rck-rays-drift {
		to {
			transform: rotate(360deg);
		}
	}

	/* ── Variants ───────────────────────────────────────────────────────────
	   The default ("drift") uses the rules above. Each variant below overrides
	   only the spread/beams animations, so the field keeps the same masked
	   conic-gradient beams. */

	/* BURST — shoot outward and retract, looping. */
	.rck-rays--burst .rck-rays__spread {
		animation: rck-rays-burst var(--rck-dur) cubic-bezier(0.16, 0.8, 0.3, 1) infinite;
	}
	.rck-rays--burst .rck-rays__beams {
		animation: rck-rays-drift calc(var(--rck-dur) * 26) linear infinite;
	}
	@keyframes rck-rays-burst {
		0% { transform: scale(0.2); opacity: calc(var(--rck-opacity) * 0.1); }
		38% { transform: scale(1.35); opacity: var(--rck-opacity); }
		60% { transform: scale(1.1); opacity: calc(var(--rck-opacity) * 0.7); }
		100% { transform: scale(0.2); opacity: calc(var(--rck-opacity) * 0.1); }
	}

	/* BURST-STATIC — shoot outward once on load, then hold (beams static). */
	.rck-rays--burst-static .rck-rays__spread {
		transform: scale(0.2);
		opacity: 0;
		animation: rck-rays-burst-in var(--rck-dur) cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	.rck-rays--burst-static .rck-rays__beams {
		animation: none;
	}
	@keyframes rck-rays-burst-in {
		0% { transform: scale(0.2); opacity: 0; }
		100% { transform: scale(1); opacity: var(--rck-opacity); }
	}

	/* SPIRAL — counter-rotating layers + zoom for a fancy spiral. */
	.rck-rays--spiral .rck-rays__spread {
		animation: rck-rays-spiral-spread calc(var(--rck-dur) * 2.2) ease-in-out infinite;
	}
	.rck-rays--spiral .rck-rays__beams {
		animation: rck-rays-spiral-beams calc(var(--rck-dur) * 3.2) linear infinite;
	}
	@keyframes rck-rays-spiral-spread {
		0%, 100% { transform: rotate(0deg) scale(0.8); opacity: calc(var(--rck-opacity) * 0.65); }
		50% { transform: rotate(45deg) scale(1.22); opacity: var(--rck-opacity); }
	}
	@keyframes rck-rays-spiral-beams {
		to { transform: rotate(-360deg); }
	}

	/* SWEEP — a single soft bright wedge rotates like a lighthouse beam. */
	.rck-rays--sweep .rck-rays__spread {
		animation: none;
		opacity: var(--rck-opacity);
	}
	.rck-rays--sweep .rck-rays__beams {
		background: conic-gradient(
			from 0deg,
			color-mix(in srgb, var(--rck-rc), transparent 100%) 0deg,
			var(--rck-rc) 16deg,
			color-mix(in srgb, var(--rck-rc), transparent 100%) 64deg,
			color-mix(in srgb, var(--rck-rc), transparent 100%) 360deg
		);
		animation: rck-rays-drift calc(var(--rck-dur) * 1.5) linear infinite;
	}

	/* SUNBEAMS — parallel warm beams streaming diagonally past the element,
	   drifting slowly like sunlight through a window. Replaces the conic beam
	   field with a striped linear-gradient, masked to a soft centered pool so
	   it glows behind the element rather than hard-edging. (Chosen #024.) */
	.rck-rays--sunbeams .rck-rays__spread {
		animation: none;
		opacity: var(--rck-opacity);
	}
	.rck-rays--sunbeams .rck-rays__beams {
		inset: -20%;
		background: repeating-linear-gradient(
			115deg,
			transparent 0 20px,
			color-mix(in srgb, var(--rck-rc), transparent 55%) 20px 27px,
			transparent 27px 54px
		);
		-webkit-mask-image: radial-gradient(65% 65% at 50% 50%, #000 22%, transparent 80%);
		mask-image: radial-gradient(65% 65% at 50% 50%, #000 22%, transparent 80%);
		animation: rck-rays-stream calc(var(--rck-dur) * 0.9) ease-in-out infinite alternate;
		will-change: transform;
	}
	@keyframes rck-rays-stream {
		from { transform: translate(-6%, -6%); }
		to { transform: translate(6%, 6%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.rck-rays__spread {
			transform: scale(1);
			opacity: var(--rck-opacity);
			animation: none;
		}
		.rck-rays__beams {
			animation: none;
		}
		.rck-rays--burst-static .rck-rays__spread {
			transform: scale(1);
			opacity: var(--rck-opacity);
		}
	}
</style>
