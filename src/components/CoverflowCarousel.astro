---
import { flyerAlt } from "../lib/flyers";

interface Item {
	title?: string;
	imageUrl?: string;
	pdfUrl?: string;
}

interface Props {
	items: Item[];
	autoplayMs?: number;
}

const { items, autoplayMs = 3000 } = Astro.props;

// When an `aside` slot is provided (e.g. the Learn page's schedule), the band
// becomes a two-column layout — aside on the left, carousel on the right — and
// the cards spread wider to fill the space. Without it, the carousel stays the
// original full-bleed, centered band (events / youth pages).
const hasAside = Astro.slots.has("aside");
---

<section
	class:list={[
		"bg-white overflow-hidden",
		hasAside ? "with-aside py-14 sm:py-16" : "py-16 sm:py-20",
	]}
	data-coverflow-section
>
	<div
		class:list={[
			hasAside &&
				"container-page grid items-center gap-10 lg:gap-12 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)]",
		]}
	>
		{hasAside && (
			<aside class="mx-auto w-full max-w-sm lg:mx-0">
				<slot name="aside" />
			</aside>
		)}
		<div class:list={[hasAside && "min-w-0 w-full"]}>
	<div class="coverflow-stage" data-coverflow data-autoplay-ms={autoplayMs}>
		{items.map((item, i) => (
			<div
				class:list={[
					"coverflow-card",
					i === 0 ? "pos-active"
					: i === 1 ? "pos-next"
					: i === items.length - 1 ? "pos-prev"
					: "pos-far",
				]}
				data-index={i}
			>
				<div class="coverflow-inner">
					{item.imageUrl ? (
						<div class="coverflow-media">
							<img
								src={item.imageUrl}
								alt={flyerAlt(item.title, item.title ?? "")}
								loading={i === 0 ? "eager" : "lazy"}
								class="coverflow-img"
							/>
							<div class="coverflow-actions">
								<button
									type="button"
									class="coverflow-btn"
									data-lightbox-open
									data-lightbox-src={item.imageUrl}
									data-lightbox-title={item.title}
									aria-label={`View ${item.title ?? "flyer"} full size`}
								>
									<svg viewBox="0 0 24 24" class="coverflow-btn-icon" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</button>
								<button
									type="button"
									class="coverflow-btn"
									data-download
									data-download-src={item.imageUrl}
									data-download-title={item.title}
									aria-label={`Download ${item.title ?? "flyer"}`}
								>
									<svg viewBox="0 0 24 24" class="coverflow-btn-icon" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</button>
							</div>
							{item.title && <p class="coverflow-label">{item.title}</p>}
						</div>
					) : item.pdfUrl ? (
						<iframe
							src={`https://docs.google.com/viewer?url=${encodeURIComponent(item.pdfUrl)}&embedded=true`}
							title={item.title}
							loading="lazy"
							class="absolute inset-0 w-full h-full border-0 rounded-xl shadow-[0_25px_60px_-18px_rgba(7,23,58,0.35)]"
						/>
					) : (
						<div class="coverflow-placeholder" role="img" aria-label={`${item.title ?? "Flyer"} — coming soon`}>
							<svg viewBox="0 0 24 24" class="coverflow-placeholder-icon" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
								<rect x="3" y="3" width="18" height="18" rx="2" />
								<path d="M3 15l5-5 4 4 3-3 6 6" stroke-linecap="round" stroke-linejoin="round" />
								<circle cx="8.5" cy="8.5" r="1.5" />
							</svg>
							<span class="coverflow-placeholder-text">Coming soon</span>
						</div>
					)}
				</div>
				{/* Image cards carry their label inside .coverflow-media so it hugs the
				    picture; only iframe/placeholder cards use this card-anchored one. */}
				{!item.imageUrl && item.title && <p class="coverflow-label">{item.title}</p>}
			</div>
		))}

		<button
			type="button"
			data-coverflow-prev
			aria-label="Previous"
			class="coverflow-arrow coverflow-arrow-prev"
		>
			<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
		<button
			type="button"
			data-coverflow-next
			aria-label="Next"
			class="coverflow-arrow coverflow-arrow-next"
		>
			<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
	</div>

	<div class="flex justify-center gap-2 mt-6" data-coverflow-dots>
		{items.map((_, i) => (
			<button
				type="button"
				data-dot
				data-index={i}
				aria-label={`Go to slide ${i + 1}`}
				class:list={[
					"rounded-sm transition-all duration-300 h-1.5",
					i === 0 ? "w-6 bg-gold-400" : "w-1.5 bg-navy-200 hover:bg-navy-300",
				]}
			/>
		))}
	</div>
	</div>
	</div>
</section>

<style is:global>
	.coverflow-stage {
		position: relative;
		height: clamp(300px, 50vh, 460px);
		perspective: 1100px;
		perspective-origin: 50% 50%;
	}

	.coverflow-card {
		position: absolute;
		width: min(240px, 55vw);
		height: 100%;
		left: 50%;
		top: 0;
		margin-left: calc(-1 * min(120px, 27.5vw));
		border-radius: 0.75rem;
		transition:
			transform 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			opacity 0.32s ease;
		cursor: pointer;
	}

	/* The card box is only a positioning/3D frame — it paints nothing, so the
	   flyer image is "just what it is" on the white band (design log #039).
	   The image, not the box, carries the shadow; media centers vertically. */
	.coverflow-inner {
		width: 100%;
		height: 100%;
		position: relative;
		display: flex;
		align-items: center;
	}

	.coverflow-media {
		position: relative;
		width: 100%;
	}

	.coverflow-img {
		display: block;
		width: 100%;
		height: auto;
		box-shadow: 0 25px 60px -18px rgba(7, 23, 58, 0.35);
	}

	/* Expand + Download buttons — only on the active card, revealed on hover.
	   Hidden on side/far cards so they don't clutter the 3D stack. */
	.coverflow-actions {
		position: absolute;
		top: 0.5rem;
		inset-inline-end: 0.5rem;
		display: flex;
		gap: 0.375rem;
		opacity: 0;
		transform: translateY(-0.25rem);
		transition: opacity 0.25s ease, transform 0.25s ease;
		z-index: 2;
	}
	.coverflow-card.pos-active:hover .coverflow-actions,
	.coverflow-card.pos-active:focus-within .coverflow-actions {
		opacity: 1;
		transform: translateY(0);
	}
	.coverflow-card:not(.pos-active) .coverflow-actions {
		display: none;
	}
	@media (hover: none) {
		.coverflow-card.pos-active .coverflow-actions { opacity: 1; transform: none; }
	}
	.coverflow-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 0.25rem;
		color: var(--color-navy-700, #07173a);
		background: rgb(255 255 255 / 0.92);
		box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.6);
		transition: background 0.18s;
	}
	.coverflow-btn:hover { background: var(--color-gold-400, #dfb030); }
	.coverflow-btn-icon { width: 1rem; height: 1rem; }

	/* Cream panel, matching Flyer.astro's placeholder. Unlike images it has no
	   artwork edges, so it keeps a card surface (radius/hairline/shadow). */
	.coverflow-placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 1rem;
		text-align: center;
		background: linear-gradient(150deg, var(--color-paper), var(--color-mist) 55%, var(--color-gold-50));
		color: var(--color-navy-400);
		border-radius: 0.75rem;
		border: 1px solid var(--color-navy-100);
		box-shadow: 0 25px 60px -18px rgba(7, 23, 58, 0.35);
	}
	.coverflow-placeholder-icon {
		width: 2.5rem;
		height: 2.5rem;
		color: var(--color-gold-500);
		opacity: 0.9;
	}
	.coverflow-placeholder-text {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.coverflow-label {
		text-align: center;
		font-size: 0.75rem;
		color: var(--color-navy-400);
		margin-top: 0.6rem;
		padding: 0 0.5rem;
		position: absolute;
		inset-inline: 0;
		bottom: -1.5rem;
	}

	/* Inside .coverflow-media the label sits in flow, hugging the image bottom
	   (the card box is taller than most flyers, so a card-anchored label would
	   float far below the picture). */
	.coverflow-media .coverflow-label {
		position: static;
	}

	.coverflow-card.pos-active {
		transform: translateX(0) scale(1) rotateY(0deg);
		opacity: 1;
		z-index: 10;
	}

	.coverflow-card.pos-active:hover,
	.coverflow-card.pos-active.is-zoomed {
		transform: translateX(0) scale(1.35) rotateY(0deg);
		z-index: 20;
		cursor: zoom-in;
	}

	.coverflow-card.pos-active.is-zoomed {
		cursor: zoom-out;
	}

	.coverflow-card.pos-prev {
		transform: translateX(-96%) scale(0.8) rotateY(36deg);
		opacity: 0.6;
		z-index: 5;
	}

	.coverflow-card.pos-next {
		transform: translateX(96%) scale(0.8) rotateY(-36deg);
		opacity: 0.6;
		z-index: 5;
	}

	.coverflow-card.pos-far {
		transform: translateX(0) scale(0.55) rotateY(0deg);
		opacity: 0;
		z-index: 1;
		pointer-events: none;
	}

	.coverflow-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 30;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.125rem;
		background: rgb(255 255 255 / 0.92);
		color: var(--color-navy-600);
		border: 1px solid var(--color-navy-100);
		box-shadow: 0 10px 24px -12px rgba(7, 23, 58, 0.4);
		display: flex;
		align-items: center;
		justify-content: center;
		backdrop-filter: blur(4px);
		transition: background 0.2s;
	}

	.coverflow-arrow:hover {
		background: var(--color-gold-400);
	}

	/* Flank the center card rather than the page edges.
	   Card half-width = min(120px, 27.5vw); arrow width ≈ 2.75rem; gap 0.5rem */
	.coverflow-arrow-prev {
		left: calc(50% - min(120px, 27.5vw) - 3.25rem);
	}
	.coverflow-arrow-next {
		right: calc(50% - min(120px, 27.5vw) - 3.25rem);
	}

	/* Two-column "with aside" layout (Learn page): bigger cards, pushed further
	   apart to fill the right column so the band doesn't read as a small thing
	   floating in whitespace. Scoped so events / youth carousels are untouched. */
	.with-aside .coverflow-stage {
		height: clamp(340px, 52vh, 520px);
	}
	.with-aside .coverflow-card {
		width: min(300px, 70vw);
		margin-left: calc(-0.5 * min(300px, 70vw));
	}
	.with-aside .coverflow-card.pos-prev {
		transform: translateX(-90%) scale(0.8) rotateY(36deg);
	}
	.with-aside .coverflow-card.pos-next {
		transform: translateX(90%) scale(0.8) rotateY(-36deg);
	}
	.with-aside .coverflow-arrow-prev {
		left: calc(50% - min(150px, 35vw) - 3.25rem);
	}
	.with-aside .coverflow-arrow-next {
		right: calc(50% - min(150px, 35vw) - 3.25rem);
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>("[data-coverflow]").forEach((stage) => {
		const section = stage.closest<HTMLElement>("[data-coverflow-section]")!;
		const cards = Array.from(stage.querySelectorAll<HTMLElement>(".coverflow-card"));
		const dotsWrap = section.querySelector<HTMLElement>("[data-coverflow-dots]");
		const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll<HTMLButtonElement>("[data-dot]")) : [];
		const prevBtn = stage.querySelector<HTMLButtonElement>("[data-coverflow-prev]");
		const nextBtn = stage.querySelector<HTMLButtonElement>("[data-coverflow-next]");
		if (cards.length === 0) return;

		const n = cards.length;
		const AUTOPLAY_MS = Number(stage.dataset.autoplayMs) || 3000;
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		const go = (idx: number) => {
			current = ((idx % n) + n) % n;
			cards.forEach((c) => c.classList.remove("is-zoomed"));
			cards.forEach((card, i) => {
				const diff = ((i - current) % n + n) % n;
				card.classList.remove("pos-active", "pos-next", "pos-prev", "pos-far");
				if (diff === 0) card.classList.add("pos-active");
				else if (diff === 1) card.classList.add("pos-next");
				else if (diff === n - 1) card.classList.add("pos-prev");
				else card.classList.add("pos-far");
			});
			dots.forEach((d, i) => {
				const active = i === current;
				d.classList.toggle("w-6", active);
				d.classList.toggle("bg-gold-400", active);
				d.classList.toggle("w-1.5", !active);
				d.classList.toggle("bg-navy-200", !active);
			});
		};

		const start = () => {
			stop();
			timer = setInterval(() => go(current + 1), AUTOPLAY_MS);
		};
		const stop = () => {
			if (timer) clearInterval(timer);
		};

		prevBtn?.addEventListener("click", () => { go(current - 1); start(); });
		nextBtn?.addEventListener("click", () => { go(current + 1); start(); });

		cards.forEach((card, i) => {
			card.addEventListener("click", (e) => {
				// Let the Expand/Download buttons do their own thing (lightbox /
				// download) without also toggling the coverflow zoom.
				if ((e.target as HTMLElement).closest("[data-lightbox-open],[data-download]")) return;
				if (card.classList.contains("pos-active")) {
					const nowZoomed = card.classList.toggle("is-zoomed");
					if (nowZoomed) {
						stop();
					} else {
						start();
					}
				} else {
					go(i);
					start();
				}
			});
			// hover-pause only on pointer devices — touch devices use click only
			if (window.matchMedia("(hover: hover)").matches) {
				card.addEventListener("mouseenter", () => {
					if (card.classList.contains("pos-active")) stop();
				});
				card.addEventListener("mouseleave", () => {
					if (!card.classList.contains("is-zoomed")) start();
				});
			}
		});

		dots.forEach((dot) => {
			dot.addEventListener("click", () => {
				go(Number(dot.dataset.index));
				start();
			});
		});

		document.addEventListener("click", (e) => {
			if (!stage.contains(e.target as Node)) {
				cards.forEach((c) => c.classList.remove("is-zoomed"));
				start();
			}
		});

		start();
	});
</script>
