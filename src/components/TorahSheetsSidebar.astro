---
/**
 * Sidebar body for one Torah Sheets tab — rendered twice by the page (once
 * inside a mobile `<details>` disclosure, once inside the persistent desktop
 * aside; a `<details>`'s open state can't be forced open at a breakpoint via
 * CSS alone, so both copies exist rather than one being toggled — same
 * reasoning as Footer.astro's mobile Quick Links list). Filtering itself is
 * plain data-attribute + script, same pattern as learn.astro's filter bar.
 *
 * "nested" (Torah Bytes / Dor L'Dor ParshaLink): Sefer/Chagim/Pirkei Avos as collapsible
 * groups, individual parshios/perakim/chagim as the actual filter buttons.
 * "flat" (Source Sheets): topics as filter buttons, no grouping.
 *
 * The "Publication" group at the top switches between the three series —
 * it replaced a separate top pill-tab row so the whole page reads as one
 * consistent sidebar-driven browse experience (matches the Denver Kollel
 * reference's own "Publication" facet). It's deliberately not collapsible
 * like the Sefer groups below it — it's primary navigation, not a filter
 * someone browses selectively.
 */
import type { SheetGroup, SheetSuperGroup } from "../lib/torah-sheets";

interface Props {
	kind: "nested" | "flat";
	superGroups?: SheetSuperGroup[];
	groups?: SheetGroup[];
	publications: { key: string; label: string }[];
	activePublication: string;
}

const { kind, superGroups = [], groups = [], publications, activePublication } = Astro.props;
const activeLabel = publications.find((p) => p.key === activePublication)?.label ?? "";
---

<div class="mb-4 pb-4 border-b border-navy-100">
	<p class="sidebar-section-label">Publication</p>
	<div class="mt-2 space-y-0.5">
		{publications.map((p) => (
			<button
				type="button"
				data-pub-select={p.key}
				class:list={["sidebar-filter-btn w-full text-left", { "is-active": p.key === activePublication }]}
			>
				{p.label}
			</button>
		))}
	</div>
</div>

<p class="sidebar-section-label">Filter {activeLabel}</p>

<button
	type="button"
	data-filter-reset
	class="sidebar-filter-btn mt-2 w-full text-left font-semibold text-navy-600"
>
	All Sheets
</button>

{kind === "nested" ? (
	<div class="mt-2 space-y-1">
		{superGroups.map((sg) => (
			<details class="sidebar-group">
				<summary class="sidebar-group-label">
					{sg.label}
					<svg viewBox="0 0 12 12" class="sidebar-group-chevron" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<path d="M2.5 4.5 6 8l3.5-3.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>
				<div class="mt-1 space-y-0.5 pl-3">
					{sg.groups.map((g) => (
						<button
							type="button"
							data-filter-option={g.key}
							class="sidebar-filter-btn w-full text-left"
						>
							{g.label}
						</button>
					))}
				</div>
			</details>
		))}
	</div>
) : (
	<div class="mt-2 space-y-0.5">
		{groups.map((g) => (
			<button
				type="button"
				data-filter-option={g.key}
				class="sidebar-filter-btn w-full text-left"
			>
				{g.label}
			</button>
		))}
	</div>
)}

<style>
	.sidebar-filter-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		border-radius: 0.25rem;
		padding: 0.375rem 0.5rem;
		font-size: 0.875rem;
		color: var(--color-navy-500);
		transition: background-color 0.15s, color 0.15s;
	}
	.sidebar-filter-btn:hover {
		background-color: var(--color-navy-50, #eaedf3);
		color: var(--color-navy-700);
	}
	.sidebar-filter-btn.is-active {
		background-color: var(--color-gold-100);
		color: var(--color-navy-700);
		font-weight: 600;
	}
	.sidebar-section-label {
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-navy-400);
	}

	.sidebar-group {
		border-top: 1px solid var(--color-navy-50, #eaedf3);
		padding-top: 0.5rem;
		margin-top: 0.5rem;
	}
	.sidebar-group-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		cursor: pointer;
		list-style: none;
		font-size: 0.8125rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-navy-400);
	}
	.sidebar-group-label::-webkit-details-marker {
		display: none;
	}
	.sidebar-group-chevron {
		width: 0.7rem;
		height: 0.7rem;
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}
	.sidebar-group[open] .sidebar-group-chevron {
		transform: rotate(180deg);
	}
</style>
