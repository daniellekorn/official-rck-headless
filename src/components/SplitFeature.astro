---
import Highlight from "./Highlight.astro";
import LightRays from "./LightRays.astro";

interface Props {
	/** Optional leading word, rendered navy *before* the gold word. Lets a
	    section read navy → gold → navy ("blue yellow blue"). */
	eyebrowLead?: string;
	eyebrowGold: string;
	eyebrowNavy: string;
	subheadLine1: string;
	subheadLine2?: string;
	subheadAccent?: "line1" | "line2";
	body: string;
	imageOn?: "left" | "right";
	imageUrl?: string;
	imageAlt?: string;
	/** Render the drifting gold sunbeams behind the image. */
	rays?: boolean;
}

const {
	eyebrowLead,
	eyebrowGold,
	eyebrowNavy,
	subheadLine1,
	subheadLine2,
	subheadAccent = "line2",
	body,
	imageOn = "left",
	imageUrl,
	imageAlt = "",
	rays = false,
} = Astro.props;
---

<section class="relative overflow-hidden py-14 md:py-20">
	<div class="container-page">
		<div
			class:list={[
				"grid items-center gap-12 md:gap-16 lg:gap-20",
				"md:grid-cols-2",
			]}
		>
			<div
				class:list={["relative flex items-center self-stretch", imageOn === "right" ? "md:order-2" : "md:order-1"]}
				data-reveal={imageOn === "right" ? "right" : "left"}
			>
				{/* self-stretch (above) makes this wrapper fill the full row height —
				    not just the image's own aspect-[4/3] box — so LightRays (centered
				    on the wrapper) is anchored to the section's actual vertical
				    center. Without it, a shorter image centered by the grid's
				    items-center against a taller text column pulls the glow's center
				    off the section's midpoint, and how far it reaches toward the top
				    ends up depending on how long that column's body text happens to
				    be. flex items-center here keeps the image itself visually
				    centered within the now-taller wrapper. */}
				{rays && <LightRays variant="sunbeams" class="w-[205%] min-w-[600px]" opacity={0.4} duration={11000} />}
				{imageUrl ? (
					<img
						src={imageUrl}
						alt={imageAlt}
						loading="lazy"
						class="aspect-[4/3] w-full overflow-hidden rounded-md object-cover ring-1 ring-navy-100"
					/>
				) : (
					<div
						class="relative aspect-[4/3] w-full overflow-hidden rounded-md ring-1 ring-navy-100 bg-navy-50"
						aria-label="Photo placeholder"
					>
						{/* Brand pinstripes + monogram so an empty image slot reads as a
						    deliberate panel, not a broken image. */}
						<div
							class="absolute inset-0 opacity-60"
							style="background-image: repeating-linear-gradient(45deg, var(--color-navy-100) 0 1px, transparent 1px 14px);"
							aria-hidden="true"
						>
						</div>
						<div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
							<span class="font-display text-5xl sm:text-6xl font-medium text-navy-200" aria-hidden="true">RCK</span>
							<span class="gold-rule-sm opacity-70" aria-hidden="true"></span>
						</div>
					</div>
				)}
			</div>

			<div class:list={[imageOn === "right" ? "md:order-1" : "md:order-2"]}>
				<p class="eyebrow text-base! sm:text-lg! leading-none" data-reveal="left">
					{eyebrowLead && <span class="text-navy-600 mr-1.5">{eyebrowLead}</span>}
					<span class="text-gold-600">{eyebrowGold}</span>
					<span class="text-navy-600 ml-1.5">{eyebrowNavy}</span>
				</p>

				<h2 class="mt-4 font-display text-[2rem] sm:text-[2.5rem] md:text-[3rem] leading-[1.05] font-medium uppercase text-navy-600" data-reveal="left" data-reveal-delay="120">
					<span class="block">
						{
							subheadAccent === "line1" ? (
								<Highlight duration={1400} delay={500}>{subheadLine1}</Highlight>
							) : (
								<span>{subheadLine1}</span>
							)
						}
					</span>
					{
						subheadLine2 && (
							<span class="block">
								{subheadAccent === "line2" ? (
									<Highlight duration={1400} delay={500}>{subheadLine2}</Highlight>
								) : (
									<span>{subheadLine2}</span>
								)}
							</span>
						)
					}
				</h2>

				<p class="mt-6 max-w-prose text-base md:text-[1.0625rem] leading-relaxed text-navy-500" data-reveal="up" data-reveal-delay="260">
					{body}
				</p>
			</div>
		</div>
	</div>
</section>
