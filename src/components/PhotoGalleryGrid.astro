---
/**
 * PhotoGalleryGrid — a responsive grid of thumbnails for one event's photos
 * and (optionally) videos. Clicking any thumbnail opens the site-wide
 * Lightbox (see Lightbox.astro) in gallery mode, positioned on the clicked
 * item, with prev/next scoped to *this* event's items only — photos and
 * videos share one continuous "swipe through" sequence (see design log #050).
 *
 * A video thumbnail shows the YouTube thumbnail image with a play-button
 * overlay; clicking it opens the same lightbox, which embeds the actual
 * player. Photos still use their cropped-to-fill thumbnail; the lightbox
 * itself gets each photo's uncropped `fullSrc` so a portrait shot isn't
 * clipped when blown up full-size.
 */
import type { GalleryMediaItem } from "../lib/wix-media";

interface Props {
	items: GalleryMediaItem[];
	label?: string;
}

const { items, label = "" } = Astro.props;

// What the Lightbox reads: a plain URL string for a photo, matching its
// existing gallery-mode contract, or a `{ type: "youtube", videoId }` slide.
const galleryJson = JSON.stringify(
	items.map((it) => (it.type === "image" ? it.fullSrc : { type: "youtube", videoId: it.videoId })),
);

const alt = (i: number) => (label ? `${label} — photo ${i + 1}` : `Photo ${i + 1}`);
---

{items.length > 0 && (
	<div class="rck-gal-grid">
		{items.map((it, i) => (
			<button
				type="button"
				data-lightbox-open
				data-lightbox-gallery={galleryJson}
				data-lightbox-index={i}
				data-lightbox-title={label}
				class="rck-gal-grid-item"
				aria-label={it.type === "image" ? `Open ${alt(i)} full size` : `Play ${label ? `${label} video` : "video"}`}
			>
				{it.type === "image" ? (
					<img src={it.src} alt={alt(i)} loading="lazy" />
				) : (
					<>
						<img
							src={`https://img.youtube.com/vi/${it.videoId}/hqdefault.jpg`}
							alt={label ? `${label} — video` : "Video"}
							loading="lazy"
						/>
						<span class="rck-gal-play" aria-hidden="true">
							<svg viewBox="0 0 24 24" class="rck-gal-play-icon" fill="currentColor">
								<path d="M8 5v14l11-7L8 5Z" />
							</svg>
						</span>
					</>
				)}
			</button>
		))}
	</div>
)}

<style is:global>
	.rck-gal-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.6rem;
	}
	@media (min-width: 640px) {
		.rck-gal-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.rck-gal-grid-item {
		position: relative;
		aspect-ratio: 4 / 3;
		border-radius: 0.5rem;
		overflow: hidden;
		background: var(--color-navy-800);
		box-shadow: 0 10px 26px -14px rgb(from var(--color-navy-700) r g b / 0.5);
		transition: transform 0.2s, box-shadow 0.2s;
	}
	.rck-gal-grid-item:hover,
	.rck-gal-grid-item:focus-visible {
		transform: translateY(-2px);
		box-shadow: 0 16px 34px -16px rgb(from var(--color-navy-700) r g b / 0.6);
	}
	.rck-gal-grid-item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Play-button overlay on a video thumbnail — centered gold disc, same
	   hover lift as the card itself gives enough affordance without a label. */
	.rck-gal-play {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgb(from var(--color-navy-700) r g b / 0.25);
		transition: background 0.2s;
	}
	.rck-gal-grid-item:hover .rck-gal-play,
	.rck-gal-grid-item:focus-visible .rck-gal-play {
		background: rgb(from var(--color-navy-700) r g b / 0.35);
	}
	.rck-gal-play-icon {
		width: 3rem;
		height: 3rem;
		color: #fff;
		filter: drop-shadow(0 4px 10px rgb(0 0 0 / 0.45));
	}
</style>
