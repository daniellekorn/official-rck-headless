---
/**
 * A flyer card: the framed flyer, its title, and the link line beneath it.
 * A row with a Hebrew flyer (`imageUrlHebrew`) holds both languages: a button
 * on the picture flips it over, and the title and link follow. See design-log #084.
 */
import Flyer from "./Flyer.astro";
import FlyerFlip from "./FlyerFlip.astro";
import FlyerLinkLine from "./FlyerLinkLine.astro";
import { isBilingual, type Flyer as FlyerRow } from "../lib/flyers";
import { flyerLink } from "../lib/flyer-link";

interface Props {
	flyer: FlyerRow;
}

const { flyer } = Astro.props;
const bilingual = isBilingual(flyer);
const link = flyerLink(flyer);
---

<div class="rounded-md overflow-hidden bg-white ring-1 ring-navy-100 shadow-sm">
	{bilingual ? (
		<div
			class="bi"
			data-bilingual
			data-flyer-id={flyer._id}
			data-view="english"
		>
			<FlyerFlip
				imageUrl={flyer.imageUrl!}
				imageUrlHebrew={flyer.imageUrlHebrew!}
				title={flyer.title}
				titleHebrew={flyer.titleHebrew}
			/>
			<div class="bi-captions">
				<div data-face="english">
					{flyer.title && <p class="font-medium text-navy-700 text-sm" dir="auto">{flyer.title}</p>}
					{link && <FlyerLinkLine link={link} text={link.text} />}
				</div>
				<div data-face="hebrew" lang="he" dir="rtl">
					{flyer.titleHebrew && <p class="font-medium text-navy-700 text-sm">{flyer.titleHebrew}</p>}
					{link && <FlyerLinkLine link={link} text={link.textHebrew} />}
				</div>
			</div>
		</div>
	) : (
		<>
			<Flyer imageUrl={flyer.imageUrl} pdfUrl={flyer.pdfUrl} title={flyer.title} />
			{(flyer.title || flyer.titleHebrew || link) && (
				<div class="flex flex-col gap-3 p-4">
					{(flyer.title || link) && (
						<div>
							{flyer.title && <p class="font-medium text-navy-700 text-sm" dir="auto">{flyer.title}</p>}
							{link && <FlyerLinkLine link={link} text={link.text} />}
						</div>
					)}
					{flyer.titleHebrew && (
						<div lang="he" dir="rtl">
							<p class="font-medium text-navy-700 text-sm">{flyer.titleHebrew}</p>
							{link && flyer.linkTextHebrew && <FlyerLinkLine link={link} text={link.textHebrew} />}
						</div>
					)}
				</div>
			)}
		</>
	)}
</div>

<style>
	.bi-captions {
		display: grid;
		padding: 1rem;
	}
	.bi-captions > div {
		grid-area: 1 / 1;
		min-width: 0;
		transition: opacity 0.25s ease, visibility 0.25s;
	}
	/* Both captions hold the space, so flipping never changes the card height. */
	.bi[data-view="english"] .bi-captions > [data-face="hebrew"],
	.bi[data-view="hebrew"] .bi-captions > [data-face="english"] {
		opacity: 0;
		visibility: hidden;
	}

	@media (prefers-reduced-motion: reduce) {
		.bi-captions > div {
			transition: none;
		}
	}
</style>
