---
/**
 * ImpactStats — thin dark-navy band between the Hero and the first content
 * section, showing a row of headline numbers (years running, shiurim/week,
 * etc.) that count up from zero once scrolled into view. A single row at
 * `sm:` and up; on narrow phones, five columns squeezed into one line read
 * as cramped, so mobile renders as two centered rows instead (first 3, then
 * the remainder). Each row's items split *that row's* width evenly (rather
 * than every item assuming a fixed 1/3 width) — a first attempt gave every
 * item the same fixed width regardless of which row it landed in, which
 * made the longer word-values ("HUNDREDS"/"THOUSANDS") overflow their column
 * and overlap on the 2-item row. See design log #051.
 *
 * A stat's `value` is free text (e.g. "27+", "1,000", "HUNDREDS") — the
 * client script parses out a leading/trailing non-numeric prefix/suffix and
 * a numeric core to animate; a value with no digits at all (e.g. "HUNDREDS")
 * just fades in as-is, since there's nothing to count.
 */
interface Stat {
	value?: string;
	label?: string;
}

interface Props {
	stats: Stat[];
}

const { stats } = Astro.props;
const visible = stats.filter((s) => s.value && s.label);

// Mobile-only split: first row holds up to 3, the rest wrap to a second,
// narrower (and thus roomier per-item) row. Unused at `sm:` and up, where
// everything renders in the single full row instead.
const firstRow = visible.slice(0, 3);
const secondRow = visible.slice(3);

const numberClasses =
	"font-display font-bold text-white leading-none text-[clamp(1.35rem,7.5vw,2rem)] sm:text-[clamp(0.95rem,3.6vw,2.1rem)] tabular-nums";
const labelClasses =
	"mt-1.5 sm:mt-2.5 font-sans text-[clamp(0.55rem,2.6vw,0.75rem)] sm:text-[clamp(0.4rem,1.7vw,0.625rem)] font-semibold uppercase tracking-[0.05em] sm:tracking-[0.12em] text-gold-300 leading-tight";
---

{visible.length > 0 && (
	<section class="relative bg-navy-700 py-7 sm:py-9 md:py-10" data-stats-band>
		{/* Same fade-at-the-edges hairline shape as Footer.astro's seam, but
		    flat (no glow) and a touch more opaque at its center — a quieter
		    line of contrast between the hero above (now faded to the same
		    navy-700) and this band, not a decorative accent. */}
		<div aria-hidden="true" class="absolute inset-x-0 top-0 h-px w-full bg-gradient-to-r from-transparent via-gold-500/60 to-transparent"></div>
		<div class="container-page lg:px-14">
			{/* Mobile: two centered rows. */}
			<div class="sm:hidden">
				<div class="flex items-stretch justify-center gap-x-3">
					{firstRow.map((s) => (
						<div class="min-w-0 flex-1 text-center">
							<p class={numberClasses} data-stat-number data-stat-value={s.value}>{s.value}</p>
							<p class={labelClasses}>{s.label}</p>
						</div>
					))}
				</div>
				{secondRow.length > 0 && (
					<div class="mx-auto mt-6 flex max-w-[85%] items-stretch justify-center gap-x-3">
						{secondRow.map((s) => (
							<div class="min-w-0 flex-1 text-center">
								<p class={numberClasses} data-stat-number data-stat-value={s.value}>{s.value}</p>
								<p class={labelClasses}>{s.label}</p>
							</div>
						))}
					</div>
				)}
			</div>

			{/* `sm:` and up: everything in one row. */}
			<div class="hidden sm:flex flex-nowrap items-stretch justify-between gap-6">
				{visible.map((s) => (
					<div class="min-w-0 flex-1 text-center">
						<p class={numberClasses} data-stat-number data-stat-value={s.value}>{s.value}</p>
						<p class={labelClasses}>{s.label}</p>
					</div>
				))}
			</div>
		</div>
	</section>
)}

<script>
	// Count-up on scroll-into-view, and again every time a hover-capable
	// pointer mouses over a number. Each stat's raw value (e.g. "27+", "1,000",
	// "HUNDREDS") is parsed into an optional prefix, a numeric core, and an
	// optional suffix; a value with no digits (nothing to count) is left
	// exactly as authored and never animates. Skips all of this entirely under
	// reduced-motion (final values are already server-rendered, so there's
	// nothing extra to do in that case).
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const nodes = document.querySelectorAll<HTMLElement>("[data-stat-number]");
	if (reduce || !nodes.length) {
		// no-op: server-rendered text is already the final value
	} else {
		type Parsed = { prefix: string; suffix: string; target: number; grouped: boolean };

		const parse = (raw: string): Parsed | null => {
			const m = raw.match(/^(\D*)([\d,]+)(\D*)$/);
			if (!m) return null;
			const [, prefix, numStr, suffix] = m;
			const target = parseInt(numStr.replace(/,/g, ""), 10);
			if (Number.isNaN(target)) return null;
			return { prefix, suffix, target, grouped: numStr.includes(",") };
		};

		const DURATION = 1500;
		// Linear, not eased — an ease-out curve decelerates near the target, so a
		// count like 27 spends most of its 1.5s crawling through the last few
		// numbers while the early ones fly by. A constant rate keeps every count
		// (27, 1,000, whatever) advancing at the same visual pace start to finish.
		const linear = (t: number) => t;

		// A hover replay can start mid-animation (or mid-replay) — this tracks
		// each element's latest "run" so a stale rAF loop bows out instead of
		// fighting a newer one over textContent.
		const runIds = new WeakMap<HTMLElement, number>();

		const animateStat = (el: HTMLElement, parsed: Parsed) => {
			const runId = (runIds.get(el) ?? 0) + 1;
			runIds.set(el, runId);
			el.textContent = `${parsed.prefix}0${parsed.suffix}`;
			const start = performance.now();
			const step = (now: number) => {
				if (runIds.get(el) !== runId) return; // superseded by a newer run
				const t = Math.min(1, (now - start) / DURATION);
				const current = Math.round(parsed.target * linear(t));
				const formatted = parsed.grouped ? current.toLocaleString("en-US") : String(current);
				el.textContent = `${parsed.prefix}${formatted}${parsed.suffix}`;
				if (t < 1) requestAnimationFrame(step);
			};
			requestAnimationFrame(step);
		};

		// Replay on hover — mouse only; touch's synthetic "hover after tap"
		// would just replay on every tap, which reads as noise, not a feature.
		if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
			nodes.forEach((el) => {
				el.addEventListener("mouseenter", () => {
					const parsed = parse(el.dataset.statValue ?? "");
					if (parsed) animateStat(el, parsed);
				});
			});
		}

		if (typeof IntersectionObserver !== "undefined") {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry, i) => {
						if (!entry.isIntersecting) return;
						const el = entry.target as HTMLElement;
						observer.unobserve(el);
						const raw = el.dataset.statValue ?? "";
						const parsed = parse(raw);
						if (!parsed) return; // e.g. "HUNDREDS" — nothing to count, already showing final text
						setTimeout(() => animateStat(el, parsed), i * 90);
					});
				},
				{ threshold: 0.4 },
			);
			nodes.forEach((el) => observer.observe(el));
		}
	}
</script>
