---
/**
 * Call + WhatsApp button pair for a phone number — every RCK contact number
 * works on both regular calls/texts and WhatsApp, so any listed number gets
 * both actions rather than a plain tel: link. Extracted from community.astro,
 * which previously hand-duplicated this exact markup for each hardcoded
 * contact (Yael Bernstein, Rabbi Zaslow, Rabbi Bernstein).
 *
 * Number is expected in local Israeli format (e.g. "053-216-4726") or fully
 * international with a leading "+"; see src/lib/phone.ts for the `tel:` and
 * WhatsApp (`wa.me`) link derivation.
 */
import { telHref, whatsappHref } from "../lib/phone";

interface Props {
	phone: string;
	/** Used in the buttons' aria-labels, e.g. "Call {name}". */
	name: string;
	class?: string;
}
const { phone, name, class: className } = Astro.props;
const btnClass =
	"group inline-flex items-center gap-1.5 rounded-sm border border-gold-500 px-3 py-1.5 text-sm font-semibold text-navy-600 transition-colors hover:bg-gold-100 active:bg-gold-100";
---

<div class:list={["flex items-center gap-2", className]}>
	<a href={telHref(phone)} aria-label={`Call ${name}`} class={btnClass}>
		<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
			<path d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" />
		</svg>
		Call
	</a>
	<a href={whatsappHref(phone)} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${name}`} class={btnClass}>
		<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
			<path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.85-1.46A10 10 0 1 0 12 2Zm0 18.2a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-2.86.86.86-2.78-.2-.32A8.2 8.2 0 1 1 12 20.2Z"/>
			<path d="M17.5 14.4c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.14-1.14-.42-2.17-1.34-.8-.71-1.34-1.6-1.5-1.87-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.46l-.52-.01c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27 0 1.34.97 2.63 1.11 2.81.14.18 1.91 2.92 4.63 4.09.65.28 1.15.45 1.54.58.65.2 1.24.18 1.71.11.52-.08 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32Z"/>
		</svg>
		WhatsApp
	</a>
</div>
