---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navLinks = [
	{ label: "Home", href: "/" },
	{ label: "Meet the Team", href: "/team" },
	{ label: "Daven with Us", href: "/daven" },
	{ label: "Learn with Us", href: "/learn" },
	{ label: "Programming", href: "/programming" },
].map((l) => ({
	...l,
	active: l.href === "/" ? pathname === "/" : pathname.startsWith(l.href),
}));

const isContactActive = pathname === "/contact";

// One consistent treatment on every page: a white pill, lifted off the page by
// a soft shadow, with a hairline gold edge for brand definition. It reads the
// same over the dark homepage hero and on white interior pages. On scroll the
// shadow deepens slightly and the bar settles toward the top — no color or
// size change.
---

<header
	class="fixed inset-x-0 top-0 z-50 pt-4 sm:pt-6 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
	data-nav-header
>
	<div class="container-page">
		<nav
			class="nav-pill mx-auto flex max-w-6xl items-center justify-between gap-3 sm:gap-4 rounded-full bg-white px-4 sm:px-6 py-2.5 sm:py-3 ring-1 ring-gold-400/70 shadow-[0_16px_44px_-16px_rgba(15,23,42,0.45),0_0_22px_-4px_rgba(214,162,30,0.45)] transition-shadow duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
		>
			<a href="/" aria-label="RCK — The Ra'anana Community Kollel — Home">
				<img
					src="/logo-white.png"
					alt="RCK — Ra'anana Community Kollel"
					class="h-10 sm:h-11 w-auto"
				/>
			</a>

			<ul class="hidden items-center gap-4 lg:gap-6 md:flex">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class:list={[
									"text-sm font-medium transition-colors whitespace-nowrap",
									link.active
										? "text-navy-600 underline underline-offset-[6px] decoration-2 decoration-gold-500"
										: "text-navy-500 hover:text-gold-500",
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>

			<div class="hidden md:flex items-center gap-2 shrink-0">
				<a
					href="/contact"
					class:list={[
						"rounded-full border px-4 py-1.5 text-sm font-medium transition-colors whitespace-nowrap",
						isContactActive
							? "border-gold-500 text-gold-600 bg-gold-50"
							: "border-navy-200 text-navy-500 hover:bg-navy-50",
					]}
				>
					Contact
				</a>
				<a
					href="/donate"
					class="rounded-full bg-gold-500 px-5 py-2 text-sm font-semibold text-navy-700 shadow-sm transition-all hover:bg-gold-400 hover:shadow-md whitespace-nowrap"
				>
					Donate
				</a>
			</div>

			<button
				type="button"
				data-mobile-toggle
				aria-controls="mobile-menu"
				aria-expanded="false"
				aria-label="Toggle menu"
				class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-full text-navy-600 hover:bg-navy-50 transition-colors"
			>
				<svg data-icon="open" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
				</svg>
				<svg data-icon="close" viewBox="0 0 24 24" class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
				</svg>
			</button>
		</nav>

		<div
			id="mobile-menu"
			data-mobile-menu
			class="md:hidden mx-auto mt-2 max-w-5xl origin-top scale-y-95 opacity-0 pointer-events-none transition-all duration-200 rounded-2xl bg-white/98 shadow-[0_24px_48px_-20px_rgba(15,23,42,0.35)] ring-1 ring-black/5 backdrop-blur"
		>
			<ul class="flex flex-col p-2">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class:list={[
									"block rounded-xl px-4 py-3 text-base font-medium transition-colors",
									link.active
										? "bg-navy-50 text-navy-700"
										: "text-navy-600 hover:bg-navy-50",
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
				<li class="mt-1 border-t border-navy-50 pt-1">
					<a
						href="/contact"
						class:list={[
							"block rounded-xl px-4 py-3 text-base font-medium transition-colors",
							isContactActive ? "bg-navy-50 text-navy-700" : "text-navy-600 hover:bg-navy-50",
						]}
					>
						Contact
					</a>
				</li>
				<li class="p-2">
					<a
						href="/donate"
						class="block w-full rounded-xl bg-gold-500 px-4 py-3 text-center text-base font-semibold text-navy-700 hover:bg-gold-400 transition-colors"
					>
						Donate
					</a>
				</li>
			</ul>
		</div>
	</div>
</header>

<style is:global>
	/* Scrolled: deepen the pill's shadow so the page reads as sliding under a
	   floating bar. No color or size change — same white-and-gold pill. */
	.nav-scrolled .nav-pill {
		box-shadow:
			0 22px 54px -18px rgba(15, 23, 42, 0.5),
			0 0 26px -4px rgba(214, 162, 30, 0.5);
	}

	@media (prefers-reduced-motion: reduce) {
		[data-nav-header],
		.nav-pill {
			transition: none !important;
		}
	}
</style>

<script>
	const header = document.querySelector<HTMLElement>("[data-nav-header]");
	const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
	const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
	const openIcon = toggle?.querySelector<SVGElement>('[data-icon="open"]');
	const closeIcon = toggle?.querySelector<SVGElement>('[data-icon="close"]');

	const setOpen = (open: boolean) => {
		if (!menu || !toggle) return;
		toggle.setAttribute("aria-expanded", String(open));
		menu.classList.toggle("opacity-0", !open);
		menu.classList.toggle("scale-y-95", !open);
		menu.classList.toggle("pointer-events-none", !open);
		menu.classList.toggle("opacity-100", open);
		menu.classList.toggle("scale-y-100", open);
		openIcon?.classList.toggle("hidden", open);
		closeIcon?.classList.toggle("hidden", !open);
	};

	toggle?.addEventListener("click", () => {
		const isOpen = toggle.getAttribute("aria-expanded") === "true";
		setOpen(!isOpen);
	});

	menu?.querySelectorAll("a").forEach((a) => {
		a.addEventListener("click", () => setOpen(false));
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});

	// Subtle scroll response (every page): deepen shadow, settle the bar up.
	let scrolled = false;
	const onScroll = () => {
		const shouldScroll = window.scrollY > 24;
		if (shouldScroll === scrolled) return;
		scrolled = shouldScroll;
		header?.classList.toggle("nav-scrolled", scrolled);
		header?.classList.toggle("pt-2", scrolled);
		header?.classList.toggle("pt-4", !scrolled);
		header?.classList.toggle("sm:pt-3", scrolled);
		header?.classList.toggle("sm:pt-6", !scrolled);
	};
	window.addEventListener("scroll", onScroll, { passive: true });
	onScroll();
</script>
