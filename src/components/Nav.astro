---
import { getYouthPrograms } from "../lib/youth-programs";
import { getTeam, groupByRole, ROLE_GROUPS } from "../lib/team";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

// Submenus expose in-page sections so visitors can jump straight to them from
// anywhere. Team and Youth are built from the CMS so they always match what's
// actually on those pages. Links use absolute hrefs (e.g. /youth#dor-ldor) so
// they work from any page, not just the target page.
const [youthPrograms, team] = await Promise.all([getYouthPrograms(), getTeam()]);
const grouped = groupByRole(team);

const youthChildren = youthPrograms.map((p) => ({ label: p.title, href: `/youth#${p.slug}` }));
const teamChildren = ROLE_GROUPS
	.filter((g) => grouped[g.key].length > 0)
	.map((g) => ({ label: g.label, href: `/team#${g.key}` }));

interface NavChild {
	label: string;
	href: string;
}
interface NavItem {
	label: string;
	href: string;
	children?: NavChild[];
}

const homeChildren: NavChild[] = [
	{ label: "Join Us", href: "/#join" },
	{ label: "Our History", href: "/#history" },
	{ label: "WhatsApp Groups", href: "/#whatsapp" },
];

const baseLinks: NavItem[] = [
	{ label: "Home", href: "/", children: homeChildren },
	{ label: "Meet the Team", href: "/team", children: teamChildren },
	{ label: "Daven with Us", href: "/daven" },
	{ label: "Learn with Us", href: "/learn" },
	{ label: "Torah Sheets", href: "/torah-sheets" },
	{ label: "Community", href: "/community" },
	{ label: "Events", href: "/events" },
	{ label: "Youth", href: "/youth", children: youthChildren },
];

const navLinks = baseLinks.map((l) => ({
	...l,
	active: l.href === "/" ? pathname === "/" : pathname.startsWith(l.href),
	// Drop empty submenus (e.g. CMS not populated yet) so no empty dropdown shows.
	children: l.children && l.children.length > 0 ? l.children : undefined,
}));

const isContactActive = pathname === "/contact";

// A wide white bar that extends close to the screen edges: crisp gold hairline
// + a light, tight drop shadow (no glow). It reads the same over the dark
// homepage hero and on white interior pages. Scroll behavior (JS below): it
// slides out of the way on scroll-down and snaps back on scroll-up, so it stays
// out of the way while reading without losing quick access.
---

<header
	class="fixed inset-x-0 top-0 z-50 pt-3 sm:pt-4 transition-transform duration-300 will-change-transform"
	data-nav-header
>
	<div class="relative mx-auto w-full max-w-[1600px] px-3 sm:px-5">
		<nav
			class="nav-pill mx-auto flex max-w-[1600px] items-center justify-between gap-3 sm:gap-4 rounded-sm bg-white/94 px-5 sm:px-7 py-2.5 sm:py-3 ring-1 ring-gold-400/50 shadow-[0_6px_20px_-10px_rgba(15,23,42,0.35)]"
		>
			<a href="/" aria-label="RCK — The Ra'anana Community Kollel — Home" class="shrink-0">
				<img
					src="/logo-horizontal-dark.png"
					alt="RCK — Ra'anana Community Kollel"
					class="h-10 sm:h-11 lg:h-12 w-auto"
				/>
			</a>

			<div class="flex items-center gap-4 xl:gap-5 min-w-0">

			<ul class="hidden items-center gap-3 2xl:gap-5 xl:flex" data-nav-list>
				{
					navLinks.map((link) => (
						<li class:list={["relative", link.children && "group"]}>
							<a
								href={link.href}
								aria-current={link.active ? "page" : undefined}
								class:list={[
									"relative inline-flex items-center gap-1 text-[17.5px] 2xl:text-[20.5px] font-medium transition-colors whitespace-nowrap",
									link.active ? "text-navy-600" : "text-navy-500 hover:text-gold-500",
								]}
							>
								{link.label}
								{link.active && (
									<span
										aria-hidden="true"
										class="absolute left-1/2 -bottom-1.5 h-[2px] w-5 -translate-x-1/2 rounded-full bg-gold-500"
									/>
								)}
								{link.children && (
									<svg
										viewBox="0 0 24 24"
										class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180"
										fill="none"
										stroke="currentColor"
										stroke-width="2.2"
										aria-hidden="true"
									>
										<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
							</a>
							{link.children && (
								<div class="invisible absolute left-1/2 top-full z-50 -translate-x-1/2 translate-y-1 pt-3 opacity-0 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
									<ul class="min-w-[210px] rounded-sm bg-white p-1.5 ring-1 ring-navy-100 shadow-[0_18px_44px_-16px_rgba(15,23,42,0.4)]">
										{link.children.map((child) => (
											<li>
												<a
													href={child.href}
													class="block rounded-sm px-3 py-2 text-[15px] lg:text-[16px] font-medium text-navy-600 transition-colors hover:bg-navy-50 hover:text-gold-600 whitespace-nowrap"
												>
													{child.label}
												</a>
											</li>
										))}
									</ul>
								</div>
							)}
						</li>
					))
				}
			</ul>

			<button
				type="button"
				data-mobile-toggle
				aria-controls="mobile-menu"
				aria-expanded="false"
				aria-label="Toggle menu"
				class="xl:hidden inline-flex h-11 w-11 items-center justify-center rounded-sm text-navy-600 hover:bg-navy-50 transition-colors"
			>
				<svg data-icon="open" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.4">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
				</svg>
				<svg data-icon="close" viewBox="0 0 24 24" class="hidden h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.4">
					<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
				</svg>
			</button>

			<div class="hidden xl:flex items-center gap-2 shrink-0" data-nav-cta>
				<a
					href="/contact"
					class:list={[
						"rounded-sm px-4 py-2 text-[17.5px] 2xl:text-[20.5px] font-medium transition-colors whitespace-nowrap",
						isContactActive
							? "text-gold-600 bg-gold-50"
							: "text-navy-500 hover:bg-navy-50",
					]}
				>
					Contact
				</a>
				<a
					href="/donate"
					class="group inline-flex items-center gap-1.5 rounded-sm bg-gold-500/85 px-5 py-2 text-[17.5px] 2xl:text-[20.5px] font-semibold text-navy-700 shadow-sm transition-all hover:bg-gold-400/90 hover:shadow-md whitespace-nowrap"
				>
					<svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
						<path d="M12 20.3 4.6 13a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9A4.6 4.6 0 0 1 19.4 13L12 20.3Z" />
					</svg>
					Donate
				</a>
			</div>

			<a
				href="/donate"
				data-mobile-donate
				aria-label="Donate"
				class="hidden shrink-0 items-center gap-1.5 rounded-sm bg-gold-500/85 px-3 py-2 text-sm font-semibold text-navy-700 shadow-sm transition-all hover:bg-gold-400/90 whitespace-nowrap"
			>
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
					<path d="M12 20.3 4.6 13a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9A4.6 4.6 0 0 1 19.4 13L12 20.3Z" />
				</svg>
				Donate
			</a>

			</div>
		</nav>

		<div
			id="mobile-menu"
			data-mobile-menu
			class="xl:hidden absolute inset-x-3 top-full sm:inset-x-5 mx-auto mt-2 max-w-5xl origin-top scale-y-95 opacity-0 pointer-events-none transition-all duration-200 rounded-md bg-white/98 shadow-[0_24px_48px_-20px_rgba(15,23,42,0.35)] ring-1 ring-black/5 backdrop-blur"
		>
			<ul class="flex flex-col p-2">
				{
					navLinks.map((link) => (
						<li>
							<div class="flex items-center">
								<a
									href={link.href}
									class:list={[
										"flex-1 block rounded-md px-4 py-3 text-base font-medium transition-colors",
										link.active
											? "bg-navy-50 text-navy-700"
											: "text-navy-600 hover:bg-navy-50",
									]}
								>
									{link.label}
								</a>
								{link.children && (
									<button
										type="button"
										data-submenu-toggle
										aria-expanded="false"
										aria-label={`Toggle ${link.label} sections`}
										class="ml-1 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-md text-navy-500 transition-colors hover:bg-navy-50"
									>
										<svg
											viewBox="0 0 24 24"
											class="h-4 w-4 transition-transform duration-200"
											fill="none"
											stroke="currentColor"
											stroke-width="2.2"
											aria-hidden="true"
										>
											<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</button>
								)}
							</div>
							{link.children && (
								<ul data-submenu class="hidden ml-4 mb-1 border-l border-navy-100 pl-3">
									{link.children.map((child) => (
										<li>
											<a
												href={child.href}
												class="block rounded-md px-4 py-2 text-sm font-medium text-navy-500 transition-colors hover:bg-navy-50 hover:text-gold-600"
											>
												{child.label}
											</a>
										</li>
									))}
								</ul>
							)}
						</li>
					))
				}
				<li class="mt-1 border-t border-navy-50 pt-1">
					<a
						href="/contact"
						class:list={[
							"block rounded-md px-4 py-3 text-base font-medium transition-colors",
							isContactActive ? "bg-navy-50 text-navy-700" : "text-navy-600 hover:bg-navy-50",
						]}
					>
						Contact
					</a>
				</li>
				<li class="p-2">
					<a
						href="/donate"
						class="flex w-full items-center justify-center gap-1.5 rounded-md bg-gold-500/85 px-4 py-3 text-base font-semibold text-navy-700 hover:bg-gold-400/90 transition-colors"
					>
						<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
							<path d="M12 20.3 4.6 13a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9A4.6 4.6 0 0 1 19.4 13L12 20.3Z" />
						</svg>
						Donate
					</a>
				</li>
			</ul>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
	const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
	const openIcon = toggle?.querySelector<SVGElement>('[data-icon="open"]');
	const closeIcon = toggle?.querySelector<SVGElement>('[data-icon="close"]');

	const setOpen = (open: boolean) => {
		if (!menu || !toggle) return;
		toggle.setAttribute("aria-expanded", String(open));
		menu.classList.toggle("opacity-0", !open);
		menu.classList.toggle("scale-y-95", !open);
		menu.classList.toggle("pointer-events-none", !open);
		menu.classList.toggle("opacity-100", open);
		menu.classList.toggle("scale-y-100", open);
		openIcon?.classList.toggle("hidden", open);
		closeIcon?.classList.toggle("hidden", !open);
	};

	toggle?.addEventListener("click", () => {
		const isOpen = toggle.getAttribute("aria-expanded") === "true";
		setOpen(!isOpen);
	});

	// Desktop-only: hovering the hamburger opens the menu immediately, mirroring
	// the hover-open submenus in the desktop nav list. It never auto-closes on
	// mouseleave though (unlike those submenus) — once open, only clicking the
	// button (now showing the X) closes it. Gated to real hover+fine-pointer
	// devices so a touch tap's synthetic mouseenter-before-click doesn't fire
	// this and then have the click handler immediately toggle it back closed.
	if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
		toggle?.addEventListener("mouseenter", () => {
			if (toggle.getAttribute("aria-expanded") !== "true") setOpen(true);
		});
	}

	menu?.querySelectorAll("a").forEach((a) => {
		a.addEventListener("click", () => setOpen(false));
	});

	// Mobile submenu accordions: the caret toggles its sibling list; the parent
	// link still navigates to the page itself.
	menu?.querySelectorAll<HTMLButtonElement>("[data-submenu-toggle]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const sub = btn.closest("li")?.querySelector<HTMLElement>("[data-submenu]");
			const caret = btn.querySelector<SVGElement>("svg");
			if (!sub) return;
			const open = !sub.classList.toggle("hidden");
			btn.setAttribute("aria-expanded", String(open));
			if (caret) caret.style.transform = open ? "rotate(180deg)" : "";
		});
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});

	// Click anywhere outside the open menu (and outside the toggle button
	// itself, which already opens/closes it on its own click) closes it too.
	document.addEventListener("click", (e) => {
		if (toggle?.getAttribute("aria-expanded") !== "true") return;
		if (!(e.target instanceof Node)) return;
		if (toggle.contains(e.target) || menu?.contains(e.target)) return;
		setOpen(false);
	});

	// Hide-on-scroll-down, reveal-on-scroll-up. The header animates via the
	// `transition-transform` class in the markup; here we just set the transform.
	// Always shown near the top of the page and whenever the mobile menu is open.
	const header = document.querySelector<HTMLElement>("[data-nav-header]");
	if (header) {
		let lastY = window.scrollY;
		let ticking = false;
		const DELTA = 6; // ignore sub-pixel jitter

		const update = () => {
			const y = Math.max(0, window.scrollY);
			const menuOpen = toggle?.getAttribute("aria-expanded") === "true";
			if (y < 80 || menuOpen) {
				header.style.transform = "";
			} else if (y > lastY + DELTA) {
				header.style.transform = "translateY(-130%)";
			} else if (y < lastY - DELTA) {
				header.style.transform = "";
			}
			lastY = y;
			ticking = false;
		};

		window.addEventListener(
			"scroll",
			() => {
				if (!ticking) {
					requestAnimationFrame(update);
					ticking = true;
				}
			},
			{ passive: true },
		);
	}
</script>

<script>
	// Progressive "priority nav": Tailwind's `xl:flex`/`xl:hidden` classes give
	// a safe zero-JS default for first paint (menu collapsed into the
	// hamburger below 1280px, shown in full at/above it) — that default is
	// what renders before this script runs, so there's never a flash of an
	// overflowing bar. This script then measures the row's *actual* content
	// width and folds the lowest-priority items (from the end of the list —
	// Youth, Events, Community, … ) back into the hamburger one at a time,
	// at *any* viewport width — it no longer trusts that the full menu
	// always fits at/above 1280px. That assumption broke once the item list
	// grew past what fits there (e.g. adding Torah Sheets): the Donate
	// button would spill past the white pill with nothing to catch it,
	// because the old code skipped measuring entirely once past that
	// breakpoint. Every item stays reachable via the hamburger drawer
	// regardless of whether it's also shown inline. See design log #048.
	const navPill = document.querySelector<HTMLElement>(".nav-pill");
	const navList = document.querySelector<HTMLUListElement>("[data-nav-list]");
	const navCta = document.querySelector<HTMLElement>("[data-nav-cta]");
	const navToggle = document.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
	const mobileDonate = document.querySelector<HTMLElement>("[data-mobile-donate]");

	if (navPill && navList && navCta) {
		const items = Array.from(navList.children) as HTMLLIElement[];

		// Does the whole nav-pill row currently overflow its own box? Reading
		// scrollWidth vs clientWidth on the row itself accounts for the logo,
		// every visible nav item, the CTA buttons, and the hamburger button (when
		// present) in one comparison — no manual width/gap arithmetic needed.
		const overflowing = () => navPill.scrollWidth > navPill.clientWidth + 1; // +1: rounding slack

		const layout = () => {
			// Force everything visible so we can measure the row's true content
			// width, then fold items from the end until it fits (or nothing's left).
			navList.style.display = "flex";
			navCta.style.display = "flex";
			items.forEach((li) => li.style.removeProperty("display"));

			for (let i = items.length - 1; i >= 0 && overflowing(); i--) {
				items[i].style.display = "none";
			}

			// Last resort: even Home + Contact + Donate alone don't fit. Drop the
			// CTA buttons too rather than let them clip off the edge of the pill.
			if (overflowing()) navCta.style.display = "none";

			const ctaHidden = navCta.style.display === "none";
			const anyItemHidden = items.some((li) => li.style.display === "none");
			const allItemsHidden = items.every((li) => li.style.display === "none");

			// The compact heart+Donate button is a stand-in for the full CTA row
			// when that row didn't fit — show exactly one or the other, never both.
			if (mobileDonate) mobileDonate.style.display = ctaHidden ? "flex" : "none";

			// Nothing ended up visible inline — fall back to the plain CSS default
			// (hidden below `xl`) so there's no stray empty flex row taking space.
			if (allItemsHidden && ctaHidden) {
				navList.style.removeProperty("display");
				navCta.style.removeProperty("display");
			}

			// The hamburger only needs to exist to hold whatever didn't fit inline.
			// If nothing got folded (a perfect fit), hide it — a full inline menu
			// sitting next to a redundant hamburger would look broken. When
			// folding *did* happen, it must be explicitly shown (not just left to
			// the underlying `xl:hidden` class), since folding can now happen at
			// or above the `xl` breakpoint too, where that class would otherwise
			// hide it regardless of whether anything actually needs it.
			const nothingFolded = !anyItemHidden && !ctaHidden;
			navToggle?.style.setProperty("display", nothingFolded ? "none" : "inline-flex");
		};

		layout();

		// The nav's web fonts load with `font-display: swap` (Layout.astro), so
		// the very first `layout()` call above measures against the fallback
		// font's (narrower) metrics. If Oswald/Onest swap in wider once they
		// load — which doesn't fire `resize` — a row that "fit" a moment ago can
		// overflow the pill for real, with nothing left to re-measure it. Since
		// `.nav-pill` has no `overflow-hidden` (by design, so a dropdown/mega
		// menu isn't clipped), that overflow was visible as the CTA spilling
		// past the white bar's edge instead of getting folded into the
		// hamburger like it should have been.
		document.fonts?.ready?.then(layout);

		let resizeTicking = false;
		window.addEventListener(
			"resize",
			() => {
				if (!resizeTicking) {
					requestAnimationFrame(() => {
						layout();
						resizeTicking = false;
					});
					resizeTicking = true;
				}
			},
			{ passive: true },
		);
	}
</script>

