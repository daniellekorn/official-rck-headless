---
interface Slide {
	title?: string;
	caption?: string;
	// gradient placeholder colors — the user will swap in real images later
	from: string;
	to: string;
}

const slides: Slide[] = [
	{ title: "Beis Medrash", caption: "Daily Torah learning in our home", from: "#1f2c4b", to: "#b9902a" },
	{ title: "Shiurim", caption: "Weekly classes for every level", from: "#3d4d6f", to: "#dcbb4d" },
	{ title: "Community Tefillah", caption: "Vibrant minyanim throughout the day", from: "#16213d", to: "#957021" },
	{ title: "Chavrutas", caption: "One-on-one learning partnerships", from: "#677697", to: "#cea531" },
	{ title: "Special Events", caption: "Holidays, melaveh malka, and more", from: "#0f172a", to: "#e8d27f" },
];
---

<div
	class="relative mx-auto max-w-5xl overflow-hidden rounded-2xl shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)] ring-1 ring-white/10"
	data-slideshow
>
	<div class="relative aspect-[16/9] w-full">
		{
			slides.map((slide, i) => (
				<figure
					data-slide
					data-index={i}
					class:list={[
						"absolute inset-0 transition-opacity duration-700 ease-out",
						i === 0 ? "opacity-100" : "opacity-0",
					]}
					style={`background: linear-gradient(135deg, ${slide.from} 0%, ${slide.to} 100%);`}
				>
					<div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent" />
					<figcaption class="absolute inset-x-0 bottom-0 p-4 sm:p-6 md:p-10 pr-14 sm:pr-16 md:pr-20 text-left text-white">
						<p class="font-sans text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.22em] text-gold-300">
							Photo {i + 1} of {slides.length}
						</p>
						{slide.title && (
							<p class="mt-1 sm:mt-2 font-sans text-lg sm:text-2xl md:text-3xl font-black tracking-[-0.015em]">
								{slide.title}
							</p>
						)}
						{slide.caption && (
							<p class="mt-0.5 sm:mt-1 text-xs sm:text-sm md:text-base text-white/80">{slide.caption}</p>
						)}
					</figcaption>
				</figure>
			))
		}
	</div>

	<button
		type="button"
		data-slideshow-prev
		aria-label="Previous slide"
		class="absolute left-2 sm:left-3 md:left-5 top-1/2 -translate-y-1/2 flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur transition hover:bg-black/60 focus-visible:outline-2 focus-visible:outline-gold-300"
	>
		<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>

	<button
		type="button"
		data-slideshow-next
		aria-label="Next slide"
		class="absolute right-2 sm:right-3 md:right-5 top-1/2 -translate-y-1/2 flex h-11 w-11 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur transition hover:bg-black/60 focus-visible:outline-2 focus-visible:outline-gold-300"
	>
		<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>

	<div class="absolute inset-x-0 bottom-4 flex justify-center gap-2" data-slideshow-dots>
		{
			slides.map((_, i) => (
				<button
					type="button"
					data-slideshow-dot
					data-index={i}
					aria-label={`Go to slide ${i + 1}`}
					class:list={[
						"h-1.5 rounded-full transition-all duration-300",
						i === 0 ? "w-6 bg-white" : "w-1.5 bg-white/50 hover:bg-white/80",
					]}
				/>
			))
		}
	</div>
</div>

<script>
	const AUTOPLAY_MS = 5000;

	document.querySelectorAll<HTMLElement>("[data-slideshow]").forEach((root) => {
		const slides = root.querySelectorAll<HTMLElement>("[data-slide]");
		const dots = root.querySelectorAll<HTMLButtonElement>("[data-slideshow-dot]");
		const prev = root.querySelector<HTMLButtonElement>("[data-slideshow-prev]");
		const next = root.querySelector<HTMLButtonElement>("[data-slideshow-next]");
		if (slides.length === 0) return;

		let current = 0;
		let timer: number | undefined;

		const setActive = (i: number) => {
			const n = (i + slides.length) % slides.length;
			slides.forEach((s, idx) => {
				s.classList.toggle("opacity-100", idx === n);
				s.classList.toggle("opacity-0", idx !== n);
			});
			dots.forEach((d, idx) => {
				const active = idx === n;
				d.classList.toggle("w-6", active);
				d.classList.toggle("bg-white", active);
				d.classList.toggle("w-1.5", !active);
				d.classList.toggle("bg-white/50", !active);
			});
			current = n;
		};

		const start = () => {
			stop();
			timer = window.setInterval(() => setActive(current + 1), AUTOPLAY_MS);
		};
		const stop = () => {
			if (timer) window.clearInterval(timer);
		};

		prev?.addEventListener("click", () => {
			setActive(current - 1);
			start();
		});
		next?.addEventListener("click", () => {
			setActive(current + 1);
			start();
		});
		dots.forEach((dot) => {
			dot.addEventListener("click", () => {
				const i = Number(dot.dataset.index);
				setActive(i);
				start();
			});
		});

		root.addEventListener("mouseenter", stop);
		root.addEventListener("mouseleave", start);

		start();
	});
</script>
