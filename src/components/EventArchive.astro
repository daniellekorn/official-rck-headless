---
/**
 * EventArchive — master-detail "past events" browser. A list of event names
 * (vertical on desktop, horizontal scroll-chips on mobile) sits beside a panel
 * that shows the chosen event's photo gallery + its flyer (flyer beside the
 * photos). Clicking a name swaps the panel client-side — no reload. The active
 * event is reflected in the URL hash so a specific event can be linked/shared.
 *
 * Vanilla JS + `is:global` styles with `ea-` prefixed classes, following the
 * PhotoGallery convention (scoped CSS doesn't reliably match JS-toggled classes
 * in the Wix build — see #012). See design log #027.
 */
import PhotoGalleryGrid from "./PhotoGalleryGrid.astro";
import Flyer from "./Flyer.astro";
import { ricosToPlainText } from "../lib/ricos";
import { hasFlyer, type PastEvent } from "../lib/past-events";
import type { GalleryMediaItem } from "../lib/wix-media";

interface Props {
	events: PastEvent[];
	/** Section eyebrow / heading. */
	eyebrow?: string;
	title?: string;
}

const { events, eyebrow = "", title = "Past Events" } = Astro.props;

const dateFmt = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric" });
function caption(d: PastEvent["eventDate"]): string | undefined {
	if (!d) return undefined;
	const date = d instanceof Date ? d : new Date(d);
	return Number.isNaN(date.getTime()) ? undefined : dateFmt.format(date);
}

// Videos first, then photos — one continuous swipe-through sequence in the
// lightbox (design log #050). Direct video files from `videoUrls` aren't
// shown here yet — no event has needed one, and the lightbox only knows how
// to embed YouTube slides so far.
function mediaItems(e: PastEvent): GalleryMediaItem[] {
	const photos: GalleryMediaItem[] = e.galleryUrls.map((src, i) => ({
		type: "image",
		src,
		fullSrc: e.galleryFullUrls[i] ?? src,
	}));
	const videos: GalleryMediaItem[] = e.videos
		.filter((v): v is Extract<typeof v, { kind: "youtube" }> => v.kind === "youtube")
		.map((v) => ({ type: "youtube", videoId: v.id }));
	return [...videos, ...photos];
}
---

{events.length > 0 && (
	<section class="py-14 sm:py-20 bg-mist border-t border-navy-100" data-event-archive>
		<div class="container-page">
			<div data-reveal="up">
				{eyebrow && <p class="eyebrow text-gold-600">{eyebrow}</p>}
				<h2 class="mt-2 font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] font-medium text-navy-600">
					{title}
				</h2>
				<span class="gold-rule-sm mt-5" aria-hidden="true"></span>
			</div>

			<div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,15rem)_1fr] lg:gap-12">
				{/* Side list — vertical on desktop, horizontal scroll-chips on mobile.
				    Desktop also gets a draggable/scroll-wheel scrubber beside the list —
				    an alternative to clicking each name. Mobile keeps native swipe. */}
				<div class="ea-side" data-ea-side>
					<div class="ea-scrubber" data-ea-scrubber aria-hidden="true">
						<div class="ea-scrubber-track" data-ea-scrubber-track>
							<div class="ea-scrubber-thumb" data-ea-scrubber-thumb></div>
						</div>
					</div>
					<nav class="ea-tabs" aria-label="Past events" data-ea-tabs>
						{events.map((e, i) => (
							<button
								type="button"
								class:list={["ea-tab", i === 0 && "is-active"]}
								data-ea-tab={e.slug}
							>
								<span class="ea-tab-title">{e.title}</span>
								{caption(e.eventDate) && <span class="ea-tab-date">{caption(e.eventDate)}</span>}
							</button>
						))}
					</nav>
				</div>

				{/* Panels — all rendered, only the active one shown */}
				<div class="ea-panels">
					{events.map((e, i) => {
						const blurb = e.blurb ? ricosToPlainText(e.blurb) : "";
						const flyer = hasFlyer(e);
						const media = mediaItems(e);
						const hasMedia = media.length > 0;
						return (
							<article
								class:list={["ea-panel", i === 0 && "is-active"]}
								data-ea-panel={e.slug}
								aria-hidden={i === 0 ? undefined : "true"}
							>
								<div class="mb-6">
									<h3 class="font-display text-2xl sm:text-3xl font-medium text-navy-700">{e.title}</h3>
									{caption(e.eventDate) && (
										<p class="mt-1 text-sm font-medium uppercase tracking-[0.14em] text-gold-600">
											{caption(e.eventDate)}
										</p>
									)}
									{blurb && (
										<p class="mt-4 max-w-prose text-base leading-relaxed text-navy-500 whitespace-pre-line">
											{blurb}
										</p>
									)}
								</div>

								<div
									class:list={[
										"grid gap-8 lg:gap-10",
										flyer && hasMedia && "lg:grid-cols-[1fr_minmax(0,18rem)] lg:items-start",
									]}
								>
									{hasMedia && (
										<div class:list={[flyer && "lg:order-1"]}>
											<PhotoGalleryGrid items={media} label={e.title} />
										</div>
									)}

									{flyer && (
										<div
											class:list={[
												"flex justify-center",
												hasMedia && "lg:order-2",
												!hasMedia && "mx-auto w-full max-w-sm",
											]}
										>
											<div class="w-full max-w-sm overflow-hidden rounded-md bg-navy-800 ring-1 ring-navy-100 shadow-[0_30px_64px_-34px_rgba(7,23,58,0.55)]">
												<Flyer
													imageUrl={e.flyerImageUrl}
													pdfUrl={e.flyerPdfUrl}
													title={e.title}
												/>
											</div>
										</div>
									)}
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</div>
	</section>
)}

<style is:global>
	/* Side list: horizontal scroll-chips on mobile, vertical list on desktop. */
	.ea-tabs {
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		padding-bottom: 0.5rem;
		scrollbar-width: thin;
		-webkit-overflow-scrolling: touch;
		flex: 1;
		min-width: 0;
	}
	@media (min-width: 1024px) {
		.ea-tabs {
			flex-direction: column;
			gap: 0.25rem;
			overflow-x: visible;
			padding-bottom: 0;
		}
	}

	/* Wraps the scrubber + tab list so both stick together while scrolling
	   the page; the scrubber itself is desktop-only (mobile keeps native
	   swipe on the horizontal chip row). */
	.ea-side {
		display: flex;
		gap: 0.5rem;
		min-width: 0;
	}
	@media (min-width: 1024px) {
		.ea-side {
			position: sticky;
			top: 6rem;
			align-self: start;
			gap: 0.85rem;
		}
	}

	/* Slim, modern scrollbar-style scrubber — same gold thumb / drag+wheel
	   mechanic as before (design log #027), just a cleaner line rather than a
	   bulky lane. The whole `.ea-scrubber` box is the drag hit-area (see the
	   script below), not just the thin visual track, so it's forgiving to
	   grab without needing to look chunky to be easy to use. */
	.ea-scrubber {
		display: none;
	}
	@media (min-width: 1024px) {
		.ea-scrubber {
			display: flex;
			justify-content: center;
			flex: 0 0 auto;
			width: 0.75rem;
			cursor: pointer;
			touch-action: none;
		}
		.ea-scrubber-track {
			position: relative;
			width: 3px;
			height: 100%;
			min-height: 8rem;
			border-radius: 999px;
			background: rgb(from var(--color-navy-500) r g b / 0.12);
			transition: background 0.18s ease;
		}
		.ea-scrubber:hover .ea-scrubber-track {
			background: rgb(from var(--color-navy-500) r g b / 0.2);
		}
		.ea-scrubber-thumb {
			position: absolute;
			left: 50%;
			min-height: 1.5rem;
			width: 0.375rem;
			transform: translateX(-50%) scale(1);
			border-radius: 999px;
			background: var(--color-gold-500);
			box-shadow: 0 2px 6px -1px rgb(from var(--color-gold-600) r g b / 0.5);
			transition: top 0.22s cubic-bezier(0.22, 1, 0.36, 1), height 0.22s cubic-bezier(0.22, 1, 0.36, 1),
				transform 0.15s ease, background 0.15s ease;
			cursor: grab;
		}
		.ea-scrubber:hover .ea-scrubber-thumb {
			transform: translateX(-50%) scale(1.15);
			background: var(--color-gold-400);
		}
		.ea-scrubber-thumb:active {
			cursor: grabbing;
			transform: translateX(-50%) scale(1.15);
		}
	}

	.ea-tab {
		flex: 0 0 auto;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		text-align: left;
		white-space: nowrap;
		border-radius: 0.125rem;
		padding: 0.6rem 0.95rem;
		background: #fff;
		box-shadow: inset 0 0 0 1px rgb(from var(--color-navy-500) r g b / 0.12);
		color: var(--color-navy-500);
		transition: background 0.18s, box-shadow 0.18s, color 0.18s;
	}
	@media (min-width: 1024px) {
		.ea-tab {
			white-space: normal;
			border-left: 3px solid transparent;
			border-radius: 0 0.125rem 0.125rem 0;
		}
	}
	.ea-tab:hover {
		background: #f3f6fb;
	}
	.ea-tab .ea-tab-title {
		font-weight: 600;
		font-size: 0.95rem;
		line-height: 1.2;
	}
	.ea-tab .ea-tab-date {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #9aa6bd;
	}
	.ea-tab.is-active {
		background: var(--color-accent);
		color: var(--color-navy-700);
		box-shadow: inset 0 0 0 1px rgb(from var(--color-gold-500) r g b / 0.6);
	}
	.ea-tab.is-active .ea-tab-date {
		color: #6b5a16;
	}
	@media (min-width: 1024px) {
		.ea-tab.is-active {
			background: #fff;
			border-left-color: var(--color-gold-500);
			box-shadow: inset 0 0 0 1px rgb(from var(--color-gold-500) r g b / 0.35);
		}
	}

	/* Panels: only the active one is shown. */
	.ea-panel {
		display: none;
	}
	.ea-panel.is-active {
		display: block;
		animation: ea-fade 0.35s ease;
	}
	@keyframes ea-fade {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: translateY(0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.ea-panel.is-active {
			animation: none;
		}
	}
</style>

<script is:inline>
	(() => {
		const root = document.querySelector("[data-event-archive]");
		if (!root) return;
		const tabs = Array.from(root.querySelectorAll("[data-ea-tab]"));
		const panels = Array.from(root.querySelectorAll("[data-ea-panel]"));
		if (!tabs.length) return;

		const side = root.querySelector("[data-ea-side]");
		const scrubber = root.querySelector("[data-ea-scrubber]");
		const track = root.querySelector("[data-ea-scrubber-track]");
		const thumb = root.querySelector("[data-ea-scrubber-thumb]");
		const n = tabs.length;
		const isDesktopLayout = () => window.matchMedia("(min-width: 1024px)").matches;

		// Thumb height/position as a % of the track, one "slot" per event —
		// percentages so it stays correct across resize with no JS involved.
		const layoutThumb = () => {
			if (!track || !thumb) return;
			const idx = Math.max(0, tabs.findIndex((t) => t.classList.contains("is-active")));
			const pct = 100 / n;
			thumb.style.height = `${pct}%`;
			thumb.style.top = `${pct * idx}%`;
		};

		const activate = (slug, updateHash) => {
			let matched = false;
			tabs.forEach((t) => {
				const on = t.getAttribute("data-ea-tab") === slug;
				t.classList.toggle("is-active", on);
				if (on) matched = true;
			});
			panels.forEach((p) => {
				const on = p.getAttribute("data-ea-panel") === slug;
				p.classList.toggle("is-active", on);
				if (on) p.removeAttribute("aria-hidden");
				else p.setAttribute("aria-hidden", "true");
			});
			if (matched && updateHash) {
				history.replaceState(null, "", `#${slug}`);
			}
			if (matched) layoutThumb();
			return matched;
		};

		tabs.forEach((t) => {
			t.addEventListener("click", () => activate(t.getAttribute("data-ea-tab"), true));
		});

		// Scrubber: drag anywhere in the lane (not just the thin visual track —
		// a 3px line is a hard target to hit precisely), or scroll the
		// wheel/trackpad while hovering the lane OR the tab names, to move
		// through events without clicking each name — an alternative to (not
		// a replacement for) clicking a tab directly.
		if (scrubber && track && thumb && n > 1) {
			const activateIndex = (idx) => {
				const clamped = Math.min(n - 1, Math.max(0, idx));
				const slug = tabs[clamped]?.getAttribute("data-ea-tab");
				if (slug) activate(slug, true);
			};
			const indexFromClientY = (clientY) => {
				const rect = track.getBoundingClientRect();
				const ratio = rect.height > 0 ? (clientY - rect.top) / rect.height : 0;
				return Math.min(n - 1, Math.max(0, Math.floor(Math.min(1, Math.max(0, ratio)) * n)));
			};

			let dragging = false;
			const onPointerMove = (e) => {
				if (dragging) activateIndex(indexFromClientY(e.clientY));
			};
			const onPointerUp = () => {
				dragging = false;
				document.removeEventListener("pointermove", onPointerMove);
				document.removeEventListener("pointerup", onPointerUp);
			};
			scrubber.addEventListener("pointerdown", (e) => {
				dragging = true;
				activateIndex(indexFromClientY(e.clientY));
				document.addEventListener("pointermove", onPointerMove);
				document.addEventListener("pointerup", onPointerUp);
				e.preventDefault();
			});

			// Wheel/trackpad scroll anywhere over the side list (scrubber OR the
			// tab names themselves) moves one event per "tick" — no click-drag
			// needed. Desktop layout only: on mobile this same element is the
			// horizontal swipe-chip row and should keep native touch scroll.
			// Trackpads fire many small deltas per gesture, so accumulate to a
			// threshold and cool down briefly rather than skipping several
			// events at once.
			let wheelAccum = 0;
			let wheelCooling = false;
			(side ?? track.parentElement)?.addEventListener(
				"wheel",
				(e) => {
					if (!isDesktopLayout()) return;
					e.preventDefault();
					if (wheelCooling) return;
					wheelAccum += e.deltaY;
					if (Math.abs(wheelAccum) < 40) return;
					const dir = wheelAccum > 0 ? 1 : -1;
					wheelAccum = 0;
					const current = Math.max(0, tabs.findIndex((t) => t.classList.contains("is-active")));
					activateIndex(current + dir);
					wheelCooling = true;
					setTimeout(() => { wheelCooling = false; }, 150);
				},
				{ passive: false },
			);
		}

		// Deep-link: open the event named in the URL hash, if any.
		const fromHash = decodeURIComponent((location.hash || "").replace(/^#/, ""));
		if (fromHash) activate(fromHash, false);
		layoutThumb();
	})();
</script>
