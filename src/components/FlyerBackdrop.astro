---
/**
 * The flyer's own colors, blurred and faded, filling the space around it. A
 * tiny CDN variant (~2 KB) — it's only ever seen blurred. Fills its nearest
 * positioned ancestor, which must clip. See design-log #085.
 */
import { scaleFlyerImage } from "../lib/wix-media";

interface Props {
	imageUrl: string;
}

const src = scaleFlyerImage(Astro.props.imageUrl, 48);
---

<img src={src} alt="" aria-hidden="true" loading="lazy" decoding="async" class="flyer-backdrop" />

<style>
	.flyer-backdrop {
		position: absolute;
		/* Past the edges, so the blur's own soft rim is clipped away. */
		inset: -2.5rem;
		width: calc(100% + 5rem);
		height: calc(100% + 5rem);
		max-width: none;
		object-fit: cover;
		filter: blur(20px) saturate(1.25);
		opacity: 0.55;
		pointer-events: none;
	}
</style>
