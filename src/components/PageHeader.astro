---
interface Props {
	eyebrow?: string;
	titleGold?: string;
	titleNavy: string;
	subtitle?: string;
}

const { eyebrow, titleGold, titleNavy, subtitle } = Astro.props;
---

<section class="pt-32 pb-0 sm:pt-36 text-center">
	<div class="container-page">
		{eyebrow && (
			<p class="eyebrow text-gold-500" data-reveal="up">{eyebrow}</p>
		)}
		<h1
			class="mt-3 font-display text-3xl sm:text-4xl md:text-5xl leading-[1.05] font-medium"
			data-reveal="up"
			data-reveal-delay="100"
		>
			{titleGold && <span class="text-gold-400">{titleGold} </span>}
			<span class="text-navy-700">{titleNavy}</span>
		</h1>
		<span class="mx-auto mt-4 sm:mt-5 block h-[2px] w-14 bg-gold-400" aria-hidden="true" data-reveal="up" data-reveal-delay="200"></span>
		{subtitle && (
			<p class="mx-auto mt-4 sm:mt-5 max-w-xl text-base sm:text-lg leading-relaxed text-navy-400" data-reveal="up" data-reveal-delay="280">
				{subtitle}
			</p>
		)}
	</div>
</section>
