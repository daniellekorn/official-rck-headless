---
interface Props {
	eyebrow?: string;
	/** Optional leading word. Rendered in the same color as the rest of the
	    title (kept as a separate prop only for existing call sites). */
	titleGold?: string;
	titleNavy: string;
	subtitle?: string;
}

const { eyebrow, titleGold, titleNavy, subtitle } = Astro.props;
const title = [titleGold, titleNavy].filter(Boolean).join(" ");
---

<section class="relative isolate overflow-hidden pt-28 pb-10 sm:pt-32 sm:pb-12 text-center">
	<!-- Deep-navy band: gives interior headers presence and lets the white
	     nav pill pop, while creating a clean navy→white seam into the page. -->
	<div
		class="absolute inset-0 -z-10 bg-navy-700"
		style="background-image:
			radial-gradient(900px 380px at 50% -20%, rgb(from var(--color-gold-500) r g b / 0.20), transparent 65%),
			linear-gradient(180deg, var(--color-navy-700) 0%, color-mix(in oklab, var(--color-navy-700), var(--color-navy-600)) 70%, var(--color-navy-600) 100%);"
		aria-hidden="true"
	>
	</div>
	<!-- Beis medrash photo, anchored on the bookshelves/sign rather than the
	     ceiling. It fades to navy via the overlay below rather than the
	     source file's own baked-in alpha, which is fixed in pixels and only
	     lines up right at one specific header height. -->
	<img
		src="/header-photo.webp"
		alt=""
		aria-hidden="true"
		class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_30%]"
	/>
	<div
		class="absolute inset-0 -z-10"
		style="background-image: linear-gradient(180deg,
			rgb(from var(--color-navy-700) r g b / 0) 0%,
			rgb(from var(--color-navy-700) r g b / 0) 35%,
			rgb(from var(--color-navy-700) r g b / 0.55) 62%,
			rgb(from var(--color-navy-700) r g b / 0.92) 82%,
			var(--color-navy-700) 100%);"
		aria-hidden="true"
	>
	</div>
	<div class="container-page">
		{eyebrow && (
			<p class="eyebrow text-gold-300" data-reveal="up">{eyebrow}</p>
		)}
		<h1
			class="mt-3 font-display text-4xl sm:text-5xl md:text-6xl leading-[1.04] font-medium text-white"
			data-reveal="up"
			data-reveal-delay="100"
		>
			{title}
		</h1>
		<span class="gold-rule mx-auto mt-5" aria-hidden="true" data-reveal="up" data-reveal-delay="200"></span>
		{subtitle && (
			<p class="mx-auto mt-5 max-w-xl whitespace-normal sm:whitespace-pre-line text-base sm:text-lg leading-relaxed text-white/75" data-reveal="up" data-reveal-delay="280">
				{subtitle}
			</p>
		)}
	</div>
</section>
