---
/**
 * HistoryTimeline — the "Our History" timeline. Widescreen (16:9) panels — portrait
 * (3:4) on mobile so long captions fit — with a Hebrew accent line in the top-right
 * corner and title + caption overlaid on the photo. The strip auto-pans slowly and
 * loops seamlessly; visitors can also move it themselves with the prev/next arrows
 * or by swiping (it's a native horizontal scroller under the hood). Auto-pan pauses
 * on hover and for a few seconds after any manual interaction. A blurred copy of
 * the same photo fills any letterbox gaps when an image's aspect doesn't match.
 *
 * Ported from the "A · Widescreen" demo option (see design log #024 / the /demo
 * page); manual navigation + the `hebrew` field added in #043.
 */
interface EntryInput {
	/** Hebrew accent line, e.g. "מאין באנו" — top-right corner of the card. */
	hebrew?: string;
	title?: string;
	caption?: string;
	imageUrl?: string;
}

interface InternalEntry extends EntryInput {
	from?: string;
	to?: string;
}

interface Props {
	entries?: EntryInput[];
	/** Seconds the auto-pan takes per card — controls pan speed. */
	secondsPerCard?: number;
}

const placeholder: InternalEntry[] = [
	{ title: "The Beginning", caption: "A handful of families and a shared dream of Torah in Ra'anana.", from: "var(--color-navy-500)", to: "var(--color-gold-500)" },
	{ title: "Beis Medrash Opens", caption: "Daily learning finds a permanent home.", from: "var(--color-navy-400)", to: "var(--color-gold-300)" },
	{ title: "A Growing Kehilla", caption: "Minyanim, shiurim, and chavrutas throughout the day.", from: "var(--color-navy-600)", to: "var(--color-gold-600)" },
	{ title: "Community Events", caption: "Holidays, melaveh malka, and moments together.", from: "var(--color-navy-300)", to: "var(--color-gold-400)" },
	{ title: "Looking Ahead", caption: "Building the next chapter of RCK, together.", from: "var(--color-navy-700)", to: "var(--color-gold-200)" },
];

const { secondsPerCard = 12 } = Astro.props;
const entries: InternalEntry[] =
	Astro.props.entries && Astro.props.entries.length > 0 ? Astro.props.entries : placeholder;

// Duplicate the list so the strip can wrap seamlessly (jumping by half the
// track width lands on identical content).
const loop = [...entries, ...entries];
---

<div class="history-tl relative" data-history-tl data-seconds-per-card={secondsPerCard}>
	<div class="history-tl__viewport" data-history-viewport>
		<div class="history-tl__track" data-history-track>
			{loop.map((entry, i) => (
				<article
					class="history-card aspect-[3/4] sm:aspect-[16/9] w-[88vw] sm:w-[60vw] lg:w-[48vw]"
					aria-hidden={i >= entries.length ? "true" : undefined}
				>
					{/* blurred same-image fill behind, so odd ratios look intentional */}
					{entry.imageUrl ? (
						<>
							<img src={entry.imageUrl} alt="" aria-hidden="true" class="history-card__bg" />
							<img src={entry.imageUrl} alt={entry.title ?? ""} class="history-card__img" loading="lazy" />
						</>
					) : (
						<div
							class="history-card__placeholder"
							style={`background: linear-gradient(135deg, ${entry.from ?? "var(--color-navy-500)"} 0%, ${entry.to ?? "var(--color-gold-500)"} 100%);`}
							aria-hidden="true"
						/>
					)}

					{/* legibility gradient */}
					<div class="history-card__scrim" aria-hidden="true"></div>

					{entry.hebrew && (
						<span lang="he" dir="rtl" class="history-card__hebrew">{entry.hebrew}</span>
					)}

					<div class="history-card__overlay">
						{entry.title && <h3 class="history-card__title">{entry.title}</h3>}
						{entry.caption && <p class="history-card__caption">{entry.caption}</p>}
					</div>
				</article>
			))}
		</div>
	</div>

	<button
		type="button"
		data-history-prev
		aria-label="Move timeline back"
		class="history-tl__btn left-3 sm:left-6"
	>
		<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
			<path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>
	<button
		type="button"
		data-history-next
		aria-label="Move timeline forward"
		class="history-tl__btn right-3 sm:right-6"
	>
		<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
			<path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>
</div>

<style>
	.history-tl__viewport {
		overflow-x: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}
	.history-tl__viewport::-webkit-scrollbar {
		display: none;
	}
	.history-tl__track {
		display: flex;
		width: max-content;
	}

	.history-tl__btn {
		position: absolute;
		top: 50%;
		z-index: 10;
		display: flex;
		height: 2.75rem;
		width: 2.75rem;
		transform: translateY(-50%);
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.92);
		color: var(--color-navy-700);
		box-shadow: 0 12px 28px -12px rgb(from var(--color-navy-700) r g b / 0.55);
		transition: background-color 0.2s ease, transform 0.2s ease;
	}
	.history-tl__btn:hover {
		background: var(--color-gold-400);
		transform: translateY(-50%) scale(1.06);
	}
	.history-tl__btn:focus-visible {
		outline: 2px solid var(--color-gold-500);
		outline-offset: 2px;
	}

	.history-card {
		position: relative;
		flex: 0 0 auto;
		margin-right: 1.25rem;
		overflow: hidden;
		border-radius: 0.375rem;
		background: var(--color-navy-700);
		box-shadow: 0 28px 60px -34px rgb(from var(--color-navy-700) r g b / 0.7);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	@media (min-width: 640px) {
		.history-card {
			margin-right: 1.5rem;
		}
	}

	.history-card__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.15);
		filter: blur(22px) saturate(1.1) brightness(0.65);
	}
	.history-card__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.history-card__placeholder {
		position: absolute;
		inset: 0;
	}
	/* Mobile cards are portrait (3:4) so the full caption fits — the scrim rises
	   higher and type runs smaller. From sm: up cards are 16:9 with roomier type. */
	.history-card__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(2, 8, 23, 0.94) 10%, rgba(2, 8, 23, 0.55) 48%, transparent 78%);
	}

	.history-card__hebrew {
		position: absolute;
		top: 0.9rem;
		right: 1.1rem;
		z-index: 1;
		font-family: var(--font-hebrew);
		font-weight: 500;
		font-size: 2.25rem;
		line-height: 1.2;
		color: var(--color-gold-200, #f6d66b);
		text-shadow: 0 2px 14px rgba(2, 8, 23, 0.7);
	}

	.history-card__overlay {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 1.15rem 1.25rem 1.3rem;
		color: #fff;
	}
	.history-card__title {
		font-family: var(--font-sans);
		font-weight: 700;
		letter-spacing: -0.01em;
		font-size: 1.2rem;
		color: #fff;
	}
	.history-card__caption {
		margin-top: 0.3rem;
		font-size: 0.875rem;
		line-height: 1.45;
		max-width: 52ch;
		color: rgba(255, 255, 255, 0.78);
	}
	@media (min-width: 640px) {
		.history-card__scrim {
			background: linear-gradient(to top, rgba(2, 8, 23, 0.92) 4%, rgba(2, 8, 23, 0.45) 34%, transparent 62%);
		}
		.history-card__hebrew {
			top: 1.1rem;
			right: 1.4rem;
			font-size: 3rem;
		}
		.history-card__overlay {
			padding: 1.5rem 1.8rem 1.7rem;
		}
		.history-card__title {
			font-size: 1.4rem;
		}
		.history-card__caption {
			font-size: 0.95rem;
		}
	}
</style>

<script>
	// Auto-pan + manual navigation. The strip is a native horizontal scroller,
	// so swipe/trackpad always work; a rAF loop advances scrollLeft for the slow
	// marquee effect and wraps by half the (duplicated) track width for a
	// seamless loop. Hover pauses; any manual input pauses briefly, then the
	// pan resumes.
	document.querySelectorAll<HTMLElement>("[data-history-tl]").forEach((root) => {
		const viewport = root.querySelector<HTMLElement>("[data-history-viewport]");
		const track = root.querySelector<HTMLElement>("[data-history-track]");
		if (!viewport || !track) return;
		const cards = track.querySelectorAll<HTMLElement>(".history-card");
		if (cards.length < 4) return; // needs ≥2 real entries for looping to make sense

		const secondsPerCard = Number(root.dataset.secondsPerCard) || 12;
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const half = () => track.scrollWidth / 2;
		const step = () => cards[1].offsetLeft - cards[0].offsetLeft; // card width + gap

		let hovered = false;
		let holdUntil = 0; // pause auto-pan until this timestamp after manual input
		let smoothing = false; // an arrow-triggered smooth scroll is in flight
		let pendingTarget: number | null = null;
		let settleTimer: ReturnType<typeof setTimeout> | undefined;

		const hold = (ms: number) => {
			holdUntil = Math.max(holdUntil, performance.now() + ms);
		};

		root.addEventListener("pointerenter", (e) => {
			if (e.pointerType === "mouse") hovered = true;
		});
		root.addEventListener("pointerleave", (e) => {
			if (e.pointerType === "mouse") hovered = false;
		});
		(["wheel", "touchstart", "pointerdown"] as const).forEach((t) =>
			viewport.addEventListener(t, () => hold(4000), { passive: true }),
		);

		// Seamless wrap — content is duplicated, so jumping by half is invisible.
		const wrap = () => {
			const h = half();
			if (viewport.scrollLeft >= h) viewport.scrollLeft -= h;
			else if (viewport.scrollLeft < 0) viewport.scrollLeft += h;
		};

		let last = performance.now();
		const tick = (now: number) => {
			const dt = Math.min(now - last, 100); // clamp after tab-switch pauses
			last = now;
			if (!reduce && !hovered && !smoothing && now > holdUntil) {
				viewport.scrollLeft += (step() / (secondsPerCard * 1000)) * dt;
			}
			if (!smoothing) wrap();
			requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);

		const go = (dir: 1 | -1) => {
			hold(6000);
			const s = step();
			const h = half();
			const base = pendingTarget ?? viewport.scrollLeft;
			let target = (Math.round(base / s) + dir) * s;
			// A scroller can't go below 0, so hop into the duplicate half first
			// (identical pixels) and aim from there.
			if (target < 0) {
				viewport.scrollLeft += h;
				target += h;
			}
			pendingTarget = target;
			smoothing = true;
			clearTimeout(settleTimer);
			settleTimer = setTimeout(() => {
				smoothing = false;
				pendingTarget = null;
				wrap();
			}, 700);
			viewport.scrollTo({ left: target, behavior: reduce ? "auto" : "smooth" });
		};

		root.querySelector("[data-history-prev]")?.addEventListener("click", () => go(-1));
		root.querySelector("[data-history-next]")?.addEventListener("click", () => go(1));
	});
</script>
