---
interface EntryInput {
	year?: number;
	title?: string;
	caption?: string;
	imageUrl?: string;
}

interface InternalEntry extends EntryInput {
	from?: string;
	to?: string;
}

interface Props {
	entries?: EntryInput[];
}

const placeholder: InternalEntry[] = [
	{ year: 2019, title: "The Beginning", caption: "A handful of families and a shared dream of Torah in Ra'anana.", from: "#243c63", to: "#d6a21e" },
	{ year: 2021, title: "Beis Medrash Opens", caption: "Daily learning finds a permanent home.", from: "#3e4d6b", to: "#ebbf42" },
	{ year: 2023, title: "A Growing Kehilla", caption: "Minyanim, shiurim, and chavrutas throughout the day.", from: "#102a56", to: "#a47915" },
	{ year: 2024, title: "Community Events", caption: "Holidays, melaveh malka, and moments together.", from: "#6b7790", to: "#dfb030" },
	{ year: 2025, title: "Looking Ahead", caption: "Building the next chapter of RCK, together.", from: "#07173a", to: "#f6d66b" },
];

const entries: InternalEntry[] = Astro.props.entries && Astro.props.entries.length > 0
	? Astro.props.entries
	: placeholder;
---

<div class="relative" data-history>
	<!-- edge fades hint that there's more to either side -->
	<div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-20 w-8 bg-gradient-to-r from-mist to-transparent sm:w-16"></div>
	<div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-20 w-8 bg-gradient-to-l from-mist to-transparent sm:w-16"></div>

	<div
		data-history-track
		tabindex="0"
		role="group"
		aria-label="RCK history timeline — scroll horizontally to explore"
		class="no-scrollbar flex gap-6 overflow-x-auto px-6 pb-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-300 sm:px-12"
	>
		{
			entries.map((entry, i) => (
				<article class="group/card relative flex w-[260px] shrink-0 flex-col sm:w-[320px]">
					{/* timeline spine + year node */}
					<div class="relative mb-5 flex items-center">
						<span aria-hidden="true" class="absolute left-0 top-[7px] h-px w-[calc(100%+1.5rem)] bg-navy-600/15" />
						<span class="relative z-10 h-3.5 w-3.5 shrink-0 rounded-sm bg-gold-500 ring-4 ring-mist" />
						<span class="relative z-10 ml-3 bg-mist pr-2 font-display text-2xl font-medium text-gold-600 sm:text-3xl">
							{entry.year ?? "—"}
						</span>
					</div>

					<figure
						class="relative aspect-[4/3] w-full overflow-hidden rounded-md shadow-[0_24px_48px_-28px_rgba(7,23,58,0.45)] ring-1 ring-navy-100"
						style={entry.imageUrl
							? undefined
							: `background: linear-gradient(135deg, ${entry.from ?? "#243c63"} 0%, ${entry.to ?? "#d6a21e"} 100%);`}
					>
						{entry.imageUrl && (
							<img
								src={entry.imageUrl}
								alt={entry.title ?? ""}
								loading={i < 2 ? "eager" : "lazy"}
								class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover/card:scale-105"
							/>
						)}
						<div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent" />
					</figure>

					{entry.title && (
						<h3 class="mt-4 font-sans text-lg font-bold tracking-[-0.01em] text-navy-700 sm:text-xl">
							{entry.title}
						</h3>
					)}
					{entry.caption && (
						<p class="mt-1 text-sm leading-relaxed text-navy-500">{entry.caption}</p>
					)}
				</article>
			))
		}
	</div>
</div>

<style>
	.no-scrollbar {
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	const SPEED = 24; // px per second — a slow, readable pan
	const END_DWELL = 1100; // ms pause at each end before reversing
	const RESUME_DELAY = 2800; // ms to wait after the visitor scrolls manually

	const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)");

	document.querySelectorAll<HTMLElement>("[data-history]").forEach((root) => {
		const track = root.querySelector<HTMLElement>("[data-history-track]");
		if (!track) return;

		let dir = 1;
		let paused = false; // pointer/focus is engaged
		let dwellUntil = 0; // pause window at the ends
		let resumeAt = 0; // pause window after manual scroll
		let last = performance.now();
		let raf = 0;

		const maxScroll = () => track.scrollWidth - track.clientWidth;

		const tick = (now: number) => {
			const dt = Math.min((now - last) / 1000, 0.05);
			last = now;
			const max = maxScroll();
			const blocked = paused || now < resumeAt || now < dwellUntil;
			if (!blocked && max > 1) {
				track.scrollLeft += dir * SPEED * dt;
				if (track.scrollLeft >= max - 0.5) {
					track.scrollLeft = max;
					dir = -1;
					dwellUntil = now + END_DWELL;
				} else if (track.scrollLeft <= 0.5) {
					track.scrollLeft = 0;
					dir = 1;
					dwellUntil = now + END_DWELL;
				}
			}
			raf = requestAnimationFrame(tick);
		};

		const start = () => {
			if (prefersReduced.matches || raf) return;
			last = performance.now();
			raf = requestAnimationFrame(tick);
		};
		const stop = () => {
			if (raf) {
				cancelAnimationFrame(raf);
				raf = 0;
			}
		};

		// Hover and keyboard focus hold the pan so visitors can read.
		root.addEventListener("mouseenter", () => (paused = true));
		root.addEventListener("mouseleave", () => (paused = false));
		track.addEventListener("focusin", () => (paused = true));
		track.addEventListener("focusout", () => (paused = false));

		// Manual scroll takes over, then the pan resumes from wherever they left it.
		const bump = () => {
			resumeAt = performance.now() + RESUME_DELAY;
			last = performance.now();
		};
		track.addEventListener("wheel", bump, { passive: true });
		track.addEventListener("touchstart", () => (paused = true), { passive: true });
		track.addEventListener("touchend", () => {
			paused = false;
			bump();
		}, { passive: true });
		track.addEventListener("pointerdown", () => (paused = true));
		window.addEventListener("pointerup", () => (paused = false));

		// Don't burn cycles while the tab is hidden.
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) stop();
			else start();
		});

		prefersReduced.addEventListener?.("change", () => {
			stop();
			start();
		});

		start();
	});
</script>
