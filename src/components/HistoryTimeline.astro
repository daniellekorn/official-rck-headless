---
/**
 * HistoryTimeline — the "Our History" timeline. Modeled on the UNC Kenan-Flagler
 * history page (a dot at each milestone, photo + title + description right
 * beside it), kept horizontal instead of vertical to stay inside this section
 * of the homepage. A single spine runs along the top of the strip with a dot
 * at each milestone; a short stem drops down to the photo — bounded by a
 * max-width/max-height box but rendered at its own aspect ratio (never
 * cropped), just a drop shadow behind it, no frame or background — then the
 * title and caption below it. Every milestone flows the same direction
 * (down) so the whole thing fits in the section without scrolling the page
 * to see it.
 *
 * Static — nothing moves on its own. It's a native horizontal scroller
 * (swipe/trackpad drag work directly); the prev/next arrows step one
 * milestone at a time.
 */
import Highlight from "./Highlight.astro";

interface EntryInput {
	/** Hebrew accent line, e.g. "מאין באנו" — shown above each milestone's dot. */
	hebrew?: string;
	title?: string;
	caption?: string;
	imageUrl?: string;
}

interface InternalEntry extends EntryInput {
	from?: string;
	to?: string;
}

interface Props {
	entries?: EntryInput[];
}

const placeholder: InternalEntry[] = [
	{ title: "The Beginning", caption: "A handful of families and a shared dream of Torah in Ra'anana.", from: "var(--color-navy-500)", to: "var(--color-gold-500)" },
	{ title: "Beis Medrash Opens", caption: "Daily learning finds a permanent home.", from: "var(--color-navy-400)", to: "var(--color-gold-300)" },
	{ title: "A Growing Kehilla", caption: "Minyanim, shiurim, and chavrutas throughout the day.", from: "var(--color-navy-600)", to: "var(--color-gold-600)" },
	{ title: "Community Events", caption: "Holidays, melaveh malka, and moments together.", from: "var(--color-navy-300)", to: "var(--color-gold-400)" },
	{ title: "Looking Ahead", caption: "Building the next chapter of RCK, together.", from: "var(--color-navy-700)", to: "var(--color-gold-200)" },
];

const entries: InternalEntry[] =
	Astro.props.entries && Astro.props.entries.length > 0 ? Astro.props.entries : placeholder;

/**
 * A caption can carry a Hebrew date range (e.g. a niftar's dates, in
 * parens) and/or the ת.נ.צ.ב.ה memorial acronym — both conventionally read
 * smaller than the surrounding sentence. Splits on those patterns generically
 * (not tied to any one milestone's wording) so any caption gets the same
 * treatment automatically.
 */
function splitCaptionEmphasis(text: string): { text: string; small: boolean }[] {
	const pattern = /\([^)]*[֐-׿][^)]*\)|ת\.?נ\.?צ\.?ב\.?ה\.?|תנצב״ה/g;
	const segments: { text: string; small: boolean }[] = [];
	let lastIndex = 0;
	let match: RegExpExecArray | null;
	while ((match = pattern.exec(text))) {
		if (match.index > lastIndex) segments.push({ text: text.slice(lastIndex, match.index), small: false });
		segments.push({ text: match[0], small: true });
		lastIndex = match.index + match[0].length;
	}
	if (lastIndex < text.length) segments.push({ text: text.slice(lastIndex), small: false });
	return segments;
}

/**
 * The Reb Yisroel Horwitz milestone's photo is a Canva export whose canvas is
 * wider than the portrait crop it frames — the margins are genuinely
 * transparent (checked: alpha 0), not opaque white, so they were showing the
 * section's own near-white background through as blank "sides." Filled with
 * a gradient sampled from the photo's own purple-lit backdrop so the margins
 * read as part of the image instead of empty space. Matched by the Wix media
 * file ID (stable across title edits), not the title text. If more images
 * ever need this, promote it to a real `OurHistory` field instead of adding
 * more IDs here.
 */
const TRANSPARENT_MARGIN_IMAGE_IDS = ["f477b1_eca174a90a384829ac36e2e3efe793b3"];
function marginFillStyle(imageUrl?: string): string | undefined {
	if (!imageUrl || !TRANSPARENT_MARGIN_IMAGE_IDS.some((id) => imageUrl.includes(id))) return undefined;
	return "background: linear-gradient(135deg, #9d769b 0%, #5a3c5a 100%);";
}
---

<div class="history-flow relative" data-history-tl>
	<div class="history-flow__viewport" data-history-viewport>
		<div class="history-flow__track" data-history-track>
			<div class="history-flow__spine" aria-hidden="true"></div>
			{entries.map((entry) => (
				<article class="flow-stop">
					{entry.hebrew && (
						<span lang="he" dir="rtl" class="flow-stop__hebrew">{entry.hebrew}</span>
					)}
					<span class="flow-stop__dot" aria-hidden="true"></span>
					<span class="flow-stop__connector" aria-hidden="true"></span>
					<div class="flow-stop__content">
						<span class="flow-stop__img-wrap" style={marginFillStyle(entry.imageUrl)}>
							{entry.imageUrl ? (
								<img src={entry.imageUrl} alt={entry.title ?? ""} class="flow-stop__img" loading="lazy" />
							) : (
								<div
									class="flow-stop__img flow-stop__img--placeholder"
									style={`background: linear-gradient(135deg, ${entry.from ?? "var(--color-navy-500)"} 0%, ${entry.to ?? "var(--color-gold-500)"} 100%);`}
									aria-hidden="true"
								/>
							)}
						</span>
						<div class="flow-stop__text">
							{entry.title && (
								<h3 class="flow-stop__title">
									<Highlight duration={1400} delay={200}>{entry.title}</Highlight>
								</h3>
							)}
							{entry.caption && (
								<p class="flow-stop__caption">
									{splitCaptionEmphasis(entry.caption).map((seg) =>
										seg.small ? <small class="flow-stop__caption-small">{seg.text}</small> : seg.text,
									)}
								</p>
							)}
						</div>
					</div>
				</article>
			))}
		</div>
	</div>

	<button
		type="button"
		data-history-prev
		aria-label="Move timeline back"
		class="history-tl__btn left-3 sm:left-6"
	>
		<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
			<path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>
	<button
		type="button"
		data-history-next
		aria-label="Move timeline forward"
		class="history-tl__btn right-3 sm:right-6"
	>
		<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
			<path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>
</div>

<style>
	.history-flow {
		--top: 3.1rem; /* spine/dot distance from the top of the track — leaves room for the hebrew line above the dot */
		--title-size: 1rem;
		--hebrew-size: 1.4rem;
		--img-w: 17rem; /* max width/height a photo is allowed to render at — its own */
		--img-h: 9rem; /* aspect ratio decides the actual size within that box, so nothing crops */
		--stem: 0.9rem;
		--dot: 0.9rem;
		--content-w: 15rem;
		--stop-gap: 2rem;
	}
	@media (min-width: 640px) {
		.history-flow {
			--top: 3.4rem;
			--title-size: 1.0625rem;
			--hebrew-size: 1.55rem;
			--img-w: 21rem;
			--img-h: 11rem;
			--stem: 1rem;
			--dot: 1rem;
			--content-w: 18rem;
			--stop-gap: 2.5rem;
		}
	}
	@media (min-width: 1024px) {
		.history-flow {
			--top: 3.75rem;
			--title-size: 1.125rem;
			--hebrew-size: 1.7rem;
			--img-w: 25rem;
			--img-h: 13rem;
			--stem: 1.1rem;
			--content-w: 21rem;
			--stop-gap: 3rem;
		}
	}

	.history-flow__viewport {
		/* Tall enough for the longest caption on the narrowest (mobile) content
		   width — the Reb Yisroel Horwitz milestone's caption (Hebrew dates +
		   ת.נ.צ.ב.ה) wraps to more lines than any other entry and was clipped by
		   the fixed height below 23rem. Taller than strictly needed for shorter
		   entries is an accepted trade (see overflow-y note below) — but keep
		   this as tight as the longest caption allows, since any extra shows as
		   dead space at the bottom of the section for every shorter entry. */
		height: 28rem;
		overflow-x: auto;
		/* Fixed and hidden, not "visible"/"auto" — a slightly-too-tall stop used
		   to make the strip vertically scrollable too, which read as the whole
		   row silently drifting up/down by a few px. The section is sized
		   generously (below) so real content shouldn't hit this ceiling. */
		overflow-y: hidden;
		scrollbar-width: none;
		-ms-overflow-style: none;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}
	@media (min-width: 640px) {
		.history-flow__viewport {
			height: 26rem;
		}
	}
	@media (min-width: 1024px) {
		.history-flow__viewport {
			height: 29rem;
		}
	}
	.history-flow__viewport::-webkit-scrollbar {
		display: none;
	}

	.history-flow__track {
		position: relative;
		display: flex;
		align-items: stretch;
		height: 100%;
		width: max-content;
		padding-inline: 2.5rem;
	}

	.history-flow__spine {
		position: absolute;
		inset-inline: 0;
		top: var(--top);
		height: 2px;
		background: linear-gradient(
			90deg,
			transparent,
			rgb(from var(--color-gold-500) r g b / 0.55) 4%,
			rgb(from var(--color-gold-500) r g b / 0.55) 96%,
			transparent
		);
	}

	.flow-stop {
		position: relative;
		flex: 0 0 auto;
		width: var(--content-w);
		height: 100%;
		margin-right: var(--stop-gap);
	}

	.flow-stop__hebrew {
		position: absolute;
		top: 0;
		left: 50%;
		width: 100%;
		transform: translateX(-50%);
		font-family: "Frank Ruhl Libre", var(--font-hebrew), serif;
		font-weight: 700;
		font-size: var(--hebrew-size);
		color: var(--color-navy-700);
		text-align: center;
		white-space: nowrap;
		z-index: 2;
	}

	.flow-stop__dot {
		position: absolute;
		top: var(--top);
		left: 50%;
		width: var(--dot);
		height: var(--dot);
		transform: translate(-50%, -50%);
		border-radius: 9999px;
		background: var(--color-gold-500);
		box-shadow: 0 0 0 3px var(--color-mist), 0 2px 8px rgb(from var(--color-navy-700) r g b / 0.4);
		z-index: 3;
	}

	.flow-stop__connector {
		position: absolute;
		top: var(--top);
		left: 50%;
		width: 3px;
		height: var(--stem);
		transform: translateX(-50%);
		background: linear-gradient(var(--color-gold-300), var(--color-gold-500));
		z-index: 1;
	}

	.flow-stop__content {
		position: absolute;
		top: calc(var(--top) + var(--stem));
		left: 50%;
		width: 100%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		text-align: center;
		z-index: 2;
	}

	.flow-stop__img-wrap {
		position: relative;
		display: inline-block;
		flex: 0 0 auto;
		overflow: hidden;
		border-radius: 0.85rem;
		/* No frame/background — just the photo and a shadow behind it. Living on
		   the wrapper (not the img) so clipping the sheen below doesn't also
		   clip the shadow, which paints outside the border box. */
		box-shadow: 0 16px 34px -12px rgb(from var(--color-navy-700) r g b / 0.55);
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}
	.flow-stop__img-wrap:hover,
	.flow-stop__img-wrap.is-active {
		/* Same lift the Join Us cards get on hover. .is-active is the touch-device
		   equivalent, driven by scroll position (see script below) since touch
		   has no real :hover to react to. */
		transform: translateY(-0.5rem);
		box-shadow: 0 24px 44px -14px rgb(from var(--color-navy-700) r g b / 0.6);
	}
	@media (prefers-reduced-motion: reduce) {
		.flow-stop__img-wrap {
			transition: none;
		}
	}
	.flow-stop__img {
		display: block;
	}
	img.flow-stop__img {
		/* Bounded by max-width/max-height, not a fixed box — the browser scales
		   the photo down to fit while keeping its own aspect ratio, so nothing
		   is ever cropped. Actual rendered size varies photo to photo.

		   max-width is capped at --content-w (not just --img-w) so a
		   wide/panoramic photo (e.g. the "Today and Onward" milestone's
		   scale-to-fit image, see history.ts SCALE_TO_FIT_PHOTO_IDS) can never
		   render wider than its own flow-stop column and spill into the
		   --stop-gap that separates it from its neighbor — that spillover was
		   shrinking the visible gap for that one milestone versus every other
		   (all narrower than --content-w, so they never hit this edge). */
		width: auto;
		height: auto;
		max-width: min(var(--img-w), var(--content-w));
		max-height: var(--img-h);
		object-fit: contain;
	}
	.flow-stop__img--placeholder {
		width: min(var(--img-w), var(--content-w));
		height: var(--img-h);
	}

	.flow-stop__text {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		gap: 0.3rem;
	}

	.flow-stop__title {
		font-family: var(--font-sans);
		font-weight: 700;
		letter-spacing: -0.01em;
		font-size: var(--title-size);
		color: var(--color-navy-700);
		width: 100%;
		text-align: justify;
		text-align-last: center;
	}

	.flow-stop__caption {
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--color-navy-400);
		width: 100%;
		text-align: justify;
		text-align-last: center;
	}
	.flow-stop__caption-small {
		font-size: 0.85em;
	}
	@media (min-width: 640px) {
		.flow-stop__caption {
			font-size: 0.9rem;
		}
	}
	@media (min-width: 1024px) {
		.flow-stop__caption {
			font-size: 0.9375rem;
		}
	}

	.history-tl__btn {
		position: absolute;
		top: 50%;
		z-index: 10;
		display: flex;
		height: 2.75rem;
		width: 2.75rem;
		transform: translateY(-50%);
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.92);
		color: var(--color-navy-700);
		box-shadow: 0 12px 28px -12px rgb(from var(--color-navy-700) r g b / 0.55);
		transition: background-color 0.2s ease, transform 0.2s ease;
	}
	/* Touch swipe already makes the strip's scrollability obvious on mobile —
	   the arrows are redundant there and just sit on top of the content.
	   Desktop (mouse/trackpad) keeps them. */
	@media (max-width: 639px) {
		.history-tl__btn {
			display: none;
		}
	}
	.history-tl__btn:hover {
		background: var(--color-gold-400);
		transform: translateY(-50%) scale(1.06);
	}
	.history-tl__btn:focus-visible {
		outline: 2px solid var(--color-gold-500);
		outline-offset: 2px;
	}
</style>

<script>
	// Purely manual — nothing scrolls on its own. The strip is a native
	// horizontal scroller (swipe/trackpad drag work directly); the arrows
	// just step one milestone at a time.
	document.querySelectorAll<HTMLElement>("[data-history-tl]").forEach((root) => {
		const viewport = root.querySelector<HTMLElement>("[data-history-viewport]");
		const track = root.querySelector<HTMLElement>("[data-history-track]");
		if (!viewport || !track) return;
		const stops = track.querySelectorAll<HTMLElement>(".flow-stop");
		if (stops.length < 2) return;

		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const step = () => stops[1].offsetLeft - stops[0].offsetLeft; // stop width + gap

		const go = (dir: 1 | -1) => {
			viewport.scrollTo({ left: viewport.scrollLeft + dir * step(), behavior: reduce ? "auto" : "smooth" });
		};

		root.querySelector("[data-history-prev]")?.addEventListener("click", () => go(-1));
		root.querySelector("[data-history-next]")?.addEventListener("click", () => go(1));

		// Touch devices have no real :hover, so the lift effect that highlights
		// an image on desktop hover needs a scroll-driven equivalent: whichever
		// milestone is most visible in the viewport gets .is-active (same lift),
		// and every other milestone loses it — only one lifted at a time.
		if (!window.matchMedia("(hover: hover)").matches) {
			const wraps = Array.from(track.querySelectorAll<HTMLElement>(".flow-stop__img-wrap"));
			if (wraps.length > 0) {
				const ratios = new Map<HTMLElement, number>();
				const applyActive = () => {
					let best: HTMLElement | null = null;
					let bestRatio = 0;
					ratios.forEach((ratio, el) => {
						if (ratio > bestRatio) {
							bestRatio = ratio;
							best = el;
						}
					});
					wraps.forEach((w) => w.classList.toggle("is-active", w === best));
				};
				const thresholds = Array.from({ length: 21 }, (_, i) => i / 20);
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => ratios.set(entry.target as HTMLElement, entry.intersectionRatio));
						applyActive();
					},
					{ root: viewport, threshold: thresholds },
				);
				wraps.forEach((w) => io.observe(w));
			}
		}
	});
</script>
