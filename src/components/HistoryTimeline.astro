---
/**
 * HistoryTimeline — the "Our History" timeline. Widescreen (16:9) panels with an
 * oversized year, title, and caption overlaid on the photo, scrolling in a
 * continuous slow marquee that pauses on hover. A blurred copy of the same photo
 * fills any letterbox gaps when an image's aspect doesn't match the 16:9 card.
 *
 * Ported from the "A · Widescreen" demo option (see design log #024 / the /demo
 * page) into the live site. Pure-CSS marquee — no JS — with a reduced-motion
 * fallback that turns the strip into a normal horizontal scroller.
 */
interface EntryInput {
	year?: number;
	title?: string;
	caption?: string;
	imageUrl?: string;
}

interface InternalEntry extends EntryInput {
	from?: string;
	to?: string;
}

interface Props {
	entries?: EntryInput[];
	/** Seconds the marquee takes per card — controls pan speed. */
	secondsPerCard?: number;
}

const placeholder: InternalEntry[] = [
	{ year: 2019, title: "The Beginning", caption: "A handful of families and a shared dream of Torah in Ra'anana.", from: "var(--color-navy-500)", to: "var(--color-gold-500)" },
	{ year: 2021, title: "Beis Medrash Opens", caption: "Daily learning finds a permanent home.", from: "var(--color-navy-400)", to: "var(--color-gold-300)" },
	{ year: 2023, title: "A Growing Kehilla", caption: "Minyanim, shiurim, and chavrutas throughout the day.", from: "var(--color-navy-600)", to: "var(--color-gold-600)" },
	{ year: 2024, title: "Community Events", caption: "Holidays, melaveh malka, and moments together.", from: "var(--color-navy-300)", to: "var(--color-gold-400)" },
	{ year: 2025, title: "Looking Ahead", caption: "Building the next chapter of RCK, together.", from: "var(--color-navy-700)", to: "var(--color-gold-200)" },
];

const { secondsPerCard = 7 } = Astro.props;
const entries: InternalEntry[] =
	Astro.props.entries && Astro.props.entries.length > 0 ? Astro.props.entries : placeholder;

// Duplicate the list so the marquee can wrap seamlessly (translateX -50%).
const loop = [...entries, ...entries];
const dur = Math.max(entries.length, 1) * secondsPerCard;
---

<div class="history-tl" style={`--marquee-dur:${dur}s`}>
	<div class="history-tl__viewport">
		<div class="history-tl__track">
			{loop.map((entry, i) => (
				<article
					class="history-card aspect-[16/9] w-[88vw] sm:w-[60vw] lg:w-[48vw]"
					aria-hidden={i >= entries.length ? "true" : undefined}
				>
					{/* blurred same-image fill behind, so odd ratios look intentional */}
					{entry.imageUrl ? (
						<>
							<img src={entry.imageUrl} alt="" aria-hidden="true" class="history-card__bg" />
							<img src={entry.imageUrl} alt={entry.title ?? ""} class="history-card__img" loading="lazy" />
						</>
					) : (
						<div
							class="history-card__placeholder"
							style={`background: linear-gradient(135deg, ${entry.from ?? "var(--color-navy-500)"} 0%, ${entry.to ?? "var(--color-gold-500)"} 100%);`}
							aria-hidden="true"
						/>
					)}

					{/* legibility gradient */}
					<div class="history-card__scrim" aria-hidden="true"></div>

					<div class="history-card__overlay">
						{entry.year && <span class="history-card__year">{entry.year}</span>}
						{entry.title && <h3 class="history-card__title">{entry.title}</h3>}
						{entry.caption && <p class="history-card__caption">{entry.caption}</p>}
					</div>
				</article>
			))}
		</div>
	</div>
</div>

<style>
	.history-tl__viewport {
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}
	.history-tl__track {
		display: flex;
		width: max-content;
		animation: history-marquee var(--marquee-dur) linear infinite;
		will-change: transform;
	}
	.history-tl:hover .history-tl__track {
		animation-play-state: paused;
	}
	@keyframes history-marquee {
		to {
			transform: translateX(-50%);
		}
	}

	.history-card {
		position: relative;
		flex: 0 0 auto;
		margin-right: 1.25rem;
		overflow: hidden;
		border-radius: 0.375rem;
		background: var(--color-navy-700);
		box-shadow: 0 28px 60px -34px rgb(from var(--color-navy-700) r g b / 0.7);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	@media (min-width: 640px) {
		.history-card {
			margin-right: 1.5rem;
		}
	}

	.history-card__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.15);
		filter: blur(22px) saturate(1.1) brightness(0.65);
	}
	.history-card__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.history-card__placeholder {
		position: absolute;
		inset: 0;
	}
	.history-card__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(2, 8, 23, 0.92) 4%, rgba(2, 8, 23, 0.45) 34%, transparent 62%);
	}

	.history-card__overlay {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 1.5rem 1.8rem 1.7rem;
		color: #fff;
	}
	.history-card__year {
		display: block;
		font-family: var(--font-display);
		font-weight: 500;
		line-height: 0.9;
		font-size: 3.4rem;
		letter-spacing: -0.01em;
		color: var(--color-gold-200, #f6d66b);
	}
	.history-card__title {
		margin-top: 0.4rem;
		font-family: var(--font-sans);
		font-weight: 700;
		letter-spacing: -0.01em;
		font-size: 1.4rem;
		color: #fff;
	}
	.history-card__caption {
		margin-top: 0.3rem;
		font-size: 0.95rem;
		line-height: 1.45;
		max-width: 52ch;
		color: rgba(255, 255, 255, 0.78);
	}

	@media (prefers-reduced-motion: reduce) {
		.history-tl__viewport {
			overflow-x: auto;
		}
		.history-tl__track {
			animation: none;
		}
	}
</style>
