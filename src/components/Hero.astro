---
import type { HeroSlide } from "../lib/hero-media";

interface Props {
	eyebrow?: string;
	subtitle?: string;
	/** Ordered hero background slides (the single source for the hero background —
	 *  see design-log/030). One image renders as a static background; more become
	 *  a crossfading image/video sequence. Empty → the brand gradient placeholder. */
	slides?: HeroSlide[];
	primaryCtaLabel?: string;
	primaryCtaHref?: string;
	secondaryCtaLabel?: string;
	secondaryCtaHref?: string;
}

// The brand lockup (the "RCK" headline + "The Ra'anana Community Kollel"
// credit line) is structural, not content. See design-log/009 and /021.
const {
	eyebrow,
	subtitle = "A home for Torah, community, and growth in Ra'anana, Israel.",
	slides = [],
	primaryCtaLabel = "Our Schedule",
	primaryCtaHref = "/daven#community-schedule",
	secondaryCtaLabel = "Our Programs",
	secondaryCtaHref = "/events",
} = Astro.props;

const hasSlides = slides.length > 0;
const singleVideo = slides.length === 1 && slides[0].kind === "video";
---

<section class="relative isolate overflow-hidden min-h-screen flex items-end">
	{hasSlides ? (
		<div class="absolute inset-0 -z-10" data-hero-slides aria-hidden="true">
			{slides.map((slide, i) => (
				<div
					class="hero-slide absolute inset-0"
					data-hero-slide
					data-kind={slide.kind}
					data-index={i}
					data-hold={slide.kind === "image" ? String(slide.holdMs ?? 6000) : undefined}
					style={i === 0 ? "opacity:1" : "opacity:0"}
				>
					{slide.kind === "video" ? (
						<video
							class="h-full w-full object-cover"
							src={slide.url}
							poster={slide.poster}
							muted
							playsinline
							loop={singleVideo}
							preload={i === 0 ? "auto" : "none"}
							data-hero-video
						></video>
					) : (
						<img
							src={slide.url}
							alt=""
							class="h-full w-full object-cover"
							loading={i === 0 ? "eager" : "lazy"}
						/>
					)}
				</div>
			))}
			<div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/25 to-black/55"></div>
			{/* Left scrim under the lockup — video frames are unpredictable and the
			    bottom gradient alone leaves the text over the brightest area. */}
			<div class="absolute inset-0 bg-gradient-to-r from-navy-700/75 via-navy-700/30 to-transparent"></div>
		</div>
	) : (
		<>
			<div
				class="absolute inset-0 -z-10 bg-navy-700"
				style="background-image:
					radial-gradient(1200px 600px at 20% 20%, rgb(from var(--color-gold-500) r g b / 0.18), transparent 60%),
					radial-gradient(900px 500px at 85% 80%, rgb(from var(--color-navy-500) r g b / 0.6), transparent 60%),
					linear-gradient(135deg, var(--color-navy-700) 0%, var(--color-navy-600) 60%, var(--color-navy-500) 100%);"
				aria-hidden="true"
			>
			</div>
			<div
				class="absolute inset-0 -z-10 opacity-[0.07]"
				style="background-image: repeating-linear-gradient(45deg, #fff 0 1px, transparent 1px 14px);"
				aria-hidden="true"
			>
			</div>
			<div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/10 via-transparent to-black/40" aria-hidden="true"></div>
		</>
	)}

	<div class="container-page pb-20 pt-40 md:pt-48 md:pb-24 w-full">
		{/* Text shadow keeps the lockup legible over bright video frames the
		    scrim can't fully predict. */}
		<div class="max-w-3xl" style="text-shadow: 0 2px 24px rgba(7, 23, 58, 0.45), 0 1px 3px rgba(7, 23, 58, 0.35);">
			{eyebrow && <p class="eyebrow text-base! sm:text-lg! text-gold-300" data-reveal="up">{eyebrow}</p>}
			<h1
				class="mt-4 font-display text-[4.375rem] leading-[1.02] text-white sm:text-[5.25rem] md:text-[6.5625rem] lg:text-[7.875rem] font-medium"
				data-reveal="left"
			>
				RCK
			</h1>
			<p class="mt-4 font-display text-xl sm:text-2xl md:text-3xl text-gold-300 font-medium" data-reveal="up" data-reveal-delay="150">
				The Ra'anana Community Kollel
			</p>
			<div class="mt-8 flex max-w-xl gap-4" data-reveal="up" data-reveal-delay="300">
				<span class="block w-[3px] shrink-0 self-stretch rounded-sm bg-gold-400" aria-hidden="true"></span>
				<div>
					<p class="text-base sm:text-lg text-white/85 leading-relaxed">
						{subtitle}
					</p>
					<p class="mt-0.5 text-sm sm:text-base text-white/85 font-medium italic tracking-wide">
						Since 1998
					</p>
				</div>
			</div>
		</div>

		<div class="mt-12 flex flex-col sm:flex-row sm:justify-end gap-3 sm:gap-4" data-reveal="up" data-reveal-delay="450">
			{primaryCtaLabel && (
				<a
					href={primaryCtaHref}
					class="inline-flex items-center justify-center rounded-sm bg-gold-500 border border-gold-500 px-7 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-navy-700 transition-colors hover:bg-gold-400 hover:border-gold-400"
				>
					{primaryCtaLabel}
				</a>
			)}
			{secondaryCtaLabel && (
				<a
					href={secondaryCtaHref}
					class="inline-flex items-center justify-center rounded-sm border border-gold-400 px-7 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-white transition-colors hover:bg-white/10"
				>
					{secondaryCtaLabel}
				</a>
			)}
		</div>
	</div>
</section>

<style>
	.hero-slide {
		opacity: 0;
		transition: opacity 3.2s cubic-bezier(0.45, 0, 0.2, 1);
		will-change: opacity;
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-slide {
			transition: none;
		}
	}
</style>

<script>
	// Hero media sequence: crossfade through stacked image/video slides.
	// Images hold for data-hold ms; videos play once (muted) then fade to the
	// next; the sequence loops. Honors prefers-reduced-motion (no cycle, no
	// autoplay — first slide stays put; a video shows its poster). See #029.
	(() => {
		const container = document.querySelector<HTMLElement>("[data-hero-slides]");
		if (!container) return;
		const slides = Array.from(container.querySelectorAll<HTMLElement>("[data-hero-slide]"));
		if (slides.length <= 1) {
			// Single slide: nothing to cycle. A lone video loops on its own (loop
			// attr set in markup); just start it unless motion is reduced.
			const lone = slides[0]?.querySelector<HTMLVideoElement>("[data-hero-video]");
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (lone && !reduce) lone.play().catch(() => {});
			return;
		}

		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		if (reduce) return; // first slide is already visible; leave it static.

		// Kept in sync with the .hero-slide CSS transition duration above.
		const FADE_MS = 3200;

		let current = 0;
		let timer: ReturnType<typeof setTimeout> | undefined;
		let activeVideoCleanup: (() => void) | undefined;

		const videoOf = (el: HTMLElement) => el.querySelector<HTMLVideoElement>("[data-hero-video]");

		// Buffering a video only when it becomes active causes a stutter right as
		// it's meant to be fading in smoothly. Warm up the *next* slide's video as
		// soon as the current one starts, so it's ready to play instantly later.
		const preloadNext = (afterIndex: number) => {
			const upcoming = slides[(afterIndex + 1) % slides.length];
			const video = videoOf(upcoming);
			if (video && video.preload !== "auto") {
				video.preload = "auto";
				video.load();
			}
		};

		// Remove any stale listeners before attaching new ones. Without this,
		// scrolling away and back re-calls scheduleAdvance and adds duplicate
		// listeners — the video then triggers advance() twice and skips a slide.
		const cleanupActiveVideo = () => {
			activeVideoCleanup?.();
			activeVideoCleanup = undefined;
		};

		const scheduleAdvance = (el: HTMLElement) => {
			clearTimeout(timer);
			cleanupActiveVideo();
			preloadNext(Number(el.dataset.index ?? current));
			const video = videoOf(el);
			if (el.dataset.kind === "video" && video) {
				video.preload = "auto";
				// Guard the seek: a video that hasn't loaded metadata yet (readyState
				// HAVE_NOTHING) is already at currentTime 0, and setting it explicitly
				// before then throws InvalidStateError on some WebKit builds — with no
				// try/catch around this block, that exception skips every line after
				// it, including video.play() below. Slide 0 is the one that hits this:
				// its scheduleAdvance() call runs synchronously on page load, before
				// there's been time for even one network round trip; later slides are
				// already warmed by preloadNext() by the time they become active.
				if (video.readyState > 0) video.currentTime = 0;

				// True crossfade, not "play to the end, then fade": start the
				// opacity transition while the outgoing video still has FADE_MS
				// left to play, so both videos are visibly overlapping/blending
				// instead of the fade only beginning once the clip has fully
				// stopped (which read as a pause before the switch).
				let fired = false;
				const fadeStart = () => {
					if (fired) return;
					fired = true;
					advance();
				};
				const onTimeUpdate = () => {
					const dur = video.duration;
					if (!Number.isFinite(dur) || dur <= 0) return;
					// Cap the overlap at half the clip's own length. Without this, a
					// clip shorter than FADE_MS clamps straight to 0 — its very first
					// timeupdate tick satisfies the threshold and the fade starts
					// almost the instant the video appears, reading as a rushed cut
					// rather than a fade. Longer clips are unaffected (still the full
					// FADE_MS overlap).
					const overlapSec = Math.min(FADE_MS / 1000, dur / 2);
					if (video.currentTime >= dur - overlapSec) fadeStart();
				};
				video.addEventListener("timeupdate", onTimeUpdate);
				// Safety net for clips whose duration never resolves (or is shorter
				// than FADE_MS): "ended" still guarantees a fade eventually fires.
				video.addEventListener("ended", fadeStart, { once: true });
				// A video that can't load at all (bad/expired CDN URL, unsupported
				// rendition — this is exactly what happened when a hero clip was
				// requested at a resolution Wix never transcoded it to) would
				// otherwise just sit on its poster until the 12s fallback below.
				// Skip it immediately instead of stalling the whole cycle on a
				// slide that will never play.
				video.addEventListener("error", fadeStart, { once: true });
				activeVideoCleanup = () => {
					video.removeEventListener("timeupdate", onTimeUpdate);
					video.removeEventListener("ended", fadeStart);
					video.removeEventListener("error", fadeStart);
				};

				// Belt-and-suspenders: if neither event fires (e.g. autoplay was
				// blocked), advance after the clip's duration, or 12s when unknown.
				const fallbackMs = Number.isFinite(video.duration) && video.duration > 0 ? (video.duration + 1) * 1000 : 12000;
				timer = setTimeout(() => {
					cleanupActiveVideo();
					fadeStart();
				}, fallbackMs);
				video.play().catch(() => {});
			} else {
				const hold = Number(el.dataset.hold ?? 6000);
				timer = setTimeout(advance, hold);
			}
		};

		const advance = () => {
			const prev = slides[current];
			current = (current + 1) % slides.length;
			const next = slides[current];
			next.style.opacity = "1";
			prev.style.opacity = "0";
			// Stop the outgoing video once the crossfade has finished.
			const prevVideo = videoOf(prev);
			if (prevVideo) {
				window.setTimeout(() => {
					prevVideo.pause();
					prevVideo.currentTime = 0;
				}, FADE_MS);
			}
			scheduleAdvance(next);
		};

		scheduleAdvance(slides[0]);

		// Pause the cycle while the hero is off-screen (saves work/bandwidth),
		// and resume it on the way back. Skip the observer's initial intersecting
		// callback so we don't double-schedule the slide we just started.
		if (typeof IntersectionObserver !== "undefined") {
			let started = false;
			let paused = false;
			const io = new IntersectionObserver(
				(entries) => {
					const visible = entries[entries.length - 1].isIntersecting;
					if (!started) {
						started = true;
						return;
					}
					if (!visible && !paused) {
						paused = true;
						clearTimeout(timer);
						videoOf(slides[current])?.pause();
					} else if (visible && paused) {
						paused = false;
						scheduleAdvance(slides[current]);
					}
				},
				{ threshold: 0 },
			);
			io.observe(container);
		}
	})();
</script>
