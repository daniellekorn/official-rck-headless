---
import HistoryTimeline from "./HistoryTimeline.astro";

interface EntryInput {
	hebrew?: string;
	title?: string;
	caption?: string;
	imageUrl?: string;
}

interface Props {
	title?: string;
	hebrew?: string;
	entries?: EntryInput[];
}

const {
	title = "Our History",
	hebrew = "דַּע מֵאַיִן בָּאתָ וּלְאָן אַתָּה הוֹלֵךְ",
	entries,
} = Astro.props;
---

<section class="bg-mist py-12 md:py-14">
	<div class="container-page">
		<div class="text-center">
			<h2 class="font-display text-4xl md:text-5xl font-medium text-navy-600" data-reveal="up">
				{title}
			</h2>
			<span class="gold-rule mx-auto mt-4" aria-hidden="true" data-reveal="up" data-reveal-delay="100"></span>
			{hebrew && (
				<p
					lang="he"
					dir="rtl"
					class="mx-auto mt-6 max-w-2xl text-3xl md:text-4xl font-medium text-gold-600"
					style="font-family: 'Frank Ruhl Libre', var(--font-hebrew), serif;"
					data-reveal="up"
					data-reveal-delay="180"
				>
					{hebrew}
				</p>
			)}
		</div>
	</div>

	<!-- Full-bleed free-flow timeline (breaks out of container-page on purpose). -->
	<div class="mt-8 md:mt-10">
		<HistoryTimeline entries={entries} />
	</div>
</section>
