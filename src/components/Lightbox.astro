---
/**
 * Site-wide image viewer. Rendered ONCE in Layout.astro. Any element on the
 * page opts in via data attributes — no per-page wiring:
 *
 *   - [data-lightbox-open] + data-lightbox-src (+ optional -title) → opens the
 *     full-size overlay on click, single-image mode (flyers).
 *   - [data-lightbox-open] + data-lightbox-gallery (JSON array for *just that
 *     gallery*) + data-lightbox-index (which one was clicked) → opens in
 *     gallery mode: prev/next buttons, ←/→ keys, swipe, and it loops at both
 *     ends. Each trigger carries its own gallery's items, so multiple
 *     independent galleries on one page (e.g. one per Past Event) never
 *     cross-navigate into each other. Each gallery item is either a plain
 *     image URL string, or `{ type: "youtube", videoId }` for a YouTube slide
 *     mixed in among the photos (see design log #050) — the slide swaps
 *     between the <img> and a YouTube <iframe> depending on which it is.
 *   - [data-download] + data-download-src (+ optional -name) → downloads the
 *     file. The HTML `download` attr is ignored cross-origin and Wix media is
 *     cross-origin, so we fetch → blob → save, and fall back to opening the
 *     image in a new tab when CORS blocks the fetch. Hidden entirely on a
 *     video slide — there's nothing to download.
 *
 * Native <dialog> gives us focus-trap, Esc-to-close, and ::backdrop for free.
 * `is:global` + a single delegated listener — see #031.
 */
---

<dialog data-lightbox class="lightbox" aria-label="Image viewer">
	<figure class="lightbox-figure">
		<img data-lightbox-img class="lightbox-img" alt="" />
		<iframe
			data-lightbox-video
			class="lightbox-video"
			title="Video"
			hidden
			allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share"
			allowfullscreen
		></iframe>
		<figcaption data-lightbox-caption class="lightbox-caption"></figcaption>
	</figure>

	<button type="button" data-lightbox-prev aria-label="Previous photo" class="lightbox-nav lightbox-nav-prev" hidden>
		<svg viewBox="0 0 24 24" class="lightbox-icon" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>
	<button type="button" data-lightbox-next aria-label="Next photo" class="lightbox-nav lightbox-nav-next" hidden>
		<svg viewBox="0 0 24 24" class="lightbox-icon" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>
	<span data-lightbox-count class="lightbox-count" hidden></span>

	<div class="lightbox-controls">
		<button type="button" data-download data-lightbox-dl class="lightbox-btn" aria-label="Download image">
			<svg viewBox="0 0 24 24" class="lightbox-icon" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
		<button type="button" data-lightbox-close class="lightbox-btn" aria-label="Close viewer">
			<svg viewBox="0 0 24 24" class="lightbox-icon" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</button>
	</div>
</dialog>

<style is:global>
	.lightbox {
		width: min(92vw, 760px);
		max-width: 92vw;
		max-height: 92vh;
		margin: auto;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: visible;
	}
	.lightbox::backdrop {
		background: rgb(from var(--color-navy-700) r g b / 0.82);
		backdrop-filter: blur(6px);
	}
	.lightbox[open] {
		animation: lightbox-in 0.25s ease;
	}
	@keyframes lightbox-in {
		from { opacity: 0; transform: translateY(8px) scale(0.98); }
		to   { opacity: 1; transform: translateY(0) scale(1); }
	}
	@media (prefers-reduced-motion: reduce) {
		.lightbox[open] { animation: none; }
	}

	.lightbox-figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}
	.lightbox-img {
		display: block;
		max-width: 100%;
		max-height: 84vh;
		width: auto;
		height: auto;
		border-radius: 0.375rem;
		background: var(--color-navy-800);
		box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.7);
	}

	/* A YouTube slide mixed into a photo gallery — fixed 16:9 box (no natural
	   intrinsic size like a photo has). Fills the same width the dialog caps
	   photos to, but its max-width backs off on short/wide viewports so a
	   16:9 box never taller than 84vh (matching the image's own cap). */
	.lightbox-video {
		display: block;
		width: 100%;
		max-width: calc(84vh * 16 / 9);
		aspect-ratio: 16 / 9;
		max-height: 84vh;
		border: 0;
		border-radius: 0.375rem;
		background: var(--color-navy-800);
		box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.7);
	}
	.lightbox-caption {
		color: rgb(255 255 255 / 0.85);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		text-align: center;
	}
	.lightbox-caption:empty { display: none; }

	/* Gallery-mode prev/next — vertically centered on the image, outside its
	   edges. Hidden via [hidden] in single-image (flyer) mode. */
	.lightbox-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 3;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.25rem;
		background: rgb(from var(--color-navy-700, #07173a) r g b / 0.55);
		color: #fff;
		backdrop-filter: blur(4px);
		transition: background 0.18s, transform 0.18s;
	}
	.lightbox-nav:hover {
		background: rgb(from var(--color-navy-700, #07173a) r g b / 0.85);
	}
	.lightbox-nav:active { transform: translateY(-50%) translateY(1px); }
	.lightbox-nav-prev { inset-inline-start: -1rem; }
	.lightbox-nav-next { inset-inline-end: -1rem; }
	@media (max-width: 640px) {
		.lightbox-nav-prev { inset-inline-start: 0.25rem; }
		.lightbox-nav-next { inset-inline-end: 0.25rem; }
	}

	.lightbox-count {
		position: absolute;
		bottom: -2.25rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 3;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: rgb(255 255 255 / 0.85);
		background: rgb(from var(--color-navy-700, #07173a) r g b / 0.5);
		backdrop-filter: blur(4px);
		padding: 0.2rem 0.6rem;
		border-radius: 0.125rem;
	}

	/* Controls sit just above the image, end-aligned (RTL-safe via inset-inline). */
	.lightbox-controls {
		position: absolute;
		top: -3.25rem;
		inset-inline-end: 0;
		display: flex;
		gap: 0.5rem;
	}
	.lightbox-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.25rem;
		color: var(--color-navy-700, #07173a);
		background: #fff;
		box-shadow: 0 8px 24px -10px rgb(0 0 0 / 0.5);
		transition: background 0.18s, color 0.18s, transform 0.18s;
	}
	.lightbox-btn:hover {
		background: var(--color-gold-400, #dfb030);
	}
	.lightbox-btn:active { transform: translateY(1px); }
	.lightbox-icon { width: 1.25rem; height: 1.25rem; }
</style>

<script>
	(() => {
		const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
		if (!dialog) return;
		const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
		const video = dialog.querySelector<HTMLIFrameElement>("[data-lightbox-video]")!;
		const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]")!;
		const dlBtn = dialog.querySelector<HTMLButtonElement>("[data-lightbox-dl]")!;
		const closeBtn = dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]")!;
		const prevBtn = dialog.querySelector<HTMLButtonElement>("[data-lightbox-prev]")!;
		const nextBtn = dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]")!;
		const countEl = dialog.querySelector<HTMLElement>("[data-lightbox-count]")!;

		// A gallery item is a plain image URL, or a YouTube slide mixed in
		// among the photos (see design log #050).
		type GalleryItem = string | { type: "youtube"; videoId: string };

		// Gallery mode: prev/next cycle through just this array (one event's
		// photos, never another's). Empty/null = single-image (flyer) mode.
		let gallery: GalleryItem[] | null = null;
		let index = 0;
		let galleryTitle = "";

		// Pull a clean filename out of a URL (no query string), fall back to title.
		const fileName = (src: string, title?: string) => {
			const base = (title || "flyer").trim().replace(/[^\w.-]+/g, "-").replace(/^-+|-+$/g, "");
			const ext = (src.split("?")[0].match(/\.(png|jpe?g|webp|gif|pdf)$/i)?.[1] || "png").toLowerCase();
			return base.toLowerCase().endsWith(`.${ext}`) ? base : `${base}.${ext}`;
		};

		// Cross-origin-safe download: fetch the bytes and save them; if CORS
		// blocks the fetch, open the asset in a new tab so the user can save it.
		const download = async (src: string, name: string) => {
			try {
				const res = await fetch(src, { mode: "cors" });
				if (!res.ok) throw new Error(String(res.status));
				const url = URL.createObjectURL(await res.blob());
				const a = document.createElement("a");
				a.href = url;
				a.download = name;
				document.body.appendChild(a);
				a.click();
				a.remove();
				URL.revokeObjectURL(url);
			} catch {
				window.open(src, "_blank", "noopener");
			}
		};

		// Delegated download — works for the lightbox button and any flyer card.
		document.addEventListener("click", (e) => {
			const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-download]");
			if (!trigger) return;
			const src = trigger.dataset.downloadSrc || img.src;
			if (!src) return;
			e.preventDefault();
			download(src, trigger.dataset.downloadName || fileName(src, trigger.dataset.downloadTitle));
		});

		// Warm the browser cache for a URL so a later goTo() swap is instant
		// instead of waiting on a fresh network fetch.
		const preloaded = new Set<string>();
		const preload = (src: string) => {
			if (preloaded.has(src)) return;
			preloaded.add(src);
			new Image().src = src;
		};

		// Render whichever slide `index` points at (gallery mode) — updates the
		// image or video, alt/caption, counter, and the download button's
		// target. A slide is either a photo URL string or a YouTube video.
		const render = () => {
			const item: GalleryItem = gallery ? gallery[index] : img.dataset.singleSrc || "";
			if (!item) return;
			const isVideo = typeof item === "object";
			const n = gallery?.length ?? 1;
			const label = galleryTitle
				? n > 1
					? `${galleryTitle} — ${isVideo ? "video" : "photo"} ${index + 1} of ${n}`
					: `${galleryTitle} — full size`
				: "Image, full size";

			if (isVideo) {
				img.hidden = true;
				img.removeAttribute("src");
				video.hidden = false;
				video.src = `https://www.youtube-nocookie.com/embed/${item.videoId}?rel=0`;
			} else {
				video.hidden = true;
				video.src = ""; // stop playback if a video was previously showing
				img.hidden = false;
				img.src = item;
				img.alt = label;
			}
			caption.textContent = n > 1 ? `${galleryTitle} — ${index + 1} / ${n}` : galleryTitle;

			// Nothing to download from a YouTube embed.
			dlBtn.hidden = isVideo;
			if (!isVideo) {
				dlBtn.dataset.downloadSrc = item;
				dlBtn.dataset.downloadName = fileName(item, galleryTitle);
			}

			const showNav = n > 1;
			prevBtn.hidden = !showNav;
			nextBtn.hidden = !showNav;
			countEl.hidden = !showNav;
			if (showNav) countEl.textContent = `${index + 1} / ${n}`;

			// Warm both neighboring photos so the next/prev click that's most
			// likely to happen next is already cached. Videos have nothing
			// worth preloading.
			if (gallery && n > 1) {
				const next = gallery[(index + 1) % n];
				const prev = gallery[(index - 1 + n) % n];
				if (typeof next === "string") preload(next);
				if (typeof prev === "string") preload(prev);
			}
		};

		const goTo = (i: number) => {
			if (!gallery || gallery.length === 0) return;
			index = ((i % gallery.length) + gallery.length) % gallery.length; // loops both ends
			render();
		};

		// Delegated open — single-image (flyer) mode via data-lightbox-src, or
		// gallery mode via data-lightbox-gallery (JSON array) + data-lightbox-index
		// (which photo in that array was clicked).
		document.addEventListener("click", (e) => {
			const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-lightbox-open]");
			if (!trigger) return;

			galleryTitle = trigger.dataset.lightboxTitle || "";

			if (trigger.dataset.lightboxGallery) {
				let parsed: GalleryItem[] = [];
				try {
					parsed = JSON.parse(trigger.dataset.lightboxGallery);
				} catch {
					/* malformed attr — fall through, nothing to show */
				}
				if (!Array.isArray(parsed) || parsed.length === 0) return;
				e.preventDefault();
				gallery = parsed;
				index = Number(trigger.dataset.lightboxIndex) || 0;
				render();
				dialog.showModal();
				return;
			}

			const src = trigger.dataset.lightboxSrc;
			if (!src) return;
			e.preventDefault();
			gallery = null;
			img.dataset.singleSrc = src;
			render();
			dialog.showModal();
		});

		prevBtn.addEventListener("click", () => goTo(index - 1));
		nextBtn.addEventListener("click", () => goTo(index + 1));

		// ←/→ navigate when a gallery is open. Esc-to-close is native to <dialog>.
		dialog.addEventListener("keydown", (e) => {
			if (!gallery) return;
			if (e.key === "ArrowLeft") goTo(index - 1);
			else if (e.key === "ArrowRight") goTo(index + 1);
		});

		// Swipe (touch) — same 40px threshold as the inline PhotoGallery slideshow.
		let touchStartX = 0;
		dialog.addEventListener("touchstart", (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
		dialog.addEventListener("touchend", (e) => {
			if (!gallery) return;
			const dx = e.changedTouches[0].clientX - touchStartX;
			if (Math.abs(dx) > 40) goTo(index + (dx < 0 ? 1 : -1));
		}, { passive: true });

		const close = () => dialog.close();
		closeBtn.addEventListener("click", close);
		// Click on the backdrop (outside the figure) closes.
		dialog.addEventListener("click", (e) => {
			if (e.target === dialog) close();
		});
		// Release the (potentially large) image + gallery state when closed, and
		// stop any playing video — an iframe keeps playing audio in the
		// background otherwise, even once the dialog is visually gone.
		dialog.addEventListener("close", () => {
			img.removeAttribute("src");
			delete img.dataset.singleSrc;
			video.src = "";
			gallery = null;
		});
	})();
</script>
