---
/**
 * WhatsAppCommunity — the closing band of the homepage. Invites people into the
 * kollel's WhatsApp community.
 *
 * Layout:
 *  - Centered header (title + intro line) on top.
 *  - Left: the list of chat groups (Halacha2Go, Boost2Go, Torah Bytes, …) + the
 *    main join CTA.
 *  - Right: 3–4 featured groups as vertical 9:16 video-preview tiles. Each tile
 *    plays that group's YouTube Short inline (click swaps the poster for the
 *    embed); name + one-liner + "Join chat" sit beneath it.
 *  - Light `mist` band, navy/gold type. WhatsApp green is used sparingly (CTA,
 *    list icons, live dot) so the section reads as RCK, not WhatsApp.
 *
 * Content-driven: copy, the chat list, and the featured groups are all props
 * with fallbacks, so the office fills real names + Short IDs in the CMS later.
 */
import Highlight from "./Highlight.astro";

interface Short {
	/** YouTube Short / video id (the part after `/shorts/` or `watch?v=`). */
	videoId?: string;
	/** Optional custom poster (a flyer); falls back to the YouTube thumbnail. */
	posterUrl?: string;
	/** Group name, e.g. "Halacha2Go". */
	chatName?: string;
	/** One-line description of the group. */
	description?: string;
	/** chat.whatsapp.com invite link for this group. */
	joinHref?: string;
}

interface Props {
	eyebrow?: string;
	titleLead?: string;
	titleAccent?: string;
	titleTrail?: string;
	body?: string;
	joinLabel?: string;
	joinHref?: string;
	membersNote?: string;
	/** All chat groups, for the left-hand list. */
	chats?: string[];
	/** Featured groups shown as vertical video tiles on the right. */
	shorts?: Short[];
}

const fallbackChats = ["Halacha2Go", "Boost2Go", "Torah Bytes", "Daily Daf", "Minyan Times", "Simcha Announcements"];

const fallbackShorts: Short[] = [
	{ chatName: "Halacha2Go", description: "Bite-size halacha for daily life." },
	{ chatName: "Boost2Go", description: "A quick dose of chizuk, on the go." },
	{ chatName: "Torah Bytes", description: "Short Torah thoughts to your phone." },
];

const {
	eyebrow = "On WhatsApp",
	titleLead = "Join our WhatsApp",
	titleAccent = "community",
	titleTrail = "",
	body = "One community, many conversations — daily learning, halacha and chizuk, all in your pocket.",
	joinLabel = "Join the community",
	joinHref = "#",
	membersNote = "",
	chats = fallbackChats,
	shorts = fallbackShorts,
} = Astro.props;

const chatList = chats && chats.length > 0 ? chats : fallbackChats;
const featured = (shorts && shorts.length > 0 ? shorts : fallbackShorts).slice(0, 4);

const posterFor = (s: Short) =>
	s.posterUrl ?? (s.videoId ? `https://i.ytimg.com/vi/${s.videoId}/hqdefault.jpg` : undefined);
---

<section class="relative isolate overflow-hidden bg-mist py-14 md:py-20">
	<div class="container-page relative">
		{/* ── Header ───────────────────────────────────────────────────── */}
		<div class="mx-auto max-w-2xl text-center">
			<div class="flex justify-center" data-reveal="up">
				<span class="flex h-12 w-12 items-center justify-center rounded-full bg-whatsapp shadow-[0_8px_24px_-8px_rgba(37,211,102,0.6)]">
					<svg viewBox="0 0 24 24" class="h-7 w-7" fill="white" aria-hidden="true">
						<path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.85-1.46A10 10 0 1 0 12 2Zm0 18.2a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-2.86.86.86-2.78-.2-.32A8.2 8.2 0 1 1 12 20.2Z"/>
						<path d="M17.5 14.4c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.14-1.14-.42-2.17-1.34-.8-.71-1.34-1.6-1.5-1.87-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.46l-.52-.01c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27 0 1.34.97 2.63 1.11 2.81.14.18 1.91 2.92 4.63 4.09.65.28 1.15.45 1.54.58.65.2 1.24.18 1.71.11.52-.08 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32Z"/>
					</svg>
				</span>
			</div>
			<h2
				class="mt-5 font-display text-4xl sm:text-5xl md:text-6xl font-medium leading-[1.05] text-navy-600"
				data-reveal="up"
				data-reveal-delay="100"
			>
				{titleLead}{titleLead && " "}<Highlight>{titleAccent}</Highlight>{titleTrail && ` ${titleTrail}`}
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-navy-500" data-reveal="up" data-reveal-delay="180">
				{body}
			</p>
		</div>

		{/* ── Chat list + video previews ───────────────────────────────── */}
		<div class="mt-12 grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-10">
			{/* LEFT — chat-group list + CTA */}
			<div class="lg:col-span-4" data-reveal="up" data-reveal-delay="120">
				<p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-navy-400">Our chat groups</p>
				<ul class="mt-4 grid grid-cols-1 gap-x-6 gap-y-2.5 sm:grid-cols-2 lg:grid-cols-1 lg:gap-y-3">
					{
						chatList.map((name) => (
							<li class="flex items-center gap-3">
								<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-whatsapp/12 text-whatsapp-dark">
									<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
										<path d="M4 4h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H9l-4 3.5A.6.6 0 0 1 4 21V5a1 1 0 0 1 0-1Z" />
									</svg>
								</span>
								<span class="font-sans text-base font-medium text-navy-700">{name}</span>
							</li>
						))
					}
				</ul>

				<div class="mt-7 flex flex-col items-start gap-3">
					<a
						href={joinHref}
						target="_blank"
						rel="noopener"
						class="group inline-flex items-center gap-2.5 rounded-full bg-whatsapp px-6 py-3 font-sans text-base font-semibold text-white shadow-[0_14px_30px_-14px_rgba(37,211,102,0.7)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-whatsapp-dark hover:shadow-[0_18px_38px_-16px_rgba(37,211,102,0.8)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-whatsapp-dark"
					>
						<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
							<path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.85-1.46A10 10 0 1 0 12 2Zm0 18.2a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-2.86.86.86-2.78-.2-.32A8.2 8.2 0 1 1 12 20.2Z"/>
							<path d="M17.5 14.4c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.14-1.14-.42-2.17-1.34-.8-.71-1.34-1.6-1.5-1.87-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.46l-.52-.01c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27 0 1.34.97 2.63 1.11 2.81.14.18 1.91 2.92 4.63 4.09.65.28 1.15.45 1.54.58.65.2 1.24.18 1.71.11.52-.08 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32Z"/>
						</svg>
						{joinLabel}
					</a>
					{membersNote && <p class="font-sans text-sm text-navy-400">{membersNote}</p>}
				</div>
			</div>

			{/* RIGHT — vertical video-preview tiles */}
			<div
				data-shorts-row
				class="lg:col-span-8 flex gap-4 sm:gap-5 overflow-x-auto snap-x snap-mandatory -mx-6 px-6 pb-4 [scrollbar-width:none] [-ms-overflow-style:none] md:mx-0 md:px-0 md:flex-wrap md:justify-center md:pb-0"
			>
				{
					featured.map((s) => {
						const poster = posterFor(s);
						return (
							<figure data-short-card class="group flex w-[12rem] shrink-0 snap-start flex-col" style="opacity:0">
								{/* 9:16 video tile */}
								<div
									data-short-frame
									class="relative aspect-[9/16] overflow-hidden rounded-xl bg-gradient-to-br from-navy-500 to-navy-700 ring-1 ring-navy-100 shadow-[0_18px_40px_-22px_rgba(16,42,86,0.5)] transition-transform duration-300 group-hover:-translate-y-1.5"
								>
									{poster ? (
										<img src={poster} alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
									) : (
										/* "coming soon" poster — intentional placeholder until a Short id is added */
										<div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center">
											<span class="font-display text-2xl font-semibold tracking-[0.08em] text-gold-300/90">RCK</span>
											<span class="font-sans text-[0.72rem] uppercase tracking-[0.22em] text-navy-100/80">Short coming soon</span>
										</div>
									)}

									{/* play affordance — only when a video exists */}
									{s.videoId && (
										<button
											type="button"
											data-short-play
											data-video-id={s.videoId}
											aria-label={`Play ${s.chatName ?? "Short"}`}
											class="absolute inset-0 flex items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-whatsapp"
										>
											<span class="flex h-14 w-14 items-center justify-center rounded-full bg-white/95 shadow-[0_10px_30px_-6px_rgba(0,0,0,0.55)] ring-2 ring-transparent transition-all duration-300 group-hover:scale-110 group-hover:ring-whatsapp">
												<svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 fill-navy-700" aria-hidden="true">
													<path d="M8 5.5v13a1 1 0 0 0 1.52.85l10.5-6.5a1 1 0 0 0 0-1.7L9.52 4.65A1 1 0 0 0 8 5.5Z" />
												</svg>
											</span>
										</button>
									)}

								</div>

								{/* caption beneath the tile */}
								<figcaption class="mt-3.5 px-0.5">
									{s.chatName && <h3 class="font-display text-lg font-medium text-navy-700">{s.chatName}</h3>}
									{s.description && <p class="mt-1 text-[0.8rem] leading-snug text-navy-500">{s.description}</p>}
									{s.joinHref && (
										<a
											href={s.joinHref}
											target="_blank"
											rel="noopener"
											class="group/link mt-2.5 inline-flex items-center gap-1.5 font-sans text-sm font-semibold text-gold-600 transition-colors hover:text-gold-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500"
										>
											Join chat
											<svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform duration-300 group-hover/link:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
												<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</a>
									)}
								</figcaption>
							</figure>
						);
					})
				}
			</div>
		</div>
	</div>

	<noscript>
		<style>[data-short-card] { opacity: 1 !important; }</style>
	</noscript>
</section>

<style>
	[data-shorts-row]::-webkit-scrollbar { display: none; }
</style>

<script>
	import { animate, inView, stagger } from "motion";

	// Click-to-play: swap the poster tile for an autoplaying privacy-mode embed.
	document.querySelectorAll<HTMLButtonElement>("[data-short-play]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const id = btn.dataset.videoId;
			const frame = btn.closest<HTMLElement>("[data-short-frame]");
			if (!id || !frame) return;
			const iframe = document.createElement("iframe");
			iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&playsinline=1&rel=0`;
			iframe.title = btn.getAttribute("aria-label") ?? "YouTube Short";
			iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
			iframe.allowFullscreen = true;
			iframe.className = "absolute inset-0 h-full w-full border-0";
			frame.replaceChildren(iframe);
		});
	});

	// Staggered entrance for the tiles.
	const cards = document.querySelectorAll<HTMLElement>("[data-short-card]");
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	if (cards.length && reduce) {
		cards.forEach((c) => (c.style.opacity = "1"));
	} else if (cards.length) {
		inView(
			"[data-shorts-row]",
			() => {
				animate(
					cards,
					{ opacity: [0, 1], y: [40, 0], scale: [0.95, 1] },
					{ duration: 0.7, delay: stagger(0.1), ease: [0.16, 1, 0.3, 1] },
				);
			},
			{ amount: 0.2 },
		);
	}
</script>
