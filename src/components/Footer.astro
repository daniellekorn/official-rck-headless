---
const socials = [
	{ label: "Facebook", href: "#", icon: "facebook" },
	{ label: "Instagram", href: "#", icon: "instagram" },
	{ label: "YouTube", href: "#", icon: "youtube" },
	{ label: "X", href: "#", icon: "x" },
	{ label: "LinkedIn", href: "#", icon: "linkedin" },
];

const year = new Date().getFullYear();
---

<footer class="bg-navy-700 text-white">
	<div class="container-page py-16 sm:py-20 text-center">
		<div class="inline-flex items-center gap-2 rounded-sm border border-white/20 px-3 py-1 text-[10px] uppercase tracking-[0.22em] text-white/70">
			Logo
		</div>

		<p class="mt-6 font-sans text-2xl md:text-[1.75rem] font-extrabold tracking-[-0.015em]">
			A Sacred Home for Growth and Shared Connection
		</p>

		<address class="mt-6 not-italic text-sm md:text-base leading-relaxed text-white/80">
			123 Torani Street,<br />
			Ra'anana, Israel
		</address>

		<p class="mt-4 text-sm md:text-base text-white/80">
			<a href="mailto:office@rckollel.org" class="hover:text-gold-300 transition-colors">
				office@rckollel.org
			</a>
			<span class="mx-2 text-white/40">|</span>
			<a href="tel:+97291234567" class="hover:text-gold-300 transition-colors">
				+972 9-123-4567
			</a>
		</p>

		<ul class="mt-8 flex justify-center gap-4">
			{
				socials.map((s) => (
					<li>
						<a
							href={s.href}
							aria-label={s.label}
							class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-gold-500"
						>
							{s.icon === "facebook" && (
								<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
									<path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.5 1.6-1.5h1.7V4.3c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.5H7.7V14h2.6v8h3.2Z" />
								</svg>
							)}
							{s.icon === "instagram" && (
								<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6">
									<rect x="3.5" y="3.5" width="17" height="17" rx="4" />
									<circle cx="12" cy="12" r="3.8" />
									<circle cx="17" cy="7" r="1" fill="currentColor" />
								</svg>
							)}
							{s.icon === "youtube" && (
								<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
									<path d="M21.6 7.2c-.2-1-1-1.7-2-2C17.8 4.8 12 4.8 12 4.8s-5.8 0-7.6.4c-1 .3-1.8 1-2 2C2 9 2 12 2 12s0 3 .4 4.8c.2 1 1 1.7 2 2 1.8.4 7.6.4 7.6.4s5.8 0 7.6-.4c1-.3 1.8-1 2-2 .4-1.8.4-4.8.4-4.8s0-3-.4-4.8ZM10 15.2V8.8L15.6 12 10 15.2Z" />
								</svg>
							)}
							{s.icon === "x" && (
								<svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
									<path d="M17.5 3h3.1l-6.8 7.8L22 21h-6.3l-4.9-6.4L5 21H1.9l7.3-8.3L1.4 3h6.5l4.4 5.9L17.5 3Zm-1.1 16.2h1.7L7.7 4.7H5.9l10.5 14.5Z" />
								</svg>
							)}
							{s.icon === "linkedin" && (
								<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
									<path d="M5.5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.7 9h3.6V21H3.7V9Zm6.4 0h3.5v1.7h.1c.5-.9 1.7-1.9 3.5-1.9 3.7 0 4.4 2.4 4.4 5.5V21H18V14.8c0-1.5 0-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21h-3.4V9Z" />
								</svg>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<div class="border-t border-white/10">
		<div class="container-page py-5 text-xs text-white/55">
			{year} RCK. All Rights Reserved.
		</div>
	</div>
</footer>
