---
import { getContactInfo } from "../lib/contact-info";
import { googleMapsUrl } from "../lib/maps";

const contact = await getContactInfo();

// Quick Links mirror the primary nav (structural, not content — same rationale
// as the nav links themselves).
const quickLinks = [
	{ label: "Home", href: "/" },
	{ label: "Meet the Team", href: "/team" },
	{ label: "Daven with Us", href: "/daven" },
	{ label: "Learn with Us", href: "/learn" },
	{ label: "Torah Sheets", href: "/torah-sheets" },
	{ label: "Community", href: "/community" },
	{ label: "Events", href: "/events" },
	{ label: "Youth", href: "/youth" },
	{ label: "WhatsApp Group", href: "/#whatsapp" },
	{ label: "Contact", href: "/contact" },
	{ label: "Donate", href: "/donate" },
];

const socials = [
	{ label: "Facebook", href: contact?.facebookUrl, icon: "facebook" },
	{ label: "Instagram", href: contact?.instagramUrl, icon: "instagram" },
	{ label: "YouTube", href: contact?.youtubeUrl, icon: "youtube" },
	{ label: "WhatsApp", href: contact?.whatsappUrl, icon: "whatsapp" },
	{ label: "X", href: contact?.twitterUrl, icon: "x" },
	{ label: "LinkedIn", href: contact?.linkedinUrl, icon: "linkedin" },
].filter((s) => s.href);

const year = new Date().getFullYear();

const hasContact = contact?.phone || contact?.email || contact?.address;
const mapSrc = contact?.address
	? `https://maps.google.com/maps?q=${encodeURIComponent(contact.address)}&output=embed&z=15`
	: null;
---

<footer class="relative bg-navy-700 text-white">
	<!-- Seam: a gold-glow hairline marks the break between the lighter navy of
	     the section above and the darker footer, so two dark zones no longer
	     bleed into one muddy block. -->
	<div aria-hidden="true" class="h-px w-full bg-gradient-to-r from-transparent via-gold-500/70 to-transparent shadow-[0_0_18px_2px_rgba(214,162,30,0.35)]"></div>

	<div class="container-page py-10 sm:py-12">
		<div class="grid gap-8 md:grid-cols-12 md:gap-10 text-center md:text-left">
			<!-- Brand: logo + tagline (title with subtitle) -->
			<div class="md:col-span-5 flex flex-col items-center md:items-start">
				<a
					href="/"
					aria-label="RCK — The Ra'anana Community Kollel — Home"
					data-footer-logo
					class="shrink-0"
				>
					<img
						src="/logo-vertical-light.png"
						alt="RCK — Ra'anana Community Kollel"
						class="h-24 sm:h-28 w-auto"
					/>
				</a>
				<p class="mt-5 max-w-sm font-sans text-sm md:text-base font-normal leading-snug tracking-[-0.015em]">
					A home for Torah, community,<br />and growth in Ra'anana, Israel.
				</p>

				{socials.length > 0 && (
					<ul class="mt-5 flex justify-center md:justify-start gap-3">
						{
							socials.map((s) => (
								<li>
									<a
										href={s.href}
										aria-label={s.label}
										class:list={[
											"flex h-9 w-9 items-center justify-center rounded-sm transition-colors",
											s.icon === "youtube"
												? "bg-[#FF0000] text-white hover:bg-[#cc0000]"
												: s.icon === "whatsapp"
												? "bg-[#25D366] text-white hover:bg-[#1da851]"
												: s.icon === "facebook"
												? "bg-[#1877F2] text-white hover:bg-[#145dbf]"
												: "bg-white/10 text-white hover:bg-gold-500",
										]}
									>
										{s.icon === "facebook" && (
											<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
												<path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.5 1.6-1.5h1.7V4.3c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1v2.5H7.7V14h2.6v8h3.2Z" />
											</svg>
										)}
										{s.icon === "instagram" && (
											<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6">
												<rect x="3.5" y="3.5" width="17" height="17" rx="4" />
												<circle cx="12" cy="12" r="3.8" />
												<circle cx="17" cy="7" r="1" fill="currentColor" />
											</svg>
										)}
										{s.icon === "youtube" && (
											<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
												<path d="M21.6 7.2c-.2-1-1-1.7-2-2C17.8 4.8 12 4.8 12 4.8s-5.8 0-7.6.4c-1 .3-1.8 1-2 2C2 9 2 12 2 12s0 3 .4 4.8c.2 1 1 1.7 2 2 1.8.4 7.6.4 7.6.4s5.8 0 7.6-.4c1-.3 1.8-1 2-2 .4-1.8.4-4.8.4-4.8s0-3-.4-4.8ZM10 15.2V8.8L15.6 12 10 15.2Z" />
											</svg>
										)}
										{s.icon === "whatsapp" && (
											<svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
												<path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.85-1.46A10 10 0 1 0 12 2Zm0 18.2a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-2.86.86.86-2.78-.2-.32A8.2 8.2 0 1 1 12 20.2Z"/>
												<path d="M17.5 14.4c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.14-1.14-.42-2.17-1.34-.8-.71-1.34-1.6-1.5-1.87-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.46l-.52-.01c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27 0 1.34.97 2.63 1.11 2.81.14.18 1.91 2.92 4.63 4.09.65.28 1.15.45 1.54.58.65.2 1.24.18 1.71.11.52-.08 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32Z"/>
											</svg>
										)}
										{s.icon === "x" && (
											<svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor">
												<path d="M17.5 3h3.1l-6.8 7.8L22 21h-6.3l-4.9-6.4L5 21H1.9l7.3-8.3L1.4 3h6.5l4.4 5.9L17.5 3Zm-1.1 16.2h1.7L7.7 4.7H5.9l10.5 14.5Z" />
											</svg>
										)}
										{s.icon === "linkedin" && (
											<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor">
												<path d="M5.5 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.7 9h3.6V21H3.7V9Zm6.4 0h3.5v1.7h.1c.5-.9 1.7-1.9 3.5-1.9 3.7 0 4.4 2.4 4.4 5.5V21H18V14.8c0-1.5 0-3.4-2.1-3.4-2.1 0-2.4 1.6-2.4 3.3V21h-3.4V9Z" />
											</svg>
										)}
									</a>
								</li>
							))
						}
					</ul>
				)}
			</div>

			<!-- Quick Links. On mobile the list is collapsed behind a tap-to-open
			     disclosure (the 9 links made the footer very tall); md+ shows the
			     plain list. Two renders of the same list — <details>' open state
			     can't be forced by CSS at a breakpoint. -->
			<nav class="md:col-span-3" aria-label="Footer">
				<details class="group md:hidden">
					<summary class="flex cursor-pointer list-none items-center justify-center gap-2 [&::-webkit-details-marker]:hidden">
						<h2 class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-gold-300">
							Quick Links
						</h2>
						<svg
							viewBox="0 0 24 24"
							class="h-3.5 w-3.5 text-gold-300 transition-transform duration-200 group-open:rotate-180"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							aria-hidden="true"
						>
							<path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</summary>
					<ul class="mt-5 space-y-1.5">
						{
							quickLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-sm text-white/75 transition-colors hover:text-gold-300"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</details>

				<div class="hidden md:block">
					<h2 class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-gold-300">
						Quick Links
					</h2>
					<ul class="mt-5 space-y-1.5">
						{
							quickLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-sm text-white/75 transition-colors hover:text-gold-300"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</nav>

			<!-- Contact: phone → email → address → small map square -->
			<div class="md:col-span-4">
				<h2 class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-gold-300">
					Get in Touch
				</h2>

				{hasContact ? (
					<div class="mt-5 flex flex-col items-center md:items-start gap-3 text-sm">
						{contact?.phone && (
							<a
								href={`tel:${contact.phone.replace(/[\s\-]/g, "")}`}
								class="flex items-center gap-2.5 text-white/80 transition-colors hover:text-gold-300"
							>
								<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.8">
									<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.9.7A2 2 0 0 1 22 16.9Z" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								{contact.phone}
							</a>
						)}

						{contact?.email && (
							<a
								href={`mailto:${contact.email}`}
								class="flex items-center gap-2.5 text-white/80 transition-colors hover:text-gold-300"
							>
								<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.8">
									<rect x="2" y="4" width="20" height="16" rx="2" />
									<path d="m2 7 10 7 10-7" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								{contact.email}
							</a>
						)}

						{contact?.address && (
							<div class="flex items-start gap-2.5">
								<svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-gold-400" fill="none" stroke="currentColor" stroke-width="1.8">
									<path d="M12 21s-8-7.3-8-12a8 8 0 1 1 16 0c0 4.7-8 12-8 12Z" stroke-linecap="round" stroke-linejoin="round" />
									<circle cx="12" cy="9" r="2.5" />
								</svg>
								<span class="text-left text-white/80">
									<a href={googleMapsUrl(contact.address)} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-gold-300">
										{contact.address}
									</a>
								</span>
							</div>
						)}

						{mapSrc && (
							<div class="mt-2 w-full overflow-hidden rounded-md ring-1 ring-white/10 shadow-lg">
								<iframe
									src={mapSrc}
									class="block h-28 w-full"
									style="border:0;"
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									title="RCK location map"
									aria-label="Map showing RCK location"
								></iframe>
							</div>
						)}
					</div>
				) : (
					<p class="mt-5 text-sm text-white/60">Contact details coming soon.</p>
				)}
			</div>
		</div>
	</div>

	<div class="border-t border-white/10">
		<div class="container-page py-4 text-xs text-white/55">
			{year} RCK. All Rights Reserved.
		</div>
	</div>
</footer>

<script>
	// Already on the homepage: scroll to top instead of a full reload.
	const logoLink = document.querySelector("[data-footer-logo]");
	logoLink?.addEventListener("click", (e) => {
		if (window.location.pathname === "/") {
			e.preventDefault();
			window.scrollTo({ top: 0, behavior: "smooth" });
		}
	});
</script>
