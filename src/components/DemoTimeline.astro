---
/**
 * DemoTimeline — three candidate restyles of the "Our History" timeline for the
 * client to choose between (see /demo). All three: bigger imagery, year + title
 * + caption overlaid on the photo at the bottom, a continuous slow marquee that
 * pauses on hover, and a blurred copy of the same photo filling any letterbox
 * gaps when the image's aspect doesn't match the card.
 *
 *  - "cinematic": tall 3:4 portrait cards, big year, editorial.
 *  - "wide":      16:9 widescreen panels, oversized year watermark.
 *  - "glass":     4:3 cards with a frosted-glass caption bar.
 */
interface Entry {
	year?: number;
	title?: string;
	caption?: string;
	imageUrl?: string;
}
interface Props {
	variant: "cinematic" | "wide" | "glass";
	entries: Entry[];
	/** Seconds the marquee takes per card — controls pan speed. */
	secondsPerCard?: number;
}

const { variant, entries, secondsPerCard = 7 } = Astro.props;

// Duplicate the list so the marquee can wrap seamlessly (translateX -50%).
const loop = [...entries, ...entries];
const dur = Math.max(entries.length, 1) * secondsPerCard;

// Cards are sized in viewport widths so that one full set of images is always
// WIDER than the screen (each card > 100vw / count). That guarantees you never
// see the same image twice at once — a given image only comes back after the
// whole set has scrolled through. Holds for ~4–5 images at any screen size.
const cardCls = {
	cinematic: "demo-card demo-card--cinematic aspect-[3/4] w-[66vw] sm:w-[42vw] lg:w-[36vw]",
	wide: "demo-card demo-card--wide aspect-[16/9] w-[88vw] sm:w-[60vw] lg:w-[48vw]",
	glass: "demo-card demo-card--glass aspect-[4/3] w-[78vw] sm:w-[50vw] lg:w-[40vw]",
}[variant];
---

<div class="demo-tl" style={`--marquee-dur:${dur}s`}>
	<div class="demo-tl__viewport">
		<div class="demo-tl__track">
			{loop.map((entry, i) => (
				<article class:list={[cardCls]} aria-hidden={i >= entries.length ? "true" : undefined}>
					{/* blurred same-image fill behind, so odd ratios look intentional */}
					{entry.imageUrl ? (
						<>
							<img src={entry.imageUrl} alt="" aria-hidden="true" class="demo-card__bg" />
							<img src={entry.imageUrl} alt={entry.title ?? ""} class="demo-card__img" loading="lazy" />
						</>
					) : (
						<div class="demo-card__placeholder" aria-hidden="true"></div>
					)}

					{/* legibility gradient */}
					<div class="demo-card__scrim" aria-hidden="true"></div>

					{variant === "glass" ? (
						<div class="demo-card__glass">
							{entry.year && <span class="demo-card__yearBadge">{entry.year}</span>}
							{entry.title && <h3 class="demo-card__title">{entry.title}</h3>}
							{entry.caption && <p class="demo-card__caption">{entry.caption}</p>}
						</div>
					) : (
						<div class="demo-card__overlay">
							{entry.year && <span class="demo-card__year">{entry.year}</span>}
							{entry.title && <h3 class="demo-card__title">{entry.title}</h3>}
							{entry.caption && <p class="demo-card__caption">{entry.caption}</p>}
						</div>
					)}
				</article>
			))}
		</div>
	</div>
</div>

<style>
	.demo-tl__viewport {
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}
	.demo-tl__track {
		display: flex;
		width: max-content;
		animation: demo-marquee var(--marquee-dur) linear infinite;
		will-change: transform;
	}
	.demo-tl:hover .demo-tl__track {
		animation-play-state: paused;
	}
	@keyframes demo-marquee {
		to {
			transform: translateX(-50%);
		}
	}

	.demo-card {
		position: relative;
		flex: 0 0 auto;
		margin-right: 1.25rem;
		overflow: hidden;
		border-radius: 0.375rem;
		background: #07173a;
		box-shadow: 0 28px 60px -34px rgba(7, 23, 58, 0.7);
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	@media (min-width: 640px) {
		.demo-card {
			margin-right: 1.5rem;
		}
	}

	.demo-card__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.15);
		filter: blur(22px) saturate(1.1) brightness(0.65);
	}
	.demo-card__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.demo-card__placeholder {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, #102a56 0%, #243c63 55%, #d6a21e 140%);
	}
	.demo-card__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(2, 8, 23, 0.92) 4%, rgba(2, 8, 23, 0.45) 34%, transparent 62%);
	}

	/* overlay (cinematic + wide) */
	.demo-card__overlay {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		padding: 1.25rem 1.35rem 1.4rem;
		color: #fff;
	}
	.demo-card__year {
		display: block;
		font-family: var(--font-display);
		font-weight: 500;
		line-height: 0.9;
		color: var(--color-gold-200, #f6d66b);
		letter-spacing: -0.01em;
	}
	.demo-card .demo-card__title {
		margin-top: 0.4rem;
		font-family: var(--font-sans);
		font-weight: 700;
		letter-spacing: -0.01em;
		font-size: 1.125rem;
		color: #fff;
	}
	.demo-card__caption {
		margin-top: 0.3rem;
		font-size: 0.85rem;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.78);
		max-width: 36ch;
	}

	/* cinematic: big year */
	.demo-card--cinematic .demo-card__year {
		font-size: 2.4rem;
	}
	/* wide: oversized watermark year, larger type */
	.demo-card--wide .demo-card__overlay {
		padding: 1.5rem 1.8rem 1.7rem;
	}
	.demo-card--wide .demo-card__year {
		font-size: 3.4rem;
	}
	.demo-card--wide .demo-card__title {
		font-size: 1.4rem;
	}
	.demo-card--wide .demo-card__caption {
		font-size: 0.95rem;
		max-width: 52ch;
	}

	/* glass variant: frosted caption bar */
	.demo-card__glass {
		position: absolute;
		inset-inline: 0.7rem;
		bottom: 0.7rem;
		padding: 0.9rem 1rem 1rem;
		border-radius: 0.375rem;
		background: rgba(7, 23, 58, 0.42);
		backdrop-filter: blur(10px) saturate(1.2);
		-webkit-backdrop-filter: blur(10px) saturate(1.2);
		border: 1px solid rgba(255, 255, 255, 0.16);
		color: #fff;
	}
	.demo-card__yearBadge {
		display: inline-block;
		font-family: var(--font-sans);
		font-weight: 800;
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		color: #07173a;
		background: var(--color-gold-300, #ebbf42);
		padding: 0.18rem 0.5rem;
		border-radius: 0.25rem;
	}
	.demo-card__glass .demo-card__title {
		margin-top: 0.55rem;
		font-size: 1.15rem;
	}
	/* Reserve a uniform two-line caption so every frosted bar is the same height,
	   regardless of how long each caption is. */
	.demo-card__glass .demo-card__caption {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 2.9em;
	}

	@media (prefers-reduced-motion: reduce) {
		.demo-tl__viewport {
			overflow-x: auto;
		}
		.demo-tl__track {
			animation: none;
		}
	}
</style>
