---
/**
 * SectionPager — a fixed vertical dot rail (right edge, desktop only) that
 * tracks which page section is in view and lets visitors jump between them.
 * Cue: dallastorah.org's section pager.
 *
 * Each target section must carry `id`, `data-pager-section`, and
 * `data-pager-theme="dark|light"` (so the dots recolor to stay legible over
 * that section's background). Pass the same ids + labels here, in order.
 *
 * Active dot = a tall gold capsule; inactive = a small neutral dot that adapts
 * to the active section's theme. Decorative-but-navigable: real anchor links,
 * keyboard focusable, hidden from layout on touch/small screens.
 */
interface SectionItem {
	id: string;
	label: string;
}
interface Props {
	sections: SectionItem[];
}
const { sections } = Astro.props;
---

<nav
	data-section-pager
	data-theme="dark"
	aria-label="Page sections"
	class="fixed right-4 top-1/2 z-40 hidden -translate-y-1/2 flex-col items-center gap-3.5 lg:flex"
>
	{
		sections.map((s) => (
			<a
				href={`#${s.id}`}
				data-pager-dot
				data-target={s.id}
				aria-label={s.label}
				class="group relative flex h-5 w-5 items-center justify-center"
			>
				<span class="pager-pill" />
				<span class="pager-label">{s.label}</span>
			</a>
		))
	}
</nav>

<style>
	[data-section-pager] {
		/* dot color adapts to the active section's theme (set by JS) */
		--dot: #ffffff;
	}
	[data-section-pager][data-theme="light"] {
		--dot: #243c63;
	}

	.pager-pill {
		display: block;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 9999px;
		background: var(--dot);
		opacity: 0.4;
		transition:
			height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
			width 0.3s ease,
			opacity 0.3s ease,
			background-color 0.3s ease;
	}
	[data-pager-dot]:hover .pager-pill,
	[data-pager-dot]:focus-visible .pager-pill {
		opacity: 0.9;
	}
	[data-pager-dot][aria-current="true"] .pager-pill {
		height: 1.5rem;
		width: 0.4rem;
		opacity: 1;
		background: #d6a21e; /* gold-500 — reads on both light and dark */
	}

	/* hover label flag to the left of the rail */
	.pager-label {
		position: absolute;
		right: calc(100% + 0.6rem);
		top: 50%;
		transform: translateY(-50%) translateX(0.25rem);
		white-space: nowrap;
		border-radius: 9999px;
		background: #07173a;
		color: #fff;
		padding: 0.25rem 0.7rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.6);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}
	[data-pager-dot]:hover .pager-label,
	[data-pager-dot]:focus-visible .pager-label {
		opacity: 1;
		transform: translateY(-50%) translateX(0);
	}

	:focus-visible {
		outline: 2px solid #d6a21e;
		outline-offset: 3px;
		border-radius: 9999px;
	}
</style>

<script>
	const pager = document.querySelector<HTMLElement>("[data-section-pager]");
	if (pager) {
		const dots = Array.from(pager.querySelectorAll<HTMLAnchorElement>("[data-pager-dot]"));
		const sections = Array.from(
			document.querySelectorAll<HTMLElement>("[data-pager-section]"),
		);

		const setActive = (id: string) => {
			dots.forEach((d) =>
				d.setAttribute("aria-current", String(d.dataset.target === id)),
			);
			const section = document.getElementById(id);
			const theme = section?.dataset.pagerTheme === "light" ? "light" : "dark";
			pager.dataset.theme = theme;
		};

		// A section is "active" while it crosses a thin band through the
		// viewport's vertical middle — the standard scroll-spy technique.
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting && entry.target.id) {
						setActive(entry.target.id);
					}
				});
			},
			{ rootMargin: "-45% 0px -45% 0px", threshold: 0 },
		);
		sections.forEach((s) => observer.observe(s));

		// Smooth-scroll on click, honoring reduced-motion.
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
		dots.forEach((dot) => {
			dot.addEventListener("click", (e) => {
				const id = dot.dataset.target;
				const target = id ? document.getElementById(id) : null;
				if (!target) return;
				e.preventDefault();
				target.scrollIntoView({
					behavior: reduce.matches ? "auto" : "smooth",
					block: "start",
				});
			});
		});

		// Seed initial active state from whatever is on screen at load.
		if (sections.length) setActive(sections[0].id);
	}
</script>
