---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import { getCommunityPage, getCommunityMembers } from "../lib/community";
import { ricosToPlainText } from "../lib/ricos";
import { googleMapsUrl } from "../lib/maps";

const page = await getCommunityPage();
const members = await getCommunityMembers();
const hasMembers = members.length > 0;

const mealsDescription = page?.mealsDescription ? ricosToPlainText(page.mealsDescription) : "";

// Contact page link with a prefilled, locked subject line (contact.astro reads
// ?subject= and shows it read-only) — used for the inline name links below.
const contactHref = (subject: string) => `/contact?subject=${encodeURIComponent(subject)}`;

const BEIS_DIN_SERVICES = [
	"Monetary Disputes",
	"Arbitration & Mediation",
	"Halachic Wills",
	"Shalom Bayis",
	"Halachic Contracts",
];

// Meals hosting contact — shown while the CMS `mealsFamilyName` field (a
// single-family setup, see below) is unpopulated. Number is Israeli mobile,
// entered in local format; helpers below derive the `tel:` and WhatsApp
// (`wa.me`, country code 972) links from that same number.
const MEALS_CONTACT = { name: "Yael Bernstein", phone: "053-216-4726" };
const telHref = (phone: string) => `tel:${phone.replace(/[\s-]/g, "")}`;
const whatsappHref = (phone: string) => `https://wa.me/972${phone.replace(/[\s-]/g, "").replace(/^0/, "")}`;

// Aliya FAQ contact — same hardcoded-fallback pattern as MEALS_CONTACT above
// (no CMS field for this yet; promote to CommunityPage if it ever needs to
// be office-editable without a code change).
const ALIYA_CONTACT = { name: "Rabbi Isaac Bernstein", phone: "053-216-4727" };

// Second meals contact, offered alongside MEALS_CONTACT — same hardcoded
// pattern, shown right under Yael Bernstein's line.
const MEALS_CONTACT_2 = { name: "Rabbi Yisroel Zaslow", phone: "053-347-8419" };

// Every rabbi named on this page links to his bio on /team, which has two
// sections (`#leadership` / `#avreichim`, see src/lib/team.ts ROLE_GROUPS) —
// there's no per-person anchor, so the link scrolls to that rabbi's section.
// Hardcoded here to whichever section each named rabbi's TeamMembers row is
// actually in; keep in sync if a role changes.
const TEAM_ANCHOR = {
	leadership: "/team#leadership",
	avreichim: "/team#avreichim",
};
const rabbiLinkClass = "font-semibold text-gold-600 transition-colors hover:text-gold-500";

// Accordion chrome shared by all five FAQ topics — native <details>/<summary>
// so each opens/closes independently with zero JS and keyboard support for
// free (see design log #047 for why this beats a custom aria-expanded toggle
// here, unlike the team page's hover+pin card).
const detailsClass = "group border-b border-navy-100 last:border-b-0 scroll-mt-28";
const summaryClass =
	"flex cursor-pointer list-none items-center justify-between gap-4 py-6 text-left [&::-webkit-details-marker]:hidden";
const questionClass = "font-display text-xl sm:text-2xl font-medium text-navy-600 pr-4";
const chevronClass = "h-5 w-5 shrink-0 text-gold-500 transition-transform duration-300 group-open:rotate-180";
const panelClass = "pb-8 pt-1 text-navy-500 leading-relaxed";
---

<Layout>
	<Nav />
	<main>
		<PageHeader titleNavy="Welcome to Our Community" />

		<!-- FAQ topics -->
		<section class="bg-white py-4 sm:py-6">
			<div class="container-page">
				<div class="mx-auto max-w-3xl">

					<!-- 1. Meals -->
					<details id="meals" class={detailsClass}>
						<summary class={summaryClass}>
							<span class={questionClass}>New to the community? Let us set you up with meals</span>
							<svg viewBox="0 0 24 24" class={chevronClass} fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
								<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class={panelClass}>
							{page?.mealsFamilyName ? (
								<div class="flex flex-col gap-6 sm:flex-row sm:items-start">
									{page.mealsPhotoUrl && (
										<img
											src={page.mealsPhotoUrl}
											alt={page.mealsFamilyName}
											loading="lazy"
											class="h-40 w-40 shrink-0 rounded-md object-cover ring-1 ring-navy-100"
										/>
									)}
									<div class="min-w-0">
										<p class="font-medium text-gold-600">{page.mealsFamilyName}</p>
										<div class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1 text-sm">
											{page.mealsPhone && (
												<a href={`tel:${page.mealsPhone.replace(/[\s\-]/g, "")}`} class="font-medium text-gold-600 hover:text-gold-500">
													{page.mealsPhone}
												</a>
											)}
											{page.mealsEmail && (
												<a href={`mailto:${page.mealsEmail}`} class="font-medium text-gold-600 hover:text-gold-500 break-all">
													{page.mealsEmail}
												</a>
											)}
										</div>
										{mealsDescription && <p class="mt-3 whitespace-pre-line">{mealsDescription}</p>}
									</div>
								</div>
							) : (
								<div>
									<p>We&rsquo;d love to set you up with local families for Shabbos and Yom Tov meals!</p>
									<div class="mt-3 flex flex-wrap items-center gap-2">
										<span>
											Reach out to <span class="font-medium text-gold-600">{MEALS_CONTACT.name}</span>
										</span>
										<div class="flex items-center gap-2">
											<a
												href={telHref(MEALS_CONTACT.phone)}
												aria-label={`Call ${MEALS_CONTACT.name}`}
												class="group inline-flex items-center gap-1.5 rounded-sm border border-gold-500 px-3 py-1.5 text-sm font-semibold text-navy-600 transition-colors hover:bg-gold-100 active:bg-gold-100"
											>
												<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
													<path d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" />
												</svg>
												Call
											</a>
											<a
												href={whatsappHref(MEALS_CONTACT.phone)}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`WhatsApp ${MEALS_CONTACT.name}`}
												class="group inline-flex items-center gap-1.5 rounded-sm border border-gold-500 px-3 py-1.5 text-sm font-semibold text-navy-600 transition-colors hover:bg-gold-100 active:bg-gold-100"
											>
												<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
													<path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.85-1.46A10 10 0 1 0 12 2Zm0 18.2a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-2.86.86.86-2.78-.2-.32A8.2 8.2 0 1 1 12 20.2Z"/>
													<path d="M17.5 14.4c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.14-1.14-.42-2.17-1.34-.8-.71-1.34-1.6-1.5-1.87-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.46l-.52-.01c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27 0 1.34.97 2.63 1.11 2.81.14.18 1.91 2.92 4.63 4.09.65.28 1.15.45 1.54.58.65.2 1.24.18 1.71.11.52-.08 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32Z"/>
												</svg>
												WhatsApp
											</a>
										</div>
									</div>
									<div class="mt-3 flex flex-wrap items-center gap-2">
										<span>
											Or <a href={TEAM_ANCHOR.avreichim} class={rabbiLinkClass}>{MEALS_CONTACT_2.name}</a>
										</span>
										<div class="flex items-center gap-2">
											<a
												href={telHref(MEALS_CONTACT_2.phone)}
												aria-label={`Call ${MEALS_CONTACT_2.name}`}
												class="group inline-flex items-center gap-1.5 rounded-sm border border-gold-500 px-3 py-1.5 text-sm font-semibold text-navy-600 transition-colors hover:bg-gold-100 active:bg-gold-100"
											>
												<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
													<path d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" />
												</svg>
												Call
											</a>
											<a
												href={whatsappHref(MEALS_CONTACT_2.phone)}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`WhatsApp ${MEALS_CONTACT_2.name}`}
												class="group inline-flex items-center gap-1.5 rounded-sm border border-gold-500 px-3 py-1.5 text-sm font-semibold text-navy-600 transition-colors hover:bg-gold-100 active:bg-gold-100"
											>
												<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
													<path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.85-1.46A10 10 0 1 0 12 2Zm0 18.2a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-2.86.86.86-2.78-.2-.32A8.2 8.2 0 1 1 12 20.2Z"/>
													<path d="M17.5 14.4c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.14-1.14-.42-2.17-1.34-.8-.71-1.34-1.6-1.5-1.87-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.46l-.52-.01c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27 0 1.34.97 2.63 1.11 2.81.14.18 1.91 2.92 4.63 4.09.65.28 1.15.45 1.54.58.65.2 1.24.18 1.71.11.52-.08 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32Z"/>
												</svg>
												WhatsApp
											</a>
										</div>
									</div>
								</div>
							)}
						</div>
					</details>

					<!-- 2. Aliya -->
					<details id="aliya" class={detailsClass}>
						<summary class={summaryClass}>
							<span class={questionClass}>Just made Aliya? Questions?</span>
							<svg viewBox="0 0 24 24" class={chevronClass} fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
								<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class={panelClass}>
							<p>Welcome to Eretz Yisroel and kol hakavod on making the move!</p>
							<p class="mt-3">
								Many members of our team have gone through the process of aliya themselves and are
								more than happy to be of assistance. We would love to help!
							</p>
							<p class="mt-3">
								Contact <a href={TEAM_ANCHOR.avreichim} class={rabbiLinkClass}>{ALIYA_CONTACT.name}</a> with any questions.
							</p>
							<div class="mt-3 flex items-center gap-2">
								<a
									href={telHref(ALIYA_CONTACT.phone)}
									aria-label={`Call ${ALIYA_CONTACT.name}`}
									class="group inline-flex items-center gap-1.5 rounded-sm border border-gold-500 px-3 py-1.5 text-sm font-semibold text-navy-600 transition-colors hover:bg-gold-100 active:bg-gold-100"
								>
									<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
										<path d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" />
									</svg>
									Call
								</a>
								<a
									href={whatsappHref(ALIYA_CONTACT.phone)}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`WhatsApp ${ALIYA_CONTACT.name}`}
									class="group inline-flex items-center gap-1.5 rounded-sm border border-gold-500 px-3 py-1.5 text-sm font-semibold text-navy-600 transition-colors hover:bg-gold-100 active:bg-gold-100"
								>
									<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:scale-110" fill="currentColor" aria-hidden="true">
										<path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.85-1.46A10 10 0 1 0 12 2Zm0 18.2a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-2.86.86.86-2.78-.2-.32A8.2 8.2 0 1 1 12 20.2Z"/>
										<path d="M17.5 14.4c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07-.27-.14-1.14-.42-2.17-1.34-.8-.71-1.34-1.6-1.5-1.87-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.46l-.52-.01c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.27 0 1.34.97 2.63 1.11 2.81.14.18 1.91 2.92 4.63 4.09.65.28 1.15.45 1.54.58.65.2 1.24.18 1.71.11.52-.08 1.6-.65 1.83-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.32Z"/>
									</svg>
									WhatsApp
								</a>
							</div>
							<p class="mt-4">B&rsquo;Hatzlacha and a Yishuv Tov!</p>
						</div>
					</details>

					<!-- 3. Gabbai -->
					<details id="gabbai" class={detailsClass}>
						<summary class={summaryClass}>
							<span class={questionClass}>Yahrtzeit? Special simcha? Contact our gabbai.</span>
							<svg viewBox="0 0 24 24" class={chevronClass} fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
								<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class={panelClass}>
							<div class="flex flex-col gap-6 sm:flex-row sm:items-start">
								{page?.gabbaiPhotoUrl && (
									<img
										src={page.gabbaiPhotoUrl}
										alt={page.gabbaiName ?? "Gabbai"}
										loading="lazy"
										class="h-40 w-40 shrink-0 rounded-md object-cover ring-1 ring-navy-100"
									/>
								)}
								<div class="min-w-0">
									{page?.gabbaiName ? (
										<p>
											For Shabbos, contact our gabbai,{" "}
											<a href={contactHref("Re: Gabbi")} class="font-semibold text-gold-600 hover:text-gold-500">
												{page.gabbaiName}
											</a>
											, regarding yahrtzeits, special simchas, and other gabbai matters.
											{page.gabbaiWifeName && (
												<>
													{" "}His wife,{" "}
													<a href={contactHref("Re: Tefillat Yeladim")} class="font-semibold text-gold-600 hover:text-gold-500">
														{page.gabbaiWifeName}
													</a>
													, also leads our popular and exciting Tefillat Yeladim!
												</>
											)}
										</p>
									) : (
										<p>Gabbai contact info is coming soon — check back shortly, or reach out via our <a href="/contact" class="font-medium text-gold-600 hover:text-gold-500">contact page</a>.</p>
									)}
									<div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
										{page?.gabbaiPhone && (
											<a href={`tel:${page.gabbaiPhone.replace(/[\s\-]/g, "")}`} class="font-medium text-gold-600 hover:text-gold-500">
												{page.gabbaiPhone}
											</a>
										)}
										{page?.gabbaiEmail && (
											<a href={`mailto:${page.gabbaiEmail}`} class="font-medium text-gold-600 hover:text-gold-500 break-all">
												{page.gabbaiEmail}
											</a>
										)}
									</div>
									<a
										href="/daven#shabbos"
										class="mt-4 inline-flex items-center gap-1.5 font-sans text-sm font-bold uppercase tracking-[0.14em] text-gold-600 hover:text-gold-500"
									>
										View Shabbos Times
										<svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
											<path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</a>
								</div>
							</div>
						</div>
					</details>

					<!-- 4. Taharas HaMishpacha -->
					<details id="taharas" class={detailsClass}>
						<summary class={summaryClass}>
							<span class={questionClass}>Taharas HaMishpacha</span>
							<svg viewBox="0 0 24 24" class={chevronClass} fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
								<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<div class={panelClass}>
							<p class="font-sans text-sm font-bold uppercase tracking-[0.18em] text-navy-400">
								Need to ask or drop off a shaalah? Contact our rabbonim:
							</p>
							<div class="mt-5 grid gap-8 sm:grid-cols-2">
								<div>
									<p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-gold-500">English</p>
									{page?.taharasEnglishRabbiName && (
										<a href={TEAM_ANCHOR.leadership} class="mt-1.5 inline-block text-lg font-medium text-navy-600 hover:text-gold-600">
											{page.taharasEnglishRabbiName}
										</a>
									)}
									{page?.taharasEnglishRabbiPhone && (
										<a href={`tel:${page.taharasEnglishRabbiPhone.replace(/[\s\-]/g, "")}`} class="mt-1 inline-block text-sm font-medium text-gold-600 hover:text-gold-500">
											{page.taharasEnglishRabbiPhone}
										</a>
									)}
									{page?.taharasEnglishRabbiAddress && (
										<address class="mt-1 flex items-start gap-1.5 not-italic text-sm text-navy-400">
											<svg viewBox="0 0 24 24" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
												<path d="M12 21s-8-7.3-8-12a8 8 0 1 1 16 0c0 4.7-8 12-8 12Z" stroke-linecap="round" stroke-linejoin="round" />
												<circle cx="12" cy="9" r="2" />
											</svg>
											<span class="flex flex-wrap items-baseline gap-x-2">
												<a href={googleMapsUrl(page.taharasEnglishRabbiAddress)} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 hover:underline">
													{page.taharasEnglishRabbiAddress}
												</a>
											</span>
										</address>
									)}
									{page?.taharasEnglishRabbi2Name && (
										<div class="mt-5 border-t border-navy-100 pt-5">
											{page.taharasEnglishRabbi2Name && (
												<a href={TEAM_ANCHOR.avreichim} class="inline-block text-lg font-medium text-navy-600 hover:text-gold-600">
													{page.taharasEnglishRabbi2Name}
												</a>
											)}
											{page?.taharasEnglishRabbi2Phone && (
												<a href={`tel:${page.taharasEnglishRabbi2Phone.replace(/[\s\-]/g, "")}`} class="mt-1 inline-block text-sm font-medium text-gold-600 hover:text-gold-500">
													{page.taharasEnglishRabbi2Phone}
												</a>
											)}
											{page?.taharasEnglishRabbi2Address && (
												<address class="mt-1 flex items-start gap-1.5 not-italic text-sm text-navy-400">
													<svg viewBox="0 0 24 24" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-gold-500" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
														<path d="M12 21s-8-7.3-8-12a8 8 0 1 1 16 0c0 4.7-8 12-8 12Z" stroke-linecap="round" stroke-linejoin="round" />
														<circle cx="12" cy="9" r="2" />
													</svg>
													<span class="flex flex-wrap items-baseline gap-x-2">
														<a href={googleMapsUrl(page.taharasEnglishRabbi2Address)} target="_blank" rel="noopener noreferrer" class="hover:text-gold-600 hover:underline">
															{page.taharasEnglishRabbi2Address}
														</a>
													</span>
												</address>
											)}
										</div>
									)}
								</div>
								<div>
									<p class="font-sans text-xs font-bold uppercase tracking-[0.2em] text-gold-500">Hebrew</p>
									{page?.taharasHebrewRabbiName && (
