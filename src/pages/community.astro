<style>
	/* Same hover/tap-reveal mechanics as the team page's card (see design log
	   #007/#008), just relabeled "Read about us!" for this context. Kept as a
	   local copy rather than a shared component since the two cards diverge in
	   surrounding markup (role/eyebrow line here vs. there). */
	/* Member Spotlight is a native horizontal-scroll carousel, not a custom
	   swipe handler — overflow-x + scroll-snap already gives trackpad/mouse-wheel
	   scrolling and touch swipe for free. The arrow buttons below just nudge
	   scrollLeft by one card; the scrollbar itself is hidden for a cleaner look
	   since it's not the primary way anyone will actually scroll it. */
	.members-track {
		scrollbar-width: none;
	}
	.members-track::-webkit-scrollbar {
		display: none;
	}

	.card-image {
		transition: filter 400ms ease;
	}
	.bio-overlay {
		opacity: 0;
		pointer-events: none;
		transition: opacity 300ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.community-card:hover .card-image {
			filter: grayscale(1);
		}
		.community-card:hover .bio-overlay {
			opacity: 1;
			pointer-events: auto;
		}
	}

	.community-card[aria-expanded="true"] .card-image {
		filter: grayscale(1);
	}
	.community-card[aria-expanded="true"] .bio-overlay {
		opacity: 1;
		pointer-events: auto;
	}

	.bio-toggle-label {
		display: none;
	}
	.bio-toggle-label::after {
		content: "Read about us!";
	}
	.community-card[aria-expanded="true"] .bio-toggle-label::after {
		content: "Hide";
	}
	@media (hover: none), (pointer: coarse) {
		.bio-toggle-label {
			display: inline-flex;
		}
	}

	.bio-scroll {
		scrollbar-width: thin;
		scrollbar-color: rgba(255, 255, 255, 0.35) transparent;
	}
	.bio-scroll::-webkit-scrollbar {
		width: 6px;
	}
	.bio-scroll::-webkit-scrollbar-thumb {
		background-color: rgba(255, 255, 255, 0.35);
		border-radius: 3px;
	}
</style>

<script>
	// Member Spotlight carousel: infinite loop. Clone the full card set (video
	// tile + family cards) once before and once after the real cards, so
	// there's always more (visually identical) content to scroll into in
	// either direction. Once scroll drifts a full "real set" width past
	// either edge, jump back by that width with no animation — since the
	// clone is pixel-identical to the real card at that position, the jump
	// is invisible. This runs before the community-card/video-spotlight
	// listener setup below so their querySelectorAll calls pick up the
	// clones too and wire them up identically to the originals. Skipped for
	// 4 or fewer cards (video tile included) — same reasoning as the events
	// page's flyer carousel: a short row doesn't need to loop.
	const LOOP_MIN = 4;
	document.querySelectorAll<HTMLElement>("[data-members-carousel]").forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>("[data-members-track]");
		if (!track) return;

		const originals = Array.from(track.children) as HTMLElement[];
		if (originals.length <= LOOP_MIN) return;

		const cloneSet = () =>
			originals.map((el) => {
				const clone = el.cloneNode(true) as HTMLElement;
				clone.setAttribute("aria-hidden", "true");
				clone.setAttribute("inert", "");
				return clone;
			});
		track.prepend(...cloneSet());
		track.append(...cloneSet());

		const firstReal = originals[0];
		const firstAfterClone = track.children[track.children.length - originals.length] as HTMLElement;
		const realWidth = firstAfterClone.getBoundingClientRect().left - firstReal.getBoundingClientRect().left;
		const startOffset = firstReal.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;

		// The track has `scroll-smooth` (scroll-behavior: smooth) for the arrow
		// buttons' scrollBy(). A plain `track.scrollLeft = x` assignment inherits
		// that same smooth behavior per the CSSOM View spec, so the initial jump
		// to the real cards must use scrollTo({ behavior: "instant" }) to
		// override it.
		track.scrollTo({ left: startOffset, behavior: "instant" });

		// Only re-anchor once scrolling has fully settled — never mid-gesture.
		// Correcting while the track is still moving fights whatever's driving
		// it (native scroll/swipe momentum, or the arrow buttons' own smooth
		// scrollBy), which cancels/undoes that motion and shows up as stutter or
		// arrow clicks that seem to do nothing.
		//
		// Debounced on `scroll` rather than keyed off `scrollend`: after a wheel/
		// trackpad gesture ends, CSS scroll-snap still animates the track the
		// rest of the way to the nearest snap point, and that settle animation
		// keeps firing `scroll` events of its own — but in some browsers
		// `scrollend` fires before that settle finishes, so checking there reads
		// a not-yet-final position (needing a second scroll to catch up — the
		// "extra push"). A debounce that resets on every `scroll` tick instead
		// waits out that settle regardless of `scrollend` timing.
		//
		// EDGE_SLACK: startOffset/realWidth come from getBoundingClientRect
		// (sub-pixel floats), but the settled position is the browser's own
		// rounded pixel value — which can land a fraction of a px short of the
		// exact threshold. Without slack, that first crossing silently fails.
		const EDGE_SLACK = 4;
		const SETTLE_DELAY = 120;
		let settleTimer: ReturnType<typeof setTimeout> | undefined;
		track.addEventListener("scroll", () => {
			clearTimeout(settleTimer);
			settleTimer = setTimeout(() => {
				if (track.scrollLeft >= startOffset + realWidth - EDGE_SLACK) {
					track.scrollTo({ left: track.scrollLeft - realWidth, behavior: "instant" });
				} else if (track.scrollLeft <= startOffset - EDGE_SLACK) {
					track.scrollTo({ left: track.scrollLeft + realWidth, behavior: "instant" });
				}
			}, SETTLE_DELAY);
		}, { passive: true });
	});

	// Identical toggle logic to team.astro's card (see design log #007) —
	// hover reveals on desktop, tap-to-pin on touch, scroll resets when hidden.
	document.querySelectorAll<HTMLButtonElement>("[data-community-card]").forEach((card) => {
		const scrollEl = card.querySelector<HTMLElement>(".bio-scroll");
		let hovering = false;

		const resetScrollIfHidden = () => {
			const expanded = card.getAttribute("aria-expanded") === "true";
			if (!hovering && !expanded && scrollEl) scrollEl.scrollTop = 0;
		};

		card.addEventListener("mouseenter", () => { hovering = true; });
		card.addEventListener("mouseleave", () => {
			hovering = false;
			resetScrollIfHidden();
		});

		card.addEventListener("click", () => {
			const expanded = card.getAttribute("aria-expanded") === "true";
			card.setAttribute("aria-expanded", expanded ? "false" : "true");
			resetScrollIfHidden();
		});
	});

	// Video spotlight tile: the play button swaps the thumbnail for an inline
	// autoplaying embed in place, rather than jumping to YouTube or opening the
	// lightbox. The separate corner button (data-lightbox-open, wired by
	// Lightbox.astro's own delegated listener) still opens the same video
	// full-size for anyone who wants that instead.
	document.querySelectorAll<HTMLElement>("[data-video-spotlight]").forEach((tile) => {
		const playBtn = tile.querySelector<HTMLButtonElement>("[data-video-spotlight-play]");
		const thumb = tile.querySelector<HTMLImageElement>("[data-video-spotlight-thumb]");
		const scrim = tile.querySelector<HTMLElement>("[data-video-spotlight-scrim]");
		const videoId = tile.dataset.videoId;
		if (!playBtn || !thumb || !scrim || !videoId) return;

		playBtn.addEventListener("click", () => {
			const iframe = document.createElement("iframe");
			iframe.className = "absolute inset-0 h-full w-full";
			iframe.style.border = "0";
			iframe.title = "RCK Community Voices – What the RCK Means to Us";
			iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share";
			iframe.allowFullscreen = true;
			iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0`;
			thumb.replaceWith(iframe);
			scrim.remove();
			playBtn.remove();
		}, { once: true });
	});

	// Member Spotlight carousel: arrow buttons nudge native scroll by one card's
	// width. Trackpad/mouse-wheel scrolling and touch swipe already work with no
	// JS at all (plain overflow-x + scroll-snap) — this just adds a click target
	// for people who'd rather press a button than scroll/swipe. Arrows are never
	// disabled: with more than LOOP_MIN cards the carousel above loops
	// infinitely in both directions; at or below that count there's nothing to
	// loop, so an arrow at either end just stops scrolling, same as any plain
	// scroll container.
	document.querySelectorAll<HTMLElement>("[data-members-carousel]").forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>("[data-members-track]");
		const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-members-prev]");
		const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-members-next]");
		if (!track) return;

		const scrollByCard = (dir: 1 | -1) => {
			const card = track.firstElementChild as HTMLElement | null;
			const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
			const delta = card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
			track.scrollBy({ left: dir * delta, behavior: "smooth" });
		};

		prevBtn?.addEventListener("click", () => scrollByCard(-1));
		nextBtn?.addEventListener("click", () => scrollByCard(1));
	});
</script>
