---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import CoverflowCarousel from "../components/CoverflowCarousel.astro";
import Highlight from "../components/Highlight.astro";
import Flyer from "../components/Flyer.astro";
import { getFlyers, uniqueSubCategories } from "../lib/flyers";
import { groupTags } from "../lib/tag-groups";

const allLearning = await getFlyers("learning");
const tagGroups = groupTags(uniqueSubCategories(allLearning));
---

<Layout>
	<Nav />

	<PageHeader
		titleGold="Learn"
		titleNavy="With Us"
	/>

	{allLearning.length > 0 && (
		<CoverflowCarousel items={allLearning}>
			<Fragment slot="aside">
				<h2
					class="text-center lg:text-left font-display text-[2rem] sm:text-[2.5rem] leading-[1.05] font-medium uppercase text-navy-600"
					data-reveal="left"
				>
					<Highlight>Learning for Everyone</Highlight>
				</h2>
				<p class="mt-5 text-center lg:text-left text-base leading-relaxed text-navy-500" data-reveal="up" data-reveal-delay="180">
					We offer shiurim, chaburos, and chavrusos for all levels of learning, in English,
					Hebrew, and even Spanish! Take a look at our community learning schedule to see
					everything available, then filter through the flyers to find the learning
					opportunity that's right for you. Didn't find it?{" "}
					<a href="/contact" class="font-medium text-gold-600 hover:text-gold-500">Contact us</a>
					{" "}— we'd love to help you get set up.
				</p>
			</Fragment>
		</CoverflowCarousel>
	)}

	<section class="py-10 sm:py-14 bg-mist">
		<div class="container-page">
			{tagGroups.length > 0 && (
				<div class="relative z-20 mb-10 flex flex-wrap items-center gap-2 sm:gap-2.5" data-filter-bar>
					<p class="mr-1 w-full sm:w-auto text-[11px] font-semibold uppercase tracking-[0.14em] text-navy-400">
						Filter shiurim
					</p>
					{tagGroups.map((group) => (
						<div class="relative" data-dropdown>
							<button
								type="button"
								data-dropdown-toggle
								aria-expanded="false"
								aria-haspopup="true"
								class="filter-select inline-flex items-center gap-2 rounded-sm px-3.5 py-2 text-sm font-medium text-navy-600 transition-colors"
							>
								{group.label}
								<span class="filter-count" data-count>0</span>
								<svg
									class="filter-caret h-3 w-3 transition-transform"
									viewBox="0 0 12 12"
									fill="none"
									aria-hidden="true"
								>
									<path
										d="M2.5 4.5 6 8l3.5-3.5"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</button>
							<div
								data-dropdown-menu
								class="absolute left-0 top-full z-30 mt-2 hidden max-h-72 min-w-44 overflow-y-auto rounded-md bg-white p-1.5 ring-1 ring-navy-100 shadow-[0_18px_40px_-18px_rgba(7,23,58,0.35)]"
							>
								{group.tags.map((tag) => (
									<button
										type="button"
										data-filter={tag}
										class="filter-option flex w-full items-center gap-2.5 rounded-sm px-2.5 py-1.5 text-left text-sm font-medium capitalize text-navy-600 transition-colors"
									>
										<span class="filter-option-box" aria-hidden="true">
											<svg viewBox="0 0 10 10" fill="none">
												<path
													d="M1.5 5.5 4 8l4.5-6"
													stroke="currentColor"
													stroke-width="1.8"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</span>
										{tag}
									</button>
								))}
							</div>
						</div>
					))}
					<button
						type="button"
						data-clear
						class="hidden text-xs font-medium text-navy-400 underline underline-offset-2 transition-colors hover:text-navy-600"
					>
						Clear all
					</button>
				</div>
			)}

			{allLearning.length > 0 ? (
				<div class="grid gap-6 sm:gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" data-flyer-grid>
					{allLearning.map((flyer) => (
						<div
							data-flyer
							data-sub={(flyer.subCategory ?? []).join("|")}
							data-always-match={flyer.title === "Community Schedule" ? "true" : undefined}
							class="rounded-md overflow-hidden bg-white ring-1 ring-navy-100 shadow-sm"
						>
							<Flyer
								imageUrl={flyer.imageUrl}
								pdfUrl={flyer.pdfUrl}
								title={flyer.title}
							/>
							{flyer.title && (
								<div class="p-4">
									<p class="font-medium text-navy-700 text-sm">{flyer.title}</p>
								</div>
							)}
						</div>
					))}
				</div>
			) : (
				<p class="text-center text-navy-400 py-16">
					Learning materials coming soon.
				</p>
			)}
		</div>
	</section>

	<Footer />
</Layout>

<style>
	/* Dropdown trigger: white pill, gold ring + tint once it has an active selection. */
	.filter-select {
		background-color: #fff;
		box-shadow: inset 0 0 0 1px var(--color-navy-200, #cbd5e1);
	}
	.filter-select:hover {
		background-color: var(--color-navy-50, #f8fafc);
	}
	[data-dropdown].is-open .filter-select {
		box-shadow: inset 0 0 0 1.5px var(--color-gold-500);
	}
	[data-dropdown].is-open .filter-caret {
		transform: rotate(180deg);
	}
	.filter-count {
		display: none;
		align-items: center;
		justify-content: center;
		min-width: 1.1rem;
		height: 1.1rem;
		padding: 0 0.3rem;
		border-radius: 9999px;
		background-color: var(--color-gold-400);
		color: var(--color-navy-700);
		font-size: 0.65rem;
		font-weight: 700;
	}
	.filter-count.has-count {
		display: inline-flex;
	}

	/* Dropdown menu options: check-box glyph fades in once selected. */
	.filter-option:hover {
		background-color: var(--color-navy-50, #f8fafc);
	}
	.filter-option-box {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		border-radius: 0.2rem;
		box-shadow: inset 0 0 0 1.5px var(--color-navy-200, #cbd5e1);
		color: transparent;
		transition: background-color 0.15s, box-shadow 0.15s, color 0.15s;
	}
	.filter-option-box svg {
		width: 0.6rem;
		height: 0.6rem;
	}
	.filter-option.is-active .filter-option-box {
		background-color: var(--color-gold-400);
		box-shadow: none;
		color: var(--color-navy-700);
	}
</style>

<script>
	const bar = document.querySelector<HTMLElement>("[data-filter-bar]");
	const grid = document.querySelector<HTMLElement>("[data-flyer-grid]");

	if (bar && grid) {
		const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-flyer]"));
		const clearBtn = bar.querySelector<HTMLButtonElement>("[data-clear]");
		const dropdowns = Array.from(bar.querySelectorAll<HTMLElement>("[data-dropdown]"));
		const subBtns = Array.from(bar.querySelectorAll<HTMLButtonElement>("[data-filter]"));

		// Active tag selections. Empty set = show everything.
		const active = new Set<string>();

		// The Community Schedule card (data-always-match, set server-side by
		// title — see learn.astro) is the site's one general schedule and is
		// meant to satisfy every filter combination, so every visitor filtering
		// for anything still finds it. Move it to the front of the grid once,
		// up-front — its position doesn't depend on which filters are active.
		const alwaysMatch = grid.querySelector<HTMLElement>("[data-always-match]");
		if (alwaysMatch) grid.prepend(alwaysMatch);

		const apply = () => {
			cards.forEach((card) => {
				// data-sub is the card's tag list joined with "|" (a flyer can have many tags).
				const tags = (card.dataset.sub ?? "").split("|").filter(Boolean);
				// AND logic: flyer must match every active filter, not just one —
				// except the always-match card (Community Schedule), which bypasses
				// the tag check entirely and shows under any filter combination.
				const show =
					card.dataset.alwaysMatch === "true" ||
					active.size === 0 ||
					[...active].every((t) => tags.includes(t));
				card.classList.toggle("hidden", !show);
			});
			clearBtn?.classList.toggle("hidden", active.size === 0);
			subBtns.forEach((b) =>
				b.classList.toggle("is-active", active.has(b.dataset.filter ?? "")),
			);
			dropdowns.forEach((dd) => {
				const count = Array.from(dd.querySelectorAll<HTMLButtonElement>("[data-filter]")).filter(
					(b) => active.has(b.dataset.filter ?? ""),
				).length;
				const badge = dd.querySelector<HTMLElement>("[data-count]");
				if (badge) {
					badge.textContent = String(count);
					badge.classList.toggle("has-count", count > 0);
				}
			});
		};

		subBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const sub = btn.dataset.filter ?? "";
				if (active.has(sub)) active.delete(sub);
				else active.add(sub);
				apply();
			});
		});

		clearBtn?.addEventListener("click", () => {
			active.clear();
			apply();
		});

		// Dropdowns: one open at a time, closed by outside click or Escape.
		const closeAll = () => {
			dropdowns.forEach((dd) => {
				dd.classList.remove("is-open");
				dd.querySelector<HTMLElement>("[data-dropdown-menu]")?.classList.add("hidden");
				dd.querySelector<HTMLButtonElement>("[data-dropdown-toggle]")?.setAttribute(
					"aria-expanded",
					"false",
				);
			});
		};

		dropdowns.forEach((dd) => {
			const toggle = dd.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
			const menu = dd.querySelector<HTMLElement>("[data-dropdown-menu]");
			toggle?.addEventListener("click", () => {
				const willOpen = !dd.classList.contains("is-open");
				closeAll();
				if (willOpen) {
					dd.classList.add("is-open");
					menu?.classList.remove("hidden");
					toggle.setAttribute("aria-expanded", "true");
				}
			});
		});

		document.addEventListener("click", (e) => {
			if (!(e.target instanceof Node) || !bar.contains(e.target)) closeAll();
		});
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") closeAll();
		});

		apply();
	}
</script>
