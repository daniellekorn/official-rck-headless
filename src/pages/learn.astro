---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import CoverflowCarousel from "../components/CoverflowCarousel.astro";
import { getFlyers, uniqueSubCategories } from "../lib/flyers";

const allLearning = await getFlyers("learning");
const subCategories = uniqueSubCategories(allLearning);

// The community learning schedule lives in the Flyers collection as a
// schedules/daily row (same one shown on /daven). Shown beside the carousel.
const scheduleFlyer = (await getFlyers("schedules", "daily"))[0] ?? null;
---

<Layout
	title="Learn With Us — RCK"
	description="Torah classes, programs, and learning resources from RCK — The Ra'anana Community Kollel."
>
	<Nav />

	<PageHeader
		eyebrow="LEARNING"
		titleGold="Learn"
		titleNavy="With Us"
	/>

	{allLearning.length > 0 && (
		<CoverflowCarousel items={allLearning}>
			{scheduleFlyer && (
				<div slot="aside" class="text-center lg:text-left">
					<p class="eyebrow text-gold-400">Community Learning Schedule</p>
					<div class="mt-4 overflow-hidden rounded-md bg-navy-900 ring-1 ring-white/10 shadow-[0_30px_64px_-34px_rgba(0,0,0,0.8)]">
						{scheduleFlyer.imageUrl ? (
							<a
								href={scheduleFlyer.imageUrl}
								target="_blank"
								rel="noopener noreferrer"
								title="View full size"
								class="block transition-transform duration-300 ease-out hover:scale-[1.02]"
							>
								<img
									src={scheduleFlyer.imageUrl}
									alt="Community Learning Schedule"
									loading="lazy"
									class="w-full h-auto"
								/>
							</a>
						) : scheduleFlyer.embedUrl ? (
							<div class="aspect-[3/4]">
								<iframe
									src={scheduleFlyer.embedUrl}
									title="Community Learning Schedule"
									loading="lazy"
									allow="fullscreen"
									class="w-full h-full border-0"
								/>
							</div>
						) : null}
					</div>
				</div>
			)}
		</CoverflowCarousel>
	)}

	<section class="py-10 sm:py-14 bg-mist">
		<div class="container-page">
			{subCategories.length > 0 && (
				<div class="mb-10 flex flex-wrap justify-center gap-2" data-filter-bar>
					<button
						type="button"
						data-filter=""
						class="filter-chip is-active px-4 py-1.5 rounded-sm text-sm font-medium capitalize transition-colors"
					>
						All
					</button>
					{subCategories.map((sub) => (
						<button
							type="button"
							data-filter={sub}
							class="filter-chip px-4 py-1.5 rounded-sm text-sm font-medium capitalize transition-colors"
						>
							{sub}
						</button>
					))}
				</div>
			)}

			{allLearning.length > 0 ? (
				<div class="grid gap-6 sm:gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" data-flyer-grid>
					{allLearning.map((flyer) => (
						<div
							data-flyer
							data-sub={flyer.subCategory ?? ""}
							class="rounded-md overflow-hidden bg-white ring-1 ring-navy-100 shadow-sm"
						>
							<div class="relative aspect-[3/4]">
								{flyer.imageUrl ? (
									<img
										src={flyer.imageUrl}
										alt={flyer.title ?? ""}
										loading="lazy"
										class="absolute inset-0 w-full h-full object-contain"
									/>
								) : flyer.embedUrl ? (
									<iframe
										src={flyer.embedUrl}
										title={flyer.title}
										loading="lazy"
										allow="fullscreen"
										class="absolute inset-0 w-full h-full border-0"
									/>
								) : flyer.pdfUrl ? (
									<iframe
										src={`https://docs.google.com/viewer?url=${encodeURIComponent(flyer.pdfUrl)}&embedded=true`}
										title={flyer.title}
										loading="lazy"
										class="absolute inset-0 w-full h-full border-0"
									/>
								) : null}
							</div>
							{(flyer.title || flyer.subCategory) && (
								<div class="p-4">
									{flyer.title && (
										<p class="font-medium text-navy-700 text-sm">{flyer.title}</p>
									)}
									{flyer.subCategory && (
										<p class="mt-1 text-xs text-gold-600 capitalize">{flyer.subCategory}</p>
									)}
								</div>
							)}
						</div>
					))}
				</div>
			) : (
				<p class="text-center text-navy-400 py-16">
					Learning materials coming soon.
				</p>
			)}
		</div>
	</section>

	<Footer />
</Layout>

<style>
	/* Filter chips: inactive = white pill, active = gold. Driven by the
	   `.is-active` class which the script toggles for multi-select. */
	.filter-chip {
		background-color: #fff;
		color: var(--color-navy-600, #334155);
		box-shadow: inset 0 0 0 1px var(--color-navy-200, #cbd5e1);
	}
	.filter-chip:hover {
		background-color: var(--color-navy-50, #f8fafc);
	}
	.filter-chip.is-active {
		background-color: var(--color-gold-400, #e0b73a);
		color: var(--color-navy-900, #0b1220);
		box-shadow: none;
	}
</style>

<script>
	const bar = document.querySelector<HTMLElement>("[data-filter-bar]");
	const grid = document.querySelector<HTMLElement>("[data-flyer-grid]");

	if (bar && grid) {
		const cards = Array.from(grid.querySelectorAll<HTMLElement>("[data-flyer]"));
		const allBtn = bar.querySelector<HTMLButtonElement>('[data-filter=""]');
		const subBtns = Array.from(
			bar.querySelectorAll<HTMLButtonElement>("[data-filter]"),
		).filter((b) => (b.dataset.filter ?? "") !== "");

		// Active subcategory selections. Empty set = show everything.
		const active = new Set<string>();

		const apply = () => {
			cards.forEach((card) => {
				const sub = card.dataset.sub ?? "";
				const show = active.size === 0 || active.has(sub);
				card.classList.toggle("hidden", !show);
			});
			allBtn?.classList.toggle("is-active", active.size === 0);
			subBtns.forEach((b) =>
				b.classList.toggle("is-active", active.has(b.dataset.filter ?? "")),
			);
		};

		subBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const sub = btn.dataset.filter ?? "";
				if (active.has(sub)) active.delete(sub);
				else active.add(sub);
				apply();
			});
		});

		// "All" clears every selection and returns to the full grid.
		allBtn?.addEventListener("click", () => {
			active.clear();
			apply();
		});

		apply();
	}
</script>
