---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import { getFlyers, uniqueSubCategories } from "../lib/flyers";

const selectedSub = Astro.url.searchParams.get("sub") ?? null;

const allLearning = await getFlyers("learning");
const subCategories = uniqueSubCategories(allLearning);

const gridFlyers = selectedSub
	? allLearning.filter((f) => f.subCategory === selectedSub)
	: allLearning;
---

<Layout
	title="Learn With Us — RCK"
	description="Torah classes, programs, and learning resources from RCK — The Ra'anana Community Kollel."
>
	<Nav />

	<PageHeader
		eyebrow="LEARNING"
		titleGold="Learn"
		titleNavy="With Us"
		subtitle="Torah learning opportunities for the whole community."
	/>

	{allLearning.length > 0 && (
		<section class="bg-navy-800 py-24 sm:py-28 overflow-hidden" data-coverflow-section>
			<div class="coverflow-stage" data-coverflow>
				{allLearning.map((flyer, i) => (
					<div
						class:list={["coverflow-card", i === 0 ? "pos-active" : i === 1 ? "pos-next" : i === allLearning.length - 1 ? "pos-prev" : "pos-far"]}
						data-index={i}
					>
						<div class="coverflow-inner">
							{flyer.imageUrl ? (
								<img
									src={flyer.imageUrl}
									alt={flyer.title ?? ""}
									loading={i === 0 ? "eager" : "lazy"}
									class="w-full h-full object-contain"
								/>
							) : flyer.embedUrl ? (
								<iframe
									src={flyer.embedUrl}
									title={flyer.title}
									loading="lazy"
									allow="fullscreen"
									class="absolute inset-0 w-full h-full border-0"
								/>
							) : flyer.pdfUrl ? (
								<iframe
									src={`https://docs.google.com/viewer?url=${encodeURIComponent(flyer.pdfUrl)}&embedded=true`}
									title={flyer.title}
									loading="lazy"
									class="absolute inset-0 w-full h-full border-0"
								/>
							) : null}
						</div>
						{flyer.title && (
							<p class="coverflow-label">{flyer.title}</p>
						)}
					</div>
				))}
			</div>

			<div class="flex justify-center gap-2 mt-6" data-coverflow-dots>
				{allLearning.map((_, i) => (
					<button
						type="button"
						data-dot
						data-index={i}
						aria-label={`Go to slide ${i + 1}`}
						class:list={[
							"rounded-full transition-all duration-300 h-1.5",
							i === 0 ? "w-6 bg-gold-400" : "w-1.5 bg-white/30 hover:bg-white/60",
						]}
					/>
				))}
			</div>
		</section>
	)}

	<section class="py-10 sm:py-14 bg-navy-900">
		<div class="container-page">
			{subCategories.length > 0 && (
				<div class="flex flex-wrap gap-2 justify-center mb-10">
					<a
						href="/learn"
						class:list={[
							"px-4 py-1.5 rounded-full text-sm font-medium transition-colors",
							!selectedSub
								? "bg-gold-400 text-navy-900"
								: "bg-navy-700 text-white/80 hover:bg-navy-600",
						]}
					>
						All
					</a>
					{subCategories.map((sub) => (
						<a
							href={`/learn?sub=${encodeURIComponent(sub)}`}
							class:list={[
								"px-4 py-1.5 rounded-full text-sm font-medium capitalize transition-colors",
								selectedSub === sub
									? "bg-gold-400 text-navy-900"
									: "bg-navy-700 text-white/80 hover:bg-navy-600",
							]}
						>
							{sub}
						</a>
					))}
				</div>
			)}

			{gridFlyers.length > 0 ? (
				<div class="grid gap-6 sm:gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
					{gridFlyers.map((flyer) => (
						<div class="rounded-xl overflow-hidden bg-navy-800 shadow-lg">
							<div class="relative aspect-[3/4]">
								{flyer.imageUrl ? (
									<img
										src={flyer.imageUrl}
										alt={flyer.title ?? ""}
										loading="lazy"
										class="absolute inset-0 w-full h-full object-contain"
									/>
								) : flyer.embedUrl ? (
									<iframe
										src={flyer.embedUrl}
										title={flyer.title}
										loading="lazy"
										allow="fullscreen"
										class="absolute inset-0 w-full h-full border-0"
									/>
								) : flyer.pdfUrl ? (
									<iframe
										src={`https://docs.google.com/viewer?url=${encodeURIComponent(flyer.pdfUrl)}&embedded=true`}
										title={flyer.title}
										loading="lazy"
										class="absolute inset-0 w-full h-full border-0"
									/>
								) : null}
							</div>
							{(flyer.title || flyer.subCategory) && (
								<div class="p-4">
									{flyer.title && (
										<p class="font-medium text-white text-sm">{flyer.title}</p>
									)}
									{flyer.subCategory && (
										<p class="mt-1 text-xs text-gold-400 capitalize">{flyer.subCategory}</p>
									)}
								</div>
							)}
						</div>
					))}
				</div>
			) : (
				<p class="text-center text-white/50 py-16">
					{selectedSub
						? `No flyers for "${selectedSub}" yet.`
						: "Learning materials coming soon."}
				</p>
			)}
		</div>
	</section>

	<Footer />
</Layout>

<style>
	/* ── Stage ── */
	.coverflow-stage {
		position: relative;
		height: clamp(300px, 50vh, 460px);
		perspective: 1100px;
		perspective-origin: 50% 50%;
	}

	/* ── Each card ── */
	.coverflow-card {
		position: absolute;
		width: min(240px, 55vw);
		height: 100%;
		left: 50%;
		top: 0;
		margin-left: calc(-1 * min(120px, 27.5vw)); /* center horizontally */
		border-radius: 0.75rem;
		transition:
			transform 0.32s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			opacity 0.32s ease,
			z-index 0s;
		cursor: pointer;
	}

	.coverflow-inner {
		width: 100%;
		height: 100%;
		border-radius: 0.75rem;
		overflow: hidden;
		background: #0b1b38;
		box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55);
		position: relative;
	}

	.coverflow-label {
		text-align: center;
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.6);
		margin-top: 0.6rem;
		padding: 0 0.5rem;
		position: absolute;
		inset-inline: 0;
		bottom: -1.5rem;
	}

	/* ── Positions ── */
	.coverflow-card.pos-active {
		transform: translateX(0) scale(1) rotateY(0deg);
		opacity: 1;
		z-index: 10;
	}

	.coverflow-card.pos-active:hover,
	.coverflow-card.pos-active.is-zoomed {
		transform: translateX(0) scale(1.4) rotateY(0deg);
		z-index: 20;
		cursor: zoom-in;
	}

	.coverflow-card.pos-active.is-zoomed {
		cursor: zoom-out;
	}

	.coverflow-card.pos-prev {
		transform: translateX(-82%) scale(0.78) rotateY(38deg);
		opacity: 0.6;
		z-index: 5;
	}

	.coverflow-card.pos-next {
		transform: translateX(82%) scale(0.78) rotateY(-38deg);
		opacity: 0.6;
		z-index: 5;
	}

	.coverflow-card.pos-far {
		transform: translateX(0) scale(0.55) rotateY(0deg);
		opacity: 0;
		z-index: 1;
		pointer-events: none;
	}
</style>

<script>
	const AUTOPLAY_MS = 3000;

	document.querySelectorAll<HTMLElement>("[data-coverflow]").forEach((stage) => {
		const section = stage.closest<HTMLElement>("[data-coverflow-section]")!;
		const cards = Array.from(stage.querySelectorAll<HTMLElement>(".coverflow-card"));
		const dotsWrap = section.querySelector<HTMLElement>("[data-coverflow-dots]");
		const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll<HTMLButtonElement>("[data-dot]")) : [];
		if (cards.length === 0) return;

		const n = cards.length;
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		const go = (idx: number) => {
			current = (idx + n) % n;
			cards.forEach((c) => c.classList.remove("is-zoomed"));
			cards.forEach((card, i) => {
				const diff = (i - current + n) % n;
				card.classList.remove("pos-active", "pos-next", "pos-prev", "pos-far");
				if (diff === 0) card.classList.add("pos-active");
				else if (diff === 1) card.classList.add("pos-next");
				else if (diff === n - 1) card.classList.add("pos-prev");
				else card.classList.add("pos-far");
			});
			dots.forEach((d, i) => {
				const active = i === current;
				d.classList.toggle("w-6", active);
				d.classList.toggle("bg-gold-400", active);
				d.classList.toggle("w-1.5", !active);
				d.classList.toggle("bg-white/30", !active);
			});
		};

		const start = () => {
			stop();
			timer = setInterval(() => go(current + 1), AUTOPLAY_MS);
		};
		const stop = () => {
			if (timer) clearInterval(timer);
		};

		cards.forEach((card, i) => {
			card.addEventListener("click", () => {
				if (card.classList.contains("pos-active")) {
					const nowZoomed = card.classList.toggle("is-zoomed");
					if (nowZoomed) {
						stop();
					} else {
						start();
					}
				} else {
					go(i);
					start();
				}
			});
			card.addEventListener("mouseenter", () => {
				if (card.classList.contains("pos-active")) stop();
			});
			card.addEventListener("mouseleave", () => {
				if (!card.classList.contains("is-zoomed")) start();
			});
		});

		// Tap/click outside the stage clears zoom and resumes
		document.addEventListener("click", (e) => {
			if (!stage.contains(e.target as Node)) {
				cards.forEach((c) => c.classList.remove("is-zoomed"));
				start();
			}
		});

		dots.forEach((dot) => {
			dot.addEventListener("click", () => {
				go(Number(dot.dataset.index));
				start();
			});
		});

		start();
	});
</script>
