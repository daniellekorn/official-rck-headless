---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import CoverflowCarousel from "../components/CoverflowCarousel.astro";
import { getFlyers, uniqueSubCategories } from "../lib/flyers";

const selectedSub = Astro.url.searchParams.get("sub") ?? null;

const allLearning = await getFlyers("learning");
const subCategories = uniqueSubCategories(allLearning);

const gridFlyers = selectedSub
	? allLearning.filter((f) => f.subCategory === selectedSub)
	: allLearning;
---

<Layout
	title="Learn With Us — RCK"
	description="Torah classes, programs, and learning resources from RCK — The Ra'anana Community Kollel."
>
	<Nav />

	<PageHeader
		eyebrow="LEARNING"
		titleGold="Learn"
		titleNavy="With Us"
	/>

	{allLearning.length > 0 && <CoverflowCarousel items={allLearning} />}

	<section class="py-10 sm:py-14 bg-mist">
		<div class="container-page">
			{subCategories.length > 0 && (
				<div class="flex flex-wrap gap-2 justify-center mb-10">
					<a
						href="/learn"
						class:list={[
							"px-4 py-1.5 rounded-sm text-sm font-medium transition-colors",
							!selectedSub
								? "bg-gold-400 text-navy-900"
								: "bg-white text-navy-600 ring-1 ring-navy-200 hover:bg-navy-50",
						]}
					>
						All
					</a>
					{subCategories.map((sub) => (
						<a
							href={`/learn?sub=${encodeURIComponent(sub)}`}
							class:list={[
								"px-4 py-1.5 rounded-sm text-sm font-medium capitalize transition-colors",
								selectedSub === sub
									? "bg-gold-400 text-navy-900"
									: "bg-white text-navy-600 ring-1 ring-navy-200 hover:bg-navy-50",
							]}
						>
							{sub}
						</a>
					))}
				</div>
			)}

			{gridFlyers.length > 0 ? (
				<div class="grid gap-6 sm:gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
					{gridFlyers.map((flyer) => (
						<div class="rounded-md overflow-hidden bg-white ring-1 ring-navy-100 shadow-sm">
							<div class="relative aspect-[3/4]">
								{flyer.imageUrl ? (
									<img
										src={flyer.imageUrl}
										alt={flyer.title ?? ""}
										loading="lazy"
										class="absolute inset-0 w-full h-full object-contain"
									/>
								) : flyer.embedUrl ? (
									<iframe
										src={flyer.embedUrl}
										title={flyer.title}
										loading="lazy"
										allow="fullscreen"
										class="absolute inset-0 w-full h-full border-0"
									/>
								) : flyer.pdfUrl ? (
									<iframe
										src={`https://docs.google.com/viewer?url=${encodeURIComponent(flyer.pdfUrl)}&embedded=true`}
										title={flyer.title}
										loading="lazy"
										class="absolute inset-0 w-full h-full border-0"
									/>
								) : null}
							</div>
							{(flyer.title || flyer.subCategory) && (
								<div class="p-4">
									{flyer.title && (
										<p class="font-medium text-navy-700 text-sm">{flyer.title}</p>
									)}
									{flyer.subCategory && (
										<p class="mt-1 text-xs text-gold-600 capitalize">{flyer.subCategory}</p>
									)}
								</div>
							)}
						</div>
					))}
				</div>
			) : (
				<p class="text-center text-navy-400 py-16">
					{selectedSub
						? `No flyers for "${selectedSub}" yet.`
						: "Learning materials coming soon."}
				</p>
			)}
		</div>
	</section>

	<Footer />
</Layout>
