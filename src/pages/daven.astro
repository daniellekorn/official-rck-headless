---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import { getDaveningGrouped, type DayType, type ServiceGroup } from "../lib/davening";

const grouped = await getDaveningGrouped();
const hasAny = grouped.Weekday.length > 0 || grouped.Shabbat.length > 0;

const columns: { key: DayType; label: string; groups: ServiceGroup[] }[] = [
	{ key: "Weekday", label: "Weekday", groups: grouped.Weekday },
	{ key: "Shabbat", label: "Shabbat", groups: grouped.Shabbat },
];
---

<Layout title="Daven with Us — RCK" description="Daily and Shabbat davening times at RCK (The Ra'anana Community Kollel).">
	<Nav />
	<main>
		<PageHeader
			eyebrow="Tefillah Schedule"
			titleNavy="Daven with Us"
			subtitle="Join us throughout the day — Shacharis, Mincha, Maariv, and Shabbat tefillos in the heart of Ra'anana."
		/>

		<section class="py-16 sm:py-20 md:py-24">
			<div class="container-page">
				{!hasAny && (
					<div class="mx-auto max-w-xl text-center">
						<p class="font-sans text-sm font-bold uppercase tracking-[0.18em] text-gold-500">
							Coming soon
						</p>
						<h2 class="mt-3 font-display text-3xl md:text-4xl font-medium text-navy-600">
							Davening times on the way
						</h2>
						<p class="mt-4 text-base text-navy-500 leading-relaxed">
							Once the office adds times in the Wix CMS dashboard
							(<code class="rounded bg-navy-50 px-1.5 py-0.5 text-sm">DaveningTimes</code> collection),
							they'll appear here automatically.
						</p>
					</div>
				)}

				{hasAny && (
					<div class="grid gap-10 sm:gap-12 lg:gap-16 md:grid-cols-2">
						{columns.map((col) => (
							<div>
								<div class="mb-6 sm:mb-8 text-center md:text-left">
									<p class="font-sans text-xs sm:text-sm font-bold uppercase tracking-[0.22em] text-gold-500">
										Schedule
									</p>
									<h2 class="mt-1 font-display text-3xl sm:text-4xl font-medium uppercase text-navy-600">
										{col.label}
									</h2>
								</div>

								{col.groups.length === 0 ? (
									<p class="text-sm text-navy-400">
										No {col.label.toLowerCase()} times listed yet.
									</p>
								) : (
									<div class="space-y-5 sm:space-y-6">
										{col.groups.map((group) => (
											<article class="rounded-2xl bg-white ring-1 ring-navy-100 overflow-hidden shadow-[0_12px_30px_-22px_rgba(15,23,42,0.25)] transition-shadow hover:shadow-[0_20px_42px_-22px_rgba(15,23,42,0.4)]">
												<header class="bg-navy-700 px-5 sm:px-6 py-4">
													<h3 class="font-display text-xl sm:text-2xl font-medium uppercase text-white">
														{group.service}
													</h3>
												</header>
												<ul class="divide-y divide-navy-50">
													{group.rows.map((t) => (
														<li class="flex items-baseline justify-between gap-4 px-5 sm:px-6 py-4">
															<div class="min-w-0">
																<p class="font-sans text-sm sm:text-[0.9375rem] font-bold text-navy-600 leading-tight">
																	{t.daySpec || col.label}
																</p>
																{t.notes && (
																	<p class="mt-1 text-xs sm:text-sm text-navy-400 leading-snug">
																		{t.notes}
																	</p>
																)}
															</div>
															<p class="font-sans text-lg sm:text-xl font-black tracking-[-0.015em] text-gold-500 whitespace-nowrap">
																{t.time}
															</p>
														</li>
													))}
												</ul>
											</article>
										))}
									</div>
								)}
							</div>
						))}
					</div>
				)}

				<p class="mx-auto mt-10 sm:mt-12 max-w-2xl text-center text-xs sm:text-sm text-navy-400">
					Times may change seasonally and around chagim. For the most current schedule, contact the office at
					<a href="mailto:office@rckollel.org" class="text-navy-600 hover:text-gold-500 transition-colors">
						{" "}office@rckollel.org
					</a>.
				</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
