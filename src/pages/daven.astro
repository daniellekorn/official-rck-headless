---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import { getDaveningGrouped, groupByService } from "../lib/davening";
import { getComputedWeekdaySchedule } from "../lib/zmanim-schedule";
import { getFlyers } from "../lib/flyers";

const grouped = await getDaveningGrouped();

// Weekday times are computed from zmanim (see design-log #040); CMS weekday
// rows are appended after them for seasonal extras like Selichos.
const computed = getComputedWeekdaySchedule();
const weekdayGroups = groupByService([...computed.rows, ...grouped.Weekday.flatMap((g) => g.rows)]);

// Pre-process weekday groups: collapse same-service rows into time groups by daySpec.
const weekday = weekdayGroups.map((group) => {
	const bySpec = new Map<string, { time: string; notes?: string }[]>();
	for (const r of group.rows) {
		const key = r.daySpec ?? "";
		const existing = bySpec.get(key) ?? [];
		existing.push({ time: r.time, notes: r.notes });
		bySpec.set(key, existing);
	}
	return {
		service: group.service,
		timeGroups: Array.from(bySpec.entries()).map(([daySpec, items]) => ({ daySpec, items })),
	};
});

const hasWeekday = weekday.length > 0;

const scheduleFlyers = await getFlyers("schedules", "daily");
const scheduleFlyer = scheduleFlyers[0] ?? null;
---

<Layout>
	<Nav />
	<main>
		<PageHeader
			eyebrow="Tefillah Schedule"
			titleGold="Daven"
			titleNavy="with Us"
			/>

		<section class="py-16 sm:py-20 md:py-24">
			<div class="container-page">
				<div class="mx-auto max-w-2xl space-y-14">

					<!-- Weekday minyanim -->
					<div>
						<div class="mb-5 flex items-baseline justify-between gap-4">
							<p class="font-sans text-sm font-bold uppercase tracking-[0.22em] text-gold-500">
								Daily Minyanim
							</p>
							<p class="font-sans text-xs sm:text-sm text-navy-300">
								Week of {computed.weekOf}
							</p>
						</div>

						{!hasWeekday ? (
							<p class="text-base text-navy-400">Weekday times coming soon.</p>
						) : (
							<div class="divide-y divide-navy-100">
								{weekday.map(({ service, timeGroups }) => (
									<div class="flex items-start gap-5 sm:gap-7 py-5 sm:py-6">
										<p class="w-28 sm:w-32 shrink-0 font-sans text-base sm:text-lg font-black uppercase tracking-[0.14em] text-navy-700">
											{service}
										</p>
										<div class="min-w-0 flex-1 space-y-1.5">
											{timeGroups.map(({ daySpec, items }) => (
												<div class="sm:flex sm:items-baseline sm:gap-4">
													<p class="font-sans text-sm font-semibold uppercase tracking-[0.1em] text-navy-400 sm:w-36 sm:shrink-0">
														{daySpec}
													</p>
													<p class="font-sans text-base sm:text-lg text-navy-600 tabular-nums">
														{items.map((t) => (t.notes ? `${t.time} (${t.notes})` : t.time)).join(" · ")}
													</p>
												</div>
											))}
										</div>
									</div>
								))}
							</div>
						)}
					</div>

					<!-- Shabbat -->
					<div>
						<p class="mb-5 font-sans text-sm font-bold uppercase tracking-[0.22em] text-gold-500">
							Shabbat
						</p>
						<div class="flex items-start gap-5">
							<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-navy-700 text-gold-300 shadow-[0_10px_24px_-12px_rgba(7,23,58,0.7)]">
								<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
									<path d="M12 21s-8-7.3-8-12a8 8 0 1 1 16 0c0 4.7-8 12-8 12Z" stroke-linecap="round" stroke-linejoin="round" />
									<circle cx="12" cy="9" r="2.5" />
								</svg>
							</span>
							<div>
								<p class="font-sans text-base sm:text-lg font-semibold text-navy-700 leading-snug">
									Join us at KBA for Shabbat davening.
								</p>
								<p class="mt-1.5 font-sans text-sm sm:text-base text-navy-400 leading-relaxed">
									Tel Chai 8, Ra'anana.
								</p>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>
		{scheduleFlyer && (
			<section class="py-16 sm:py-20 bg-mist">
				<div class="container-page">
					<div class="mx-auto max-w-sm">
						<p class="mb-6 font-sans text-sm font-bold uppercase tracking-[0.22em] text-gold-500 text-center">
							Community Learning Schedule
						</p>

						<div class="relative z-0 origin-center rounded-md overflow-hidden shadow-xl ring-1 ring-navy-100 transition-transform duration-300 ease-out hover:z-20 hover:scale-[1.5] hover:shadow-2xl">
							{scheduleFlyer.imageUrl ? (
								<button
									type="button"
									data-lightbox-open
									data-lightbox-src={scheduleFlyer.imageUrl}
									data-lightbox-title={scheduleFlyer.title ?? "Community Learning Schedule"}
									class="block w-full cursor-zoom-in"
									aria-label="View the Community Learning Schedule full size"
								>
									<img
										src={scheduleFlyer.imageUrl}
										alt={scheduleFlyer.title ?? "Community Learning Schedule"}
										class="w-full h-auto"
									/>
								</button>
							) : null}
						</div>
						{scheduleFlyer.imageUrl && (
							<div class="mt-3 flex items-center justify-center gap-4 text-xs sm:text-sm text-navy-300">
								<span>Tap to enlarge</span>
								<button
									type="button"
									data-download
									data-download-src={scheduleFlyer.imageUrl}
									data-download-title={scheduleFlyer.title ?? "Community Learning Schedule"}
									class="inline-flex items-center gap-1.5 font-medium text-navy-600 transition-colors hover:text-gold-500"
								>
									<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
										<path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
									Download
								</button>
							</div>
						)}

						<p class="mt-6 text-center text-sm sm:text-base text-navy-400 leading-relaxed">
							Looking for more?{" "}
							<a href="/learn" class="text-navy-600 font-medium hover:text-gold-500 transition-colors">
								Explore our learning opportunities
							</a>
						</p>
					</div>
				</div>
			</section>
		)}
	</main>
	<Footer />
</Layout>
