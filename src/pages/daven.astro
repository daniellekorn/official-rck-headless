---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import { getDaveningGrouped } from "../lib/davening";

const grouped = await getDaveningGrouped();

// Pre-process weekday groups: collapse same-service rows into time groups by daySpec.
const weekday = grouped.Weekday.map((group) => {
	const bySpec = new Map<string, { time: string; notes?: string }[]>();
	for (const r of group.rows) {
		const key = r.daySpec ?? "";
		const existing = bySpec.get(key) ?? [];
		existing.push({ time: r.time, notes: r.notes });
		bySpec.set(key, existing);
	}
	return {
		service: group.service,
		timeGroups: Array.from(bySpec.entries()).map(([daySpec, items]) => ({ daySpec, items })),
	};
});

const hasWeekday = weekday.length > 0;
---

<Layout
	title="Daven with Us — RCK"
	description="Daily and Shabbat davening times at RCK (The Ra'anana Community Kollel)."
>
	<Nav />
	<main>
		<PageHeader
			eyebrow="Tefillah Schedule"
			titleNavy="Daven with Us"
			subtitle="Join us throughout the day — Shacharis, Mincha, Maariv, and Shabbat tefillos in the heart of Ra'anana."
		/>

		<section class="py-16 sm:py-20 md:py-24">
			<div class="container-page">
				<div class="mx-auto max-w-2xl space-y-14">

					<!-- Weekday minyanim -->
					<div>
						<p class="mb-5 font-sans text-xs font-bold uppercase tracking-[0.22em] text-gold-500">
							Daily Minyanim
						</p>

						{!hasWeekday ? (
							<p class="text-sm text-navy-400">Weekday times coming soon.</p>
						) : (
							<div class="divide-y divide-navy-100">
								{weekday.map(({ service, timeGroups }) => (
									<div class="flex items-start gap-5 sm:gap-7 py-4 sm:py-5">
										<p class="w-24 sm:w-28 shrink-0 font-sans text-xs font-black uppercase tracking-[0.18em] text-navy-700 pt-px">
											{service}
										</p>
										<div class="min-w-0 flex-1 space-y-1">
											{timeGroups.map(({ daySpec, items }) => (
												<div class="sm:flex sm:items-baseline sm:gap-4">
													<p class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-navy-400 sm:w-28 sm:shrink-0">
														{daySpec}
													</p>
													<p class="font-sans text-sm text-navy-600">
														{items.map((t) => (t.notes ? `${t.time} (${t.notes})` : t.time)).join(" · ")}
													</p>
												</div>
											))}
										</div>
									</div>
								))}
							</div>
						)}
					</div>

					<!-- Shabbat -->
					<div>
						<p class="mb-5 font-sans text-xs font-bold uppercase tracking-[0.22em] text-gold-500">
							Shabbat
						</p>
						<div class="flex items-start gap-5">
							<div class="shrink-0 w-20 h-14 rounded-xl border-2 border-dashed border-navy-200 flex items-center justify-center">
								<span class="font-sans text-[0.6rem] font-bold uppercase tracking-wide text-navy-300"
									>KBA logo</span
								>
							</div>
							<div>
								<p class="font-sans text-base font-semibold text-navy-700 leading-snug">
									Join us at KBA for Shabbat davening.
								</p>
								<p class="mt-1.5 font-sans text-sm text-navy-400 leading-relaxed">
									Location details and Shabbat times coming soon.
								</p>
							</div>
						</div>
					</div>

				</div>

				<p class="mx-auto mt-12 sm:mt-16 max-w-2xl text-center text-xs sm:text-sm text-navy-400">
					Times may change seasonally and around chagim. For the most current schedule, contact the
					office at{" "}
					<a
						href="mailto:office@rckollel.org"
						class="text-navy-600 hover:text-gold-500 transition-colors"
					>
						office@rckollel.org
					</a>.
				</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
