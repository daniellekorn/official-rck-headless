---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import TorahSheetsSidebar from "../components/TorahSheetsSidebar.astro";
import {
	getTorahSheets,
	groupTorahBytes,
	groupDorLDor,
	groupSourceSheets,
	type TorahSheet,
} from "../lib/torah-sheets";
import { slugify } from "../lib/slug";

const sheets = await getTorahSheets();

// Each sheet's sidebar-filter key is whichever level actually applies to its
// series (subcategory for Torah Bytes/Dor L'Dor, topic for Source Sheets).
const filterKey = (s: TorahSheet) => slugify(s.subcategory || s.topic || "");

// The single most-recent sheet per tab gets a bigger, real-preview treatment
// (every other PDF card just shows a plain icon). For Torah Bytes/Dor L'Dor,
// the list is already sorted most-recent-first (reading-order reversed —
// see compareParshaOrder in torah-sheets.ts), so that's just the first item.
// Source Sheets has no reading-order concept, so it falls back to whichever
// row was actually added to the CMS most recently.
const mostRecentId = (kind: "nested" | "flat", tabSheets: TorahSheet[]): string | undefined => {
	if (kind === "nested") return tabSheets[0]?._id;
	return tabSheets.reduce<TorahSheet | undefined>(
		(latest, s) => (!latest || (s.createdDate ?? "") > (latest.createdDate ?? "") ? s : latest),
		undefined,
	)?._id;
};

const tabs = [
	{
		key: "torah-bytes",
		label: "Torah Bytes",
		kind: "nested" as const,
		superGroups: groupTorahBytes(sheets),
		sheets: sheets.filter((s) => s.series === "Torah Bytes"),
	},
	{
		key: "dor-ldor",
		label: "Dor L'Dor ParshaLink",
		kind: "nested" as const,
		superGroups: groupDorLDor(sheets),
		sheets: sheets.filter((s) => s.series === "Dor L'Dor"),
	},
	{
		key: "source-sheets",
		label: "Source Sheets",
		kind: "flat" as const,
		groups: groupSourceSheets(sheets),
		sheets: sheets.filter((s) => s.series === "Source Sheets"),
	},
].map((tab) => ({ ...tab, featuredId: mostRecentId(tab.kind, tab.sheets) }));
---

<Layout>
	<Nav />
	<main>
		<PageHeader
			titleNavy="Torah Sheets"
			subtitle="Torah Bytes, Dor L'Dor ParshaLink, and Source Sheets — browse and download RCK's Torah sheets."
		/>

		<section class="py-10 sm:py-14">
			<div class="container-page">
				<div class="flex flex-wrap justify-center gap-2 sm:gap-3" data-sheets-tabs role="tablist">
					{tabs.map((tab, i) => (
						<button
							type="button"
							role="tab"
							data-sheets-tab={tab.key}
							class:list={["sheets-tab", { "is-active": i === 0 }]}
						>
							{tab.label}
						</button>
					))}
				</div>

				{tabs.map((tab, i) => (
					<div data-tab-panel={tab.key} class:list={["mt-8 sm:mt-10", { hidden: i !== 0 }]}>
						{tab.sheets.length === 0 ? (
							<p class="py-16 text-center text-navy-400">
								{tab.label} sheets are coming soon.
							</p>
						) : (
							<div class="grid gap-8 lg:grid-cols-12">
								<div class="lg:col-span-3">
									<details class="lg:hidden">
										<summary class="cursor-pointer font-sans text-sm font-bold uppercase tracking-[0.14em] text-navy-600">
											Filter {tab.label}
										</summary>
										<div class="mt-3 pb-6 border-b border-navy-100" data-sidebar>
											{tab.kind === "nested" ? (
												<TorahSheetsSidebar kind="nested" superGroups={tab.superGroups} />
											) : (
												<TorahSheetsSidebar kind="flat" groups={tab.groups} />
											)}
										</div>
									</details>

									<aside class="hidden lg:block lg:border-e lg:border-navy-100 lg:pe-6" data-sidebar>
										{tab.kind === "nested" ? (
											<TorahSheetsSidebar kind="nested" superGroups={tab.superGroups} />
										) : (
											<TorahSheetsSidebar kind="flat" groups={tab.groups} />
										)}
									</aside>
								</div>

								<div class="lg:col-span-9">
									<div class="flex flex-col" data-sheet-list>
										{tab.sheets.map((sheet) => {
											const isFeatured = sheet._id === tab.featuredId;
											const label = [sheet.title, sheet.year].filter(Boolean).join(", ");
											return (
												<div
													class:list={["sheet-row", { "sheet-row--featured": isFeatured }]}
													data-sheet
													data-filter={filterKey(sheet)}
												>
													<div class="sheet-row-main">
														{sheet.sourceType === "pdf" && isFeatured && sheet.pdfThumbnailUrl ? (
															<a
																href={sheet.pdfUrl}
																target="_blank"
																rel="noopener noreferrer"
																class="sheet-thumb sheet-thumb--preview"
																aria-label={`Download ${label} PDF`}
															>
																<img src={sheet.pdfThumbnailUrl} alt="" loading="lazy" />
																<span class="sheet-thumb-badge" aria-hidden="true">
																	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
																		<path d="M12 4v11m0 0-3.5-3.5M12 15l3.5-3.5M5 19h14" stroke-linecap="round" stroke-linejoin="round" />
																	</svg>
																</span>
															</a>
														) : sheet.sourceType === "pdf" ? (
															<a
																href={sheet.pdfUrl}
																target="_blank"
																rel="noopener noreferrer"
																class="sheet-thumb sheet-thumb--placeholder"
																aria-label={`Download ${label} PDF`}
															>
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
																	<path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z" />
																	<path d="M14 2v6h6" />
																</svg>
																<span class="sheet-thumb-badge" aria-hidden="true">
																	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
																		<path d="M12 4v11m0 0-3.5-3.5M12 15l3.5-3.5M5 19h14" stroke-linecap="round" stroke-linejoin="round" />
																	</svg>
																</span>
															</a>
														) : (
															<button
																type="button"
																data-canva-toggle
																class="sheet-thumb sheet-thumb--placeholder"
																aria-label={`View ${label}`}
															>
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
																	<rect x="3" y="4" width="18" height="14" rx="1.5" />
																	<path d="M3 16l4.5-4.5a1.5 1.5 0 0 1 2.1 0L14 16m2-3 1.6-1.6a1.5 1.5 0 0 1 2.1 0L21 13" />
																</svg>
															</button>
														)}

														<p class="sheet-title">{label}</p>

														{sheet.sourceType === "canva" && sheet.canvaPdfUrl && (
															<a
																href={sheet.canvaPdfUrl}
																download
																class="sheet-download"
																aria-label={`Download ${label}`}
															>
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
																	<path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round" />
																</svg>
															</a>
														)}
													</div>
													{sheet.sourceType === "canva" && sheet.canvaEmbedUrl && (
														<div class="sheet-embed hidden mt-4" data-canva-embed data-canva-src={sheet.canvaEmbedUrl}>
															<iframe
																data-canva-iframe
																loading="lazy"
																title={label}
																class="aspect-[4/3] sm:aspect-video w-full rounded-md border-0"
															></iframe>
														</div>
													)}
												</div>
											);
										})}
									</div>
									<button type="button" data-see-more class="see-more-btn hidden">
										See More
									</button>
									<p class="hidden py-16 text-center text-navy-400" data-no-results>
										No sheets match that filter.
									</p>
								</div>
							</div>
						)}
					</div>
				))}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.sheets-tab {
		border-radius: 0.125rem;
		padding: 0.625rem 1.5rem;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.9375rem;
		color: var(--color-navy-500);
		background: #fff;
		box-shadow: inset 0 0 0 1px var(--color-navy-200);
		transition: background-color 0.15s, color 0.15s, box-shadow 0.15s;
	}
	.sheets-tab:hover {
		background: var(--color-navy-50);
	}
	.sheets-tab.is-active {
		box-shadow: inset 0 0 0 1.5px var(--color-gold-500);
		background: var(--color-gold-100);
		color: var(--color-navy-700);
	}

	/* Flat, list-based rows — a fine hairline divider does the separating, no
	   card boxes/shadows around each sheet. */
	.sheet-row {
		border-bottom: 1px solid var(--color-navy-100);
		padding-block: 0.875rem;
	}
	.sheet-row:first-child {
		padding-top: 0;
	}
	.sheet-row-main {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.sheet-thumb {
		position: relative;
		flex-shrink: 0;
		display: block;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 0.25rem;
		overflow: visible;
		background: var(--color-mist);
		transition: background-color 0.15s;
	}
	.sheet-row--featured .sheet-thumb {
		width: 9.5rem;
		height: 9.5rem;
	}

	.sheet-thumb--placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-navy-300);
		cursor: pointer;
	}
	.sheet-thumb--placeholder:hover {
		background: var(--color-navy-50);
	}
	.sheet-thumb--placeholder svg {
		width: 1.5rem;
		height: 1.5rem;
	}
	.sheet-row--featured .sheet-thumb--placeholder svg {
		width: 3rem;
		height: 3rem;
	}

	/* The one "most recent" card — a real page-1 preview instead of the
	   generic icon every other PDF card uses. */
	.sheet-thumb--preview {
		overflow: hidden;
		box-shadow: inset 0 0 0 1px var(--color-navy-100);
	}
	.sheet-thumb--preview img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.sheet-thumb--preview:hover img {
		transform: scale(1.05);
	}

	/* The download cue overlaid on the PDF icon box — the whole box is the
	   click target, this badge just signals what clicking it does. */
	.sheet-thumb-badge {
		position: absolute;
		bottom: -0.375rem;
		right: -0.375rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.375rem;
		height: 1.375rem;
		border-radius: 9999px;
		background: var(--color-gold-500);
		color: var(--color-navy-700);
		box-shadow: 0 2px 6px -1px rgba(7, 23, 58, 0.4), 0 0 0 2px var(--color-paper);
		transition: background-color 0.15s;
	}
	.sheet-thumb--placeholder:hover .sheet-thumb-badge {
		background: var(--color-gold-400);
	}
	.sheet-thumb-badge svg {
		width: 0.75rem;
		height: 0.75rem;
	}
	.sheet-row--featured .sheet-thumb-badge {
		width: 2rem;
		height: 2rem;
		bottom: -0.5rem;
		right: -0.5rem;
	}
	.sheet-row--featured .sheet-thumb-badge svg {
		width: 1.125rem;
		height: 1.125rem;
	}

	.sheet-title {
		flex: 1;
		min-width: 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.0625rem;
		color: var(--color-navy-600);
	}
	.sheet-row--featured .sheet-title {
		font-size: 1.25rem;
	}

	.sheet-download {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.25rem;
		color: var(--color-navy-500);
		transition: background-color 0.15s, color 0.15s;
	}
	.sheet-download:hover {
		background: var(--color-gold-100);
		color: var(--color-navy-700);
	}
	.sheet-download svg {
		width: 1.125rem;
		height: 1.125rem;
	}

	.sheet-embed iframe {
		background: var(--color-mist);
	}

	.see-more-btn {
		display: block;
		width: 100%;
		margin-top: 1.25rem;
		padding: 0.75rem;
		border-radius: 0.125rem;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.875rem;
		text-align: center;
		color: var(--color-navy-600);
		background: var(--color-mist);
		transition: background-color 0.15s;
	}
	.see-more-btn:hover {
		background: var(--color-navy-100);
	}
</style>

<script>
	// Three independent concerns, same vanilla data-attribute + delegated-script
	// pattern as learn.astro's filter bar and team.astro's card toggles — no new
	// client-side approach introduced.

	// 1. Tabs: one visible panel at a time, deep-linkable via #torah-bytes etc.
	const tabButtons = document.querySelectorAll<HTMLButtonElement>("[data-sheets-tab]");
	const panels = document.querySelectorAll<HTMLElement>("[data-tab-panel]");

	const activateTab = (key: string) => {
		let matched = false;
		tabButtons.forEach((btn) => {
			const isMatch = btn.dataset.sheetsTab === key;
			btn.classList.toggle("is-active", isMatch);
			btn.setAttribute("aria-selected", String(isMatch));
			if (isMatch) matched = true;
		});
		panels.forEach((panel) => {
			panel.classList.toggle("hidden", panel.dataset.tabPanel !== key);
		});
		return matched;
	};

	tabButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			const key = btn.dataset.sheetsTab ?? "";
			activateTab(key);
			history.replaceState(null, "", `#${key}`);
		});
	});

	const initialKey = location.hash.slice(1);
	if (!initialKey || !activateTab(initialKey)) {
		const first = tabButtons[0]?.dataset.sheetsTab;
		if (first) activateTab(first);
	}

	// 2. Sidebar filtering: single active filter per panel (these are hierarchical
	// categories, not independent tags, so no multi-select AND logic needed).
	// Sidebar content is rendered twice per panel (mobile <details> + desktop
	// aside — a <details> can't be forced open at a breakpoint via CSS alone),
	// so filter *trigger* buttons use data-filter-option (not data-filter —
	// that's the card's own match-target attribute; querying "[data-filter]"
	// here would also match the card elements themselves, wiring a click
	// anywhere on a card, download link included, up as if it were a filter
	// button).
	//
	// Unfiltered view also caps how many cards show at once (roughly half),
	// with a "See more" button to reveal the rest — the full list (currently
	// dozens of sheets) was an unreasonably long scroll otherwise. A specific
	// filter always shows every match; the cap only applies to "All Sheets".
	panels.forEach((panel) => {
		const cards = Array.from(panel.querySelectorAll<HTMLElement>("[data-sheet]"));
		const filterBtns = Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-filter-option]"));
		const resetBtns = Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-filter-reset]"));
		const noResults = panel.querySelector<HTMLElement>("[data-no-results]");
		const seeMoreBtn = panel.querySelector<HTMLButtonElement>("[data-see-more]");
		const initialCount = Math.ceil(cards.length / 2);
		let expanded = false;

		const apply = (active: string | null) => {
			let visible = 0;
			let matchIndex = 0;
			cards.forEach((card) => {
				const matches = !active || card.dataset.filter === active;
				const capped = !active && !expanded && matchIndex >= initialCount;
				if (matches) matchIndex += 1;
				card.classList.toggle("hidden", !matches || capped);
				if (matches && !capped) visible += 1;
			});
			noResults?.classList.toggle("hidden", visible > 0);
			filterBtns.forEach((b) => b.classList.toggle("is-active", active !== null && b.dataset.filterOption === active));
			resetBtns.forEach((b) => b.classList.toggle("is-active", active === null));
			seeMoreBtn?.classList.toggle("hidden", active !== null || expanded || cards.length <= initialCount);
		};

		filterBtns.forEach((btn) => {
			btn.addEventListener("click", () => apply(btn.dataset.filterOption ?? null));
		});
		resetBtns.forEach((btn) => {
			btn.addEventListener("click", () => apply(null));
		});
		seeMoreBtn?.addEventListener("click", () => {
			expanded = true;
			apply(null);
		});

		apply(null);
	});

	// 3. Canva "View Sheet" toggle: lazy-sets the iframe src on first open so a
	// tab full of Canva sheets doesn't load every embed up front.
	document.querySelectorAll<HTMLButtonElement>("[data-canva-toggle]").forEach((btn) => {
		const embed = btn.closest("[data-sheet]")?.querySelector<HTMLElement>("[data-canva-embed]");
		const iframe = embed?.querySelector<HTMLIFrameElement>("[data-canva-iframe]");
		if (!embed || !iframe) return;

		btn.addEventListener("click", () => {
			const opening = embed.classList.contains("hidden");
			if (opening && !iframe.src) iframe.src = embed.dataset.canvaSrc ?? "";
			embed.classList.toggle("hidden", !opening);
		});
	});
</script>
