---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import TorahSheetsSidebar from "../components/TorahSheetsSidebar.astro";
import {
	getTorahSheets,
	groupAllSheets,
	groupTorahBytes,
	groupDorLDor,
	groupSourceSheets,
	pickFeatured,
	sortByUploadRecency,
	filterKeys,
	type TorahSheet,
} from "../lib/torah-sheets";

const sheets = await getTorahSheets();

// The tab a first-time visitor sees before touching any pill/filter — also
// drives which panel the pre-JS SSR markup renders visible (see class:list
// below) so there's no flash-then-switch once the client script runs.
const DEFAULT_TAB_KEY = "torah-bytes";

// Each sheet's sidebar-filter keys — see filterKeys (torah-sheets.ts) for
// the full multi-value logic (combined-parsha components, Pirkei Avos, etc).

// The single most-recent sheet per tab gets a bigger, real-preview treatment
// (every other PDF card just shows a plain icon) *and* is pulled to the top
// of that tab's list — everything else keeps its normal reading-order
// position underneath. pickFeatured (torah-sheets.ts) picks which one: a
// single new upload becomes it immediately; a batch import falls back to
// whichever sheet in that batch matches the real current Hebrew-calendar
// parsha.
const orderTab = <T extends { sheets: TorahSheet[] }>(tab: T): T & { featuredId?: string } => {
	const featured = pickFeatured(tab.sheets);
	if (!featured) return { ...tab, featuredId: undefined };
	return {
		...tab,
		sheets: [featured, ...tab.sheets.filter((s) => s._id !== featured._id)],
		featuredId: featured._id,
	};
};

const tabs = [
	{
		key: "all",
		label: "All Publications",
		kind: "nested" as const,
		superGroups: groupAllSheets(sheets),
		// Unfiltered order here is newest-upload-first across every series —
		// deliberately ignoring year/reading-cycle (that's what the Torah
		// Bytes/Dor L'Dor tabs are for) — see sortByUploadRecency.
		sheets: sortByUploadRecency(sheets),
	},
	{
		key: "torah-bytes",
		label: "Torah Bytes",
		kind: "nested" as const,
		superGroups: groupTorahBytes(sheets),
		sheets: sheets.filter((s) => s.series === "Torah Bytes"),
	},
	{
		key: "dor-ldor",
		label: "Dor L'Dor ParshaLink",
		kind: "nested" as const,
		superGroups: groupDorLDor(sheets),
		sheets: sheets.filter((s) => s.series === "Dor L'Dor"),
	},
	{
		key: "source-sheets",
		label: "Source Sheets",
		kind: "flat" as const,
		groups: groupSourceSheets(sheets),
		// No reading-cycle concept for Source Sheets — newest upload first,
		// same as the All Publications tab (see sortByUploadRecency).
		sheets: sortByUploadRecency(sheets.filter((s) => s.series === "Source Sheets")),
	},
].map(orderTab);
---

<Layout>
	<Nav />
	<main>
		<PageHeader
			titleNavy="Torah Sheets"
			subtitle="Browse and download RCK's Torah publications."
		/>

		<section class="py-10 sm:py-14">
			<div class="container-page">
				{tabs.map((tab) => (
					<div data-tab-panel={tab.key} class:list={["mt-0", { hidden: tab.key !== DEFAULT_TAB_KEY }]}>
						<div class="grid gap-8 lg:grid-cols-12">
							<div class="lg:col-span-3">
								<details class="lg:hidden">
									<summary class="cursor-pointer font-sans text-sm font-bold uppercase tracking-[0.14em] text-navy-600">
										Filter &amp; Browse
									</summary>
									<div class="mt-3 pb-6 border-b border-navy-100" data-sidebar>
										{tab.kind === "nested" ? (
											<TorahSheetsSidebar kind="nested" superGroups={tab.superGroups} publications={tabs} activePublication={tab.key} />
										) : (
											<TorahSheetsSidebar kind="flat" groups={tab.groups} publications={tabs} activePublication={tab.key} />
										)}
									</div>
								</details>

								<aside class="hidden lg:block lg:border-e lg:border-navy-100 lg:pe-6" data-sidebar>
									{tab.kind === "nested" ? (
										<TorahSheetsSidebar kind="nested" superGroups={tab.superGroups} publications={tabs} activePublication={tab.key} />
									) : (
										<TorahSheetsSidebar kind="flat" groups={tab.groups} publications={tabs} activePublication={tab.key} />
									)}
								</aside>
							</div>

							<div class="lg:col-span-9">
								{tab.sheets.length === 0 ? (
									<p class="py-16 text-center text-navy-400">
										{tab.label} sheets are coming soon.
									</p>
								) : (
									<>
									<div class="flex flex-col" data-sheet-list>
										{tab.sheets.map((sheet) => {
											const isFeatured = sheet._id === tab.featuredId;
											const label = [sheet.title, sheet.year].filter(Boolean).join(", ");
											return (
												<div
													class:list={["sheet-row", { "sheet-row--featured": isFeatured }]}
													data-sheet
													data-featured={isFeatured ? "" : undefined}
													data-filter={filterKeys(sheet).join(" ")}
												>
													<div class="sheet-row-main">
														{/* Dual preview/fallback markup: always for the tab's own
														    featured pick (every tab), and additionally for *every*
														    thumbnailed row on Source Sheets — that tab promotes
														    whichever card sorts first under the active topic filter,
														    not just the tab-wide pick, so any of its rows might need
														    to show its real image. See design-log #053 addendum 18. */}
														{sheet.sourceType === "pdf" && sheet.pdfThumbnailUrl && (isFeatured || tab.key === "source-sheets") ? (
															<>
															<a
																href={sheet.pdfUrl}
																target="_blank"
																rel="noopener noreferrer"
																class:list={["sheet-thumb", "sheet-thumb--preview", { hidden: !isFeatured }]}
																aria-label={`View ${label} PDF`}
																data-pdf-open
																data-pdf-name={sheet.pdfFilename}
																data-thumb-preview
															>
																<img src={sheet.pdfThumbnailUrl} alt="" loading="lazy" />
																<svg class="sheet-thumb-view-icon sheet-thumb-view-icon--overlay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
																	<path d="M18 13v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h6" stroke-linecap="round" stroke-linejoin="round" />
																	<path d="M15 3h6v6" stroke-linecap="round" stroke-linejoin="round" />
																	<path d="M10 14 21 3" stroke-linecap="round" stroke-linejoin="round" />
																</svg>
															</a>
															{/* Same plain icon every non-thumbnailed PDF card uses —
															    shown by default for a thumbnailed row that isn't
															    (yet) the promoted one; JS swaps the two as filters
															    change. See design-log #053/#057. */}
															<a
																href={sheet.pdfUrl}
																target="_blank"
																rel="noopener noreferrer"
																class:list={["sheet-thumb", "sheet-thumb--placeholder", { hidden: isFeatured }]}
																aria-label={`View ${label} PDF`}
																data-pdf-open
																data-pdf-name={sheet.pdfFilename}
																data-thumb-fallback
															>
																<svg class="sheet-thumb-view-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
																	<path d="M18 13v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h6" stroke-linecap="round" stroke-linejoin="round" />
																	<path d="M15 3h6v6" stroke-linecap="round" stroke-linejoin="round" />
																	<path d="M10 14 21 3" stroke-linecap="round" stroke-linejoin="round" />
																</svg>
															</a>
															</>
														) : sheet.sourceType === "pdf" ? (
															<a
																href={sheet.pdfUrl}
																target="_blank"
																rel="noopener noreferrer"
																class="sheet-thumb sheet-thumb--placeholder"
																aria-label={`View ${label} PDF`}
																data-pdf-open
																data-pdf-name={sheet.pdfFilename}
															>
																<svg class="sheet-thumb-view-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
																	<path d="M18 13v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h6" stroke-linecap="round" stroke-linejoin="round" />
																	<path d="M15 3h6v6" stroke-linecap="round" stroke-linejoin="round" />
																	<path d="M10 14 21 3" stroke-linecap="round" stroke-linejoin="round" />
																</svg>
															</a>
														) : (
															<button
																type="button"
																data-canva-toggle
																class="sheet-thumb sheet-thumb--placeholder"
																aria-label={`View ${label}`}
															>
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
																	<rect x="3" y="4" width="18" height="14" rx="1.5" />
																	<path d="M3 16l4.5-4.5a1.5 1.5 0 0 1 2.1 0L14 16m2-3 1.6-1.6a1.5 1.5 0 0 1 2.1 0L21 13" />
																</svg>
															</button>
														)}

														{sheet.sourceType === "pdf" ? (
														<a
															href={sheet.pdfUrl}
															target="_blank"
															rel="noopener noreferrer"
															class="sheet-title"
															data-pdf-open
															data-pdf-name={sheet.pdfFilename}
														>
															{label}
														</a>
													) : (
														<p class="sheet-title">{label}</p>
													)}

														{sheet.sourceType === "pdf" && sheet.pdfDownloadUrl && (
															<a
																href={sheet.pdfDownloadUrl}
																class="sheet-download"
																aria-label={`Download ${label} PDF`}
															>
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
																	<path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round" />
																</svg>
															</a>
														)}

														{sheet.sourceType === "canva" && sheet.canvaPdfUrl && (
															<a
																href={sheet.canvaPdfUrl}
																download
																class="sheet-download"
																aria-label={`Download ${label}`}
															>
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
																	<path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round" />
																</svg>
															</a>
														)}
													</div>
													{sheet.sourceType === "canva" && sheet.canvaEmbedUrl && (
														<div class="sheet-embed hidden mt-4" data-canva-embed data-canva-src={sheet.canvaEmbedUrl}>
															<iframe
																data-canva-iframe
																loading="lazy"
																title={label}
																class="aspect-[4/3] sm:aspect-video w-full rounded-md border-0"
															></iframe>
														</div>
													)}
												</div>
											);
										})}
									</div>
									<button type="button" data-see-more class="see-more-btn hidden">
										See More
									</button>
									<p class="hidden py-16 text-center text-navy-400" data-no-results>
										No sheets match that filter.
									</p>
									</>
								)}
							</div>
						</div>
					</div>
				))}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>

	/* Flat, list-based rows — a fine hairline divider does the separating, no
	   card boxes/shadows around each sheet. */
	.sheet-row {
		border-bottom: 1px solid var(--color-navy-100);
		padding-block: 0.875rem;
	}
	.sheet-row:first-child {
		padding-top: 0;
	}
	.sheet-row-main {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.sheet-thumb {
		position: relative;
		flex-shrink: 0;
		display: block;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 0.25rem;
		overflow: visible;
		background: var(--color-mist);
		transition: background-color 0.15s;
	}
	.sheet-row--featured .sheet-thumb {
		width: 9.5rem;
		height: 9.5rem;
	}
	/* Same specificity collision as .see-more-btn.hidden below: .sheet-thumb's
	   own `display` (and --placeholder's `display: flex`) ties with Tailwind's
	   .hidden{display:none} at equal specificity, and this component's <style>
	   compiles after Tailwind's utilities — so without this, JS toggling
	   .hidden on a thumb link (design-log #053 addenda 18/19) silently did
	   nothing: the preview and fallback icon both stayed visible side by side. */
	.sheet-thumb.hidden {
		display: none;
	}

	/* No background "box" — just the icon itself, same minimal icon-button
	   treatment as .sheet-download, so there's no empty mist-colored square
	   sitting around a small icon when there's no real PDF thumbnail (the
	   common case — most sheets don't have one). */
	.sheet-thumb--placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		background: transparent;
		color: var(--color-navy-500);
		cursor: pointer;
		transition: background-color 0.15s, color 0.15s;
	}
	.sheet-thumb--placeholder:hover {
		background: var(--color-gold-100);
		color: var(--color-navy-700);
	}
	.sheet-thumb--placeholder svg {
		width: 1.125rem;
		height: 1.125rem;
	}
	.sheet-row--featured .sheet-thumb--placeholder {
		width: 3rem;
		height: 3rem;
	}
	.sheet-row--featured .sheet-thumb--placeholder svg {
		width: 1.5rem;
		height: 1.5rem;
	}

	/* The one "most recent" card — a real page-1 preview instead of the
	   generic icon every other PDF card uses. */
	.sheet-thumb--preview {
		overflow: hidden;
		box-shadow: inset 0 0 0 1px var(--color-navy-100);
	}
	.sheet-thumb--preview img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.sheet-thumb--preview:hover img {
		transform: scale(1.05);
	}

	/* A single gold external-link/open icon marks the thumbnail as a read/open
	   action, not a download — full strength on the plain placeholder box
	   (sized via the shared .sheet-thumb--placeholder svg rule above),
	   softened to an overlay (with its own explicit size, since it sits over
	   a photo rather than inside the flex-centered placeholder box) on the
	   real preview. The separate .sheet-download button below keeps the
	   actual download-arrow icon. */
	.sheet-thumb-view-icon {
		color: var(--color-gold-500);
	}
	.sheet-thumb-view-icon--overlay {
		position: absolute;
		inset: 0;
		margin: auto;
		width: 2.75rem;
		height: 2.75rem;
		opacity: 0.7;
		filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.55));
	}

	.sheet-title {
		flex: 1;
		min-width: 0;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: 1.0625rem;
		color: var(--color-navy-600);
		text-decoration: none;
		/* Some imported titles carry a long unbroken "Prefix.Word" run with no
		   space (e.g. "ParshaLink.Pinchas", "Iyun2Halacha.Chaburah" — leftover
		   bulk-import titles never renamed) that a normal word-wrap can't break
		   on — without this, that single "word" forces the row wider than a
		   mobile viewport, pushing .sheet-download off-screen. min-width: 0
		   alone isn't enough for that case; overflow-wrap: anywhere is. */
		overflow-wrap: anywhere;
	}
	a.sheet-title:hover {
		text-decoration: underline;
	}
	.sheet-row--featured .sheet-title {
		font-size: 1.25rem;
	}

	.sheet-download {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.25rem;
		color: var(--color-navy-500);
		transition: background-color 0.15s, color 0.15s;
	}
	.sheet-download:hover {
		background: var(--color-gold-100);
		color: var(--color-navy-700);
	}
	.sheet-download svg {
		width: 1.125rem;
		height: 1.125rem;
	}

	.sheet-embed iframe {
		background: var(--color-mist);
	}

	.see-more-btn {
		display: block;
		width: 100%;
		margin-top: 1.25rem;
		padding: 0.75rem;
		border-radius: 0.125rem;
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.875rem;
		text-align: center;
		color: var(--color-navy-600);
		background: var(--color-mist);
		transition: background-color 0.15s;
	}
	.see-more-btn:hover {
		background: var(--color-navy-100);
	}
	/* Explicit two-class override: Tailwind's own .hidden{display:none} and
	   this component's .see-more-btn{display:block} have equal specificity,
	   so whichever rule the bundler happens to emit last in the compiled
	   stylesheet wins — which was sometimes .see-more-btn, leaving the button
	   visible even after JS added .hidden. Bumping the specificity here makes
	   it deterministic regardless of source order. */
	.see-more-btn.hidden {
		display: none;
	}
</style>

<script>
	// Four independent concerns, same vanilla data-attribute + delegated-script
	// pattern as learn.astro's filter bar and team.astro's card toggles — no new
	// client-side approach introduced.

	// 1. Publication switcher: one visible panel at a time, deep-linkable via
	// #torah-bytes etc. Lives in the sidebar now (data-pub-select), rendered
	// once per panel's sidebar (mobile + desktop copies, same reasoning as
	// the filter buttons below) — so every instance across every panel needs
	// its is-active state kept in sync, not just the one that was clicked.
	const pubButtons = document.querySelectorAll<HTMLButtonElement>("[data-pub-select]");
	const panels = document.querySelectorAll<HTMLElement>("[data-tab-panel]");

	// Each panel's filter-reset function (pushed in section 2 below, before
	// any click can reach here) — switching publications clears every panel's
	// active filter, so leaving a filtered tab and coming back to it, or to
	// "All Publications," always starts from "All Sheets" again rather than
	// silently keeping a stale filter selected on a now-hidden panel.
	const panelResets: (() => void)[] = [];

	const activateTab = (key: string) => {
		let matched = false;
		pubButtons.forEach((btn) => {
			const isMatch = btn.dataset.pubSelect === key;
			btn.classList.toggle("is-active", isMatch);
			if (isMatch) matched = true;
		});
		panels.forEach((panel) => {
			panel.classList.toggle("hidden", panel.dataset.tabPanel !== key);
		});
		panelResets.forEach((reset) => reset());
		return matched;
	};

	pubButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			const key = btn.dataset.pubSelect ?? "";
			activateTab(key);
			history.replaceState(null, "", `#${key}`);
		});
	});

	// Matches DEFAULT_TAB_KEY in the frontmatter above — keep in sync with
	// the SSR panel that's pre-rendered visible, so there's no flash-then-
	// switch before this script runs.
	const DEFAULT_TAB_KEY = "torah-bytes";
	const initialKey = location.hash.slice(1);
	if (!initialKey || !activateTab(initialKey)) {
		activateTab(DEFAULT_TAB_KEY);
	}

	// 2. Sidebar filtering: only one filter button can be *active* at a time,
	// but each card can *match* several (data-filter is a space-separated list
	// — see filterKeys in torah-sheets.ts — so a combined-parsha sheet matches
	// both component-parsha buttons, and a parsha+Pirkei-Avos sheet matches
	// both its parsha button and the flat Pirkei Avos button).
	// Sidebar content is rendered twice per panel (mobile <details> + desktop
	// aside — a <details> can't be forced open at a breakpoint via CSS alone),
	// so filter *trigger* buttons use data-filter-option (not data-filter —
	// that's the card's own match-target attribute; querying "[data-filter]"
	// here would also match the card elements themselves, wiring a click
	// anywhere on a card, download link included, up as if it were a filter
	// button).
	//
	// Unfiltered view also caps how many cards show at once, revealed in
	// steps via a "See more" button — the full list (currently dozens of
	// sheets) was an unreasonably long scroll otherwise. A specific filter
	// always shows every match; the cap only applies to "All Sheets".
	panels.forEach((panel) => {
		const cards = Array.from(panel.querySelectorAll<HTMLElement>("[data-sheet]"));
		const filterBtns = Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-filter-option]"));
		const resetBtns = Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-filter-reset]"));
		const noResults = panel.querySelector<HTMLElement>("[data-no-results]");
		const seeMoreBtn = panel.querySelector<HTMLButtonElement>("[data-see-more]");
		const sheetList = panel.querySelector<HTMLElement>("[data-sheet-list]");
		// Source Sheets promotes whichever card is first in the *current* view
		// (topic filter or not) to the big real-image treatment — its topic
		// filters are their own mini-series (e.g. "From Iyun to Halacha"), so
		// each one gets its own lead card, not just the tab-wide pick. Every
		// other tab keeps the simpler rule below: only ever the tab's own
		// featured pick, and only pre-filter. See design-log #053 addendum 18.
		const isSourceSheets = panel.dataset.tabPanel === "source-sheets";
		const featuredRow = panel.querySelector<HTMLElement>("[data-featured]");
		// Toggles one card's box between the big real-preview (or, lacking a
		// generated thumbnail, just the plain icon at the enlarged size the
		// featured row already uses) and the normal small icon every other
		// card uses.
		const setPromoted = (card: HTMLElement, promoted: boolean) => {
			card.classList.toggle("sheet-row--featured", promoted);
			card.querySelector<HTMLElement>("[data-thumb-preview]")?.classList.toggle("hidden", !promoted);
			card.querySelector<HTMLElement>("[data-thumb-fallback]")?.classList.toggle("hidden", promoted);
		};
		// Initial batch, then this many more revealed per "See more" click,
		// until everything's shown — at which point the button flips to
		// "See Less" and collapses straight back to INITIAL_COUNT (not just
		// one step back).
		const INITIAL_COUNT = 24;
		const STEP = 20;
		const paginate = cards.length > INITIAL_COUNT;
		let visibleCount = paginate ? INITIAL_COUNT : cards.length;
		let activeFilter: string | null = null;

		const apply = () => {
			let visible = 0;
			let matchIndex = 0;
			let topMatch: HTMLElement | null = null;
			cards.forEach((card) => {
				const matches = !activeFilter || (card.dataset.filter?.split(" ").includes(activeFilter) ?? false);
				const capped = !activeFilter && matchIndex >= visibleCount;
				if (matches) matchIndex += 1;
				if (matches && !capped) {
					visible += 1;
					if (!topMatch) topMatch = card;
				}
				card.classList.toggle("hidden", !matches || capped);
			});
			noResults?.classList.toggle("hidden", visible > 0);
			filterBtns.forEach((b) => b.classList.toggle("is-active", activeFilter !== null && b.dataset.filterOption === activeFilter));
			resetBtns.forEach((b) => b.classList.toggle("is-active", activeFilter === null));
			seeMoreBtn?.classList.toggle("hidden", activeFilter !== null || !paginate);
			if (seeMoreBtn) seeMoreBtn.textContent = visibleCount >= cards.length ? "See Less" : "See More";

			if (isSourceSheets) {
				cards.forEach((card) => setPromoted(card, card === topMatch));
			} else if (featuredRow) {
				setPromoted(featuredRow, activeFilter === null);
			}
		};

		filterBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const key = btn.dataset.filterOption ?? null;
				activeFilter = activeFilter === key ? null : key;
				apply();
				// On mobile the sidebar sits above the results (single-column
				// layout below `lg:`), so a filtered result set lands off-screen
				// under the still-open <details> — jump to it. Desktop shows the
				// sidebar and results side by side, so no scroll is needed there;
				// the publication tab switcher (section 1 above) deliberately
				// doesn't do this — only choosing a sidebar subfilter should.
				if (window.matchMedia("(max-width: 1023px)").matches) {
					sheetList?.scrollIntoView({ behavior: "smooth", block: "start" });
				}
			});
		});
		resetBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				activeFilter = null;
				apply();
			});
		});
		seeMoreBtn?.addEventListener("click", () => {
			if (visibleCount >= cards.length) {
				visibleCount = INITIAL_COUNT;
				sheetList?.scrollIntoView({ behavior: "smooth", block: "start" });
			} else {
				visibleCount = Math.min(visibleCount + STEP, cards.length);
			}
			apply();
		});

		panelResets.push(() => {
			activeFilter = null;
			apply();
		});

		apply();
	});

	// 3. Canva "View Sheet" toggle: lazy-sets the iframe src on first open so a
	// tab full of Canva sheets doesn't load every embed up front.
	document.querySelectorAll<HTMLButtonElement>("[data-canva-toggle]").forEach((btn) => {
		const embed = btn.closest("[data-sheet]")?.querySelector<HTMLElement>("[data-canva-embed]");
		const iframe = embed?.querySelector<HTMLIFrameElement>("[data-canva-iframe]");
		if (!embed || !iframe) return;

		btn.addEventListener("click", () => {
			const opening = embed.classList.contains("hidden");
			if (opening && !iframe.src) iframe.src = embed.dataset.canvaSrc ?? "";
			embed.classList.toggle("hidden", !opening);
		});
	});

	// 4. "View PDF" links (thumbnail/title/main click): plain `href` + `target`
	// already opens the PDF inline in a new tab on every browser — that's the
	// whole mechanism, and it must stay untouched in Chromium browsers
	// (Chrome, Edge, Opera, Brave, …), confirmed by direct testing that
	// Chrome's own built-in PDF viewer doesn't honor a renamed blob's `File`
	// name for its own save button, so a real download from that tab still
	// lands under the blob's internal UUID (see design-log #053 addendum 16)
	// — a correctly-named download is what the separate Download button
	// (`pdfDownloadUrl`, `?dn=`) is for there, not this link.
	//
	// Non-Chromium browsers' PDF viewers may not share that specific
	// limitation — unverified here (no Firefox/Safari available to test
	// against), so this is a best-effort attempt, not a guarantee: fetch the
	// PDF as a blob, re-open it as a named `File` (browsers that DO respect
	// it use `.name` as the suggested save name), falling back to the plain
	// URL on any failure (CORS block, offline, or simply not working there).
	const isChromiumPdfViewer = /Chrome|Chromium|Edg\/|OPR\/|Brave/i.test(navigator.userAgent);
	if (!isChromiumPdfViewer) {
		document.querySelectorAll<HTMLAnchorElement>("[data-pdf-open]").forEach((link) => {
			link.addEventListener("click", (e) => {
				const src = link.href;
				const name = link.dataset.pdfName || "document.pdf";
				if (!src) return;
				e.preventDefault();
				// No `noopener` here specifically — per spec, window.open() returns
				// null when `noopener` is set, and this call needs a live
				// reference to navigate once the blob is ready.
				const tab = window.open("", "_blank");
				fetch(src, { mode: "cors" })
					.then((res) => {
						if (!res.ok) throw new Error(String(res.status));
						return res.blob();
					})
					.then((blob) => {
						const file = new File([blob], name, { type: "application/pdf" });
						const objectUrl = URL.createObjectURL(file);
						if (tab) tab.location.href = objectUrl;
						else window.open(objectUrl, "_blank", "noopener");
					})
					.catch(() => {
						if (tab) tab.location.href = src;
						else window.open(src, "_blank", "noopener");
					});
			});
		});
	}
</script>
