---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import { getTeam, groupByRole, ROLE_GROUPS, type TeamMember } from "../lib/team";
import { ricosToPlainText } from "../lib/ricos";

const team = await getTeam();
const grouped = groupByRole(team);
const hasAny = team.length > 0;
---

<Layout title="Meet the Team — Ra'anana Community Kollel" description="The rabbeim, kollel members, and team behind the Ra'anana Community Kollel.">
	<Nav />
	<main>
		<PageHeader
			eyebrow="Our People"
			titleNavy="Meet the Team"
			subtitle="The rabbeim, kollel members, and dedicated team behind RCK — building a Torah-centered home in Ra'anana."
		/>

		{!hasAny && (
			<section class="py-24">
				<div class="container-page text-center">
					<p class="font-sans text-sm font-bold uppercase tracking-[0.18em] text-gold-500">
						Coming soon
					</p>
					<h2 class="mt-3 font-sans text-3xl md:text-4xl font-black tracking-[-0.02em] text-navy-600">
						Team listings on the way
					</h2>
					<p class="mx-auto mt-4 max-w-xl text-base text-navy-500 leading-relaxed">
						Once the office adds team members in the Wix CMS dashboard
						(<code class="rounded bg-navy-50 px-1.5 py-0.5 text-sm">TeamMembers</code> collection),
						they'll appear here automatically.
					</p>
				</div>
			</section>
		)}

		{hasAny && (
			<>
				{ROLE_GROUPS.map((group) => {
					const members: TeamMember[] = grouped[group.key];
					if (members.length === 0) return null;

					return (
						<section class="py-16 sm:py-20 md:py-24 border-b border-navy-50 last:border-b-0">
							<div class="container-page">
								<div class="text-center mb-10 sm:mb-14">
									<p class="font-sans text-xs sm:text-sm font-bold uppercase tracking-[0.22em] text-gold-500">
										{group.label}
									</p>
									<span class="mx-auto mt-3 block h-[2px] w-12 bg-gold-400" aria-hidden="true" />
								</div>

								<div class="grid gap-6 sm:gap-7 md:gap-8 sm:grid-cols-2 lg:grid-cols-3">
									{members.map((m) => {
										const fullName = [m.firstName, m.lastName].filter(Boolean).join(" ");
										const bioText = m.bio ? ricosToPlainText(m.bio) : "";
										return (
											<article class="group rounded-2xl bg-white ring-1 ring-navy-100 overflow-hidden shadow-[0_12px_30px_-20px_rgba(15,23,42,0.25)] hover:shadow-[0_18px_40px_-20px_rgba(15,23,42,0.35)] transition-shadow">
												<div
													class="relative aspect-square w-full overflow-hidden bg-navy-50"
													style={m.photoUrl ? `` : `background: linear-gradient(135deg, #eef1f7 0%, #cfd5e3 50%, #f3e6b3 100%);`}
												>
													{m.photoUrl ? (
														<img
															src={m.photoUrl}
															alt={fullName}
															loading="lazy"
															class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
														/>
													) : (
														<div class="absolute inset-0 flex items-center justify-center">
															<span class="font-sans text-[10px] sm:text-xs uppercase tracking-[0.22em] text-navy-300">
																Photo
															</span>
														</div>
													)}
												</div>

												<div class="p-5 sm:p-6">
													<h3 class="font-sans text-xl sm:text-2xl font-black tracking-[-0.015em] text-navy-600">
														{fullName}
													</h3>
													{m.hebrewName && (
														<p
															lang="he"
															dir="rtl"
															class="mt-1 text-lg text-gold-500 font-medium"
															style="font-family: var(--font-hebrew);"
														>
															{m.hebrewName}
														</p>
													)}
													{m.role && (
														<p class="mt-2 font-sans text-[11px] sm:text-xs font-bold uppercase tracking-[0.22em] text-navy-400">
															{m.role}
														</p>
													)}
													{bioText && (
														<div class="mt-4" data-bio>
															<p
																class="text-sm sm:text-[0.9375rem] leading-relaxed text-navy-500 whitespace-pre-line line-clamp-4"
																data-bio-text
															>
																{bioText}
															</p>
															<button
																type="button"
																data-bio-toggle
																class="mt-2 inline-flex items-center gap-1 text-xs font-bold uppercase tracking-[0.18em] text-gold-500 hover:text-gold-600 transition-colors"
																hidden
															>
																<span data-bio-toggle-label>Read more</span>
																<span aria-hidden="true" data-bio-toggle-arrow>↓</span>
															</button>
														</div>
													)}
													{m.email && (
														<a
															href={`mailto:${m.email}`}
															class="mt-4 inline-flex items-center text-sm font-medium text-navy-600 hover:text-gold-500 transition-colors"
														>
															{m.email}
														</a>
													)}
												</div>
											</article>
										);
									})}
								</div>
							</div>
						</section>
					);
				})}
			</>
		)}
	</main>
	<Footer />
</Layout>

<style>
	.line-clamp-4 {
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>

<script>
	// Click-to-expand for each team-member bio. Only shows the toggle
	// button when the text is actually overflowing the clamped height,
	// so short bios don't get a useless "Read more" button.
	document.querySelectorAll<HTMLElement>("[data-bio]").forEach((root) => {
		const text = root.querySelector<HTMLElement>("[data-bio-text]");
		const toggle = root.querySelector<HTMLButtonElement>("[data-bio-toggle]");
		const label = root.querySelector<HTMLElement>("[data-bio-toggle-label]");
		const arrow = root.querySelector<HTMLElement>("[data-bio-toggle-arrow]");
		if (!text || !toggle || !label || !arrow) return;

		// Reveal the toggle only if the clamped text is actually being cut off.
		// scrollHeight > clientHeight means there's content hidden by line-clamp.
		const overflows = () => text.scrollHeight - text.clientHeight > 1;
		if (overflows()) toggle.hidden = false;

		toggle.addEventListener("click", () => {
			const expanding = text.classList.contains("line-clamp-4");
			text.classList.toggle("line-clamp-4");
			label.textContent = expanding ? "Show less" : "Read more";
			arrow.textContent = expanding ? "↑" : "↓";
		});
	});
</script>
