---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionPager from "../components/SectionPager.astro";
import { getTeam, groupByRole, ROLE_GROUPS, type TeamMember } from "../lib/team";
import { ricosToPlainText } from "../lib/ricos";

const team = await getTeam();
const grouped = groupByRole(team);
const hasAny = team.length > 0;

// Right-edge section pager — one dot per populated role group.
const visibleGroups = ROLE_GROUPS.filter((g) => grouped[g.key].length > 0);
const pagerSections = visibleGroups.map((g) => ({ id: g.key, label: g.label }));
---

<Layout>
	<Nav />
	{visibleGroups.length > 1 && <SectionPager sections={pagerSections} />}
	<main>
		<PageHeader
			titleNavy="Meet the Team"
			/>

		{!hasAny && (
			<section class="py-24">
				<div class="container-page text-center">
					<p class="font-sans text-sm font-bold uppercase tracking-[0.18em] text-gold-500">
						Coming soon
					</p>
					<h2 class="mt-3 font-display text-3xl md:text-4xl font-medium text-navy-600">
						Team listings on the way
					</h2>
					<p class="mx-auto mt-4 max-w-xl text-base text-navy-500 leading-relaxed">
						Once the office adds team members in the Wix CMS dashboard
						(<code class="rounded bg-navy-50 px-1.5 py-0.5 text-sm">TeamMembers</code> collection),
						they'll appear here automatically.
					</p>
				</div>
			</section>
		)}

		{hasAny && (
			<>
				{ROLE_GROUPS.map((group) => {
					const members: TeamMember[] = grouped[group.key];
					if (members.length === 0) return null;

					return (
						<section
							id={group.key}
							data-pager-section
							data-pager-theme="light"
							class="scroll-mt-28 py-16 sm:py-20 md:py-24 border-b border-navy-50 last:border-b-0"
						>
							<div class="container-page">
								<div class="text-center mb-10 sm:mb-14" data-reveal="up">
									<h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] font-medium uppercase text-navy-600">
										{group.label}
									</h2>
									<span class="gold-rule mx-auto mt-4" aria-hidden="true" />
								</div>

								{/* Flex-wrap instead of grid so a final short row centers
								    (grid left an orphan card hanging bottom-left). */}
								<div class="flex flex-wrap justify-center gap-6 sm:gap-7 md:gap-8">
									{members.map((m) => {
										const fullName = [m.firstName, m.lastName].filter(Boolean).join(" ");
										const bioText = m.bio ? ricosToPlainText(m.bio) : "";
										const hasBio = bioText.length > 0;
										// Monogram for members without a photo — reads as a deliberate
										// design element instead of an empty slot.
										const initials = [m.firstName, m.lastName]
											.filter(Boolean)
											.map((n) => n!.trim().charAt(0).toUpperCase())
											.join("");

										const photoMarkup = (
											<div
												class="card-photo relative aspect-square w-full overflow-hidden"
												style="background: linear-gradient(135deg, var(--color-navy-50) 0%, var(--color-navy-100) 50%, var(--color-gold-100) 100%);"
											>
												{/* Monogram fallback — always in DOM; hidden by default when a photo URL exists.
												    The img onerror makes it visible again if the CDN returns a broken response. */}
												<div
													class="monogram-fallback absolute inset-0 flex flex-col items-center justify-center gap-2"
													style={m.photoUrl ? "display:none" : ""}
												>
													<span class="font-display text-6xl sm:text-7xl font-medium text-navy-200" aria-hidden="true">
														{initials || "RCK"}
													</span>
													<span class="gold-rule-sm opacity-60" aria-hidden="true"></span>
												</div>
												{m.photoUrl && (
													<img
														src={m.photoUrl}
														alt={fullName}
														loading="lazy"
														class="card-image h-full w-full object-cover"
														onerror="this.style.display='none';this.closest('.card-photo').querySelector('.monogram-fallback').style.display=''"
													/>
												)}
												{hasBio && (
													<div class="bio-overlay absolute inset-0 flex flex-col bg-gradient-to-b from-navy-700/80 via-navy-700/75 to-navy-700/70 p-5 sm:p-6">
														<div class="bio-scroll overflow-y-auto pr-1">
															<p class="text-[0.9375rem] leading-relaxed text-white whitespace-pre-line">
																{bioText}
															</p>
														</div>
													</div>
												)}
											</div>
										);

										const metaMarkup = (
											<div class="p-5 sm:p-6">
												<h3 class="font-display text-xl sm:text-2xl font-medium text-navy-600">
													{fullName}
												</h3>
												{m.hebrewName && (
													<p
														lang="he"
														dir="rtl"
														class="mt-1 text-lg text-gold-500 font-medium"
														style="font-family: var(--font-hebrew);"
													>
														{m.hebrewName}
													</p>
												)}
												{m.role && (
													<p class="mt-2 font-sans text-[11px] sm:text-xs font-bold uppercase tracking-[0.22em] text-navy-400">
														{m.role}
													</p>
												)}
												{hasBio && (
													<span class="bio-toggle-label mt-3 inline-flex items-center gap-1 font-sans text-[11px] font-bold uppercase tracking-[0.22em] text-gold-500" aria-hidden="true"></span>
												)}
											</div>
										);

										const card = hasBio ? (
											<button
												type="button"
												data-team-card
												aria-expanded="false"
												class="team-card block h-full w-full text-left rounded-md bg-white ring-1 ring-navy-100 overflow-hidden shadow-[0_12px_30px_-20px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_45px_-22px_rgba(15,23,42,0.45)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 cursor-pointer"
											>
												{photoMarkup}
												{metaMarkup}
											</button>
										) : (
											<div class="team-card-static block h-full w-full rounded-md bg-white ring-1 ring-navy-100 overflow-hidden shadow-[0_12px_30px_-20px_rgba(15,23,42,0.25)]">
												{photoMarkup}
												{metaMarkup}
											</div>
										);

										return (
											<div class="w-full sm:w-[calc(50%-0.875rem)] md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.334rem)]">
												{card}
											</div>
										);
									})}
								</div>
							</div>
						</section>
					);
				})}
			</>
		)}
	</main>
	<Footer />
</Layout>

<style>
	/* Photo color drains to greyscale when the card is hovered (desktop)
	   or expanded (set by JS on tap/click — works for touch + as a "pin
	   open" affordance on desktop). Same trigger drives the bio overlay
	   fade-in below. See design log #008.

	   The :hover rules are gated behind @media (hover: hover) because
	   touch browsers "stick" :hover state after a tap — without the
	   gate, tapping to collapse couldn't beat the stuck hover and the
	   overlay would never close on mobile. */
	/* Photos are requested as 640×640 squares — properly-cropped uploads fill
	   the card exactly. object-fit: cover handles any minor size mismatch. */
	.card-image {
		transition: filter 400ms ease;
	}
	.bio-overlay {
		opacity: 0;
		pointer-events: none;
		transition: opacity 300ms ease;
	}

	@media (hover: hover) and (pointer: fine) {
		.team-card:hover .card-image {
			filter: grayscale(1);
		}
		.team-card:hover .bio-overlay {
			opacity: 1;
			pointer-events: auto;
		}
	}

	.team-card[aria-expanded="true"] .card-image {
		filter: grayscale(1);
	}
	.team-card[aria-expanded="true"] .bio-overlay {
		opacity: 1;
		pointer-events: auto;
	}

	/* Touch-device affordance: hover-capable devices don't need a "Read
	   bio" label because the photo greyscale + bio fade-in already
	   advertise the interaction. On touch (no hover), the card looks
	   static, so we show a small gold label that flips to "Hide bio"
	   when expanded. Hidden on hover-capable devices entirely. */
	.bio-toggle-label {
		display: none;
	}
	.bio-toggle-label::after {
		content: "Read bio";
	}
	.team-card[aria-expanded="true"] .bio-toggle-label::after {
		content: "Hide bio";
	}
	@media (hover: none), (pointer: coarse) {
		.bio-toggle-label {
			display: inline-flex;
		}
	}

	/* Tighter, kollel-tinted scrollbar inside the bio overlay so it
	   doesn't fight the navy panel. */
	.bio-scroll {
		scrollbar-width: thin;
		scrollbar-color: rgba(255, 255, 255, 0.35) transparent;
	}
	.bio-scroll::-webkit-scrollbar {
		width: 6px;
	}
	.bio-scroll::-webkit-scrollbar-thumb {
		background-color: rgba(255, 255, 255, 0.35);
		border-radius: 3px;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-team-card]").forEach((card) => {
		card.addEventListener("click", () => {
			const expanded = card.getAttribute("aria-expanded") === "true";
			card.setAttribute("aria-expanded", expanded ? "false" : "true");
		});
	});
</script>
