---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import { getTeam, groupByRole, ROLE_GROUPS, type TeamMember } from "../lib/team";
import { ricosToPlainText } from "../lib/ricos";

const team = await getTeam();
const grouped = groupByRole(team);
const hasAny = team.length > 0;

const dialogId = (m: TeamMember) => `team-dialog-${m._id}`;
---

<Layout title="Meet the Team — Ra'anana Community Kollel" description="The rabbeim, kollel members, and team behind the Ra'anana Community Kollel.">
	<Nav />
	<main>
		<PageHeader
			eyebrow="Our People"
			titleNavy="Meet the Team"
			subtitle="The rabbeim, kollel members, and dedicated team behind RCK — building a Torah-centered home in Ra'anana."
		/>

		{!hasAny && (
			<section class="py-24">
				<div class="container-page text-center">
					<p class="font-sans text-sm font-bold uppercase tracking-[0.18em] text-gold-500">
						Coming soon
					</p>
					<h2 class="mt-3 font-display text-3xl md:text-4xl font-medium text-navy-600">
						Team listings on the way
					</h2>
					<p class="mx-auto mt-4 max-w-xl text-base text-navy-500 leading-relaxed">
						Once the office adds team members in the Wix CMS dashboard
						(<code class="rounded bg-navy-50 px-1.5 py-0.5 text-sm">TeamMembers</code> collection),
						they'll appear here automatically.
					</p>
				</div>
			</section>
		)}

		{hasAny && (
			<>
				{ROLE_GROUPS.map((group) => {
					const members: TeamMember[] = grouped[group.key];
					if (members.length === 0) return null;

					return (
						<section class="py-16 sm:py-20 md:py-24 border-b border-navy-50 last:border-b-0">
							<div class="container-page">
								<div class="text-center mb-10 sm:mb-14">
									<p class="font-sans text-xs sm:text-sm font-bold uppercase tracking-[0.22em] text-gold-500">
										{group.label}
									</p>
									<span class="mx-auto mt-3 block h-[2px] w-12 bg-gold-400" aria-hidden="true" />
								</div>

								<div class="grid gap-6 sm:gap-7 md:gap-8 sm:grid-cols-2 lg:grid-cols-3">
									{members.map((m) => {
										const fullName = [m.firstName, m.lastName].filter(Boolean).join(" ");
										const id = dialogId(m);
										return (
											<button
												type="button"
												data-team-trigger={id}
												aria-haspopup="dialog"
												class="group block w-full text-left rounded-2xl bg-white ring-1 ring-navy-100 overflow-hidden shadow-[0_12px_30px_-20px_rgba(15,23,42,0.25)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_22px_45px_-22px_rgba(15,23,42,0.45)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-500 cursor-pointer"
											>
												<div
													class="relative aspect-square w-full overflow-hidden bg-navy-50"
													style={m.photoUrl ? `` : `background: linear-gradient(135deg, #eaedf3 0%, #c8cfdc 50%, #fbeaa8 100%);`}
												>
													{m.photoUrl ? (
														<img
															src={m.photoUrl}
															alt={fullName}
															loading="lazy"
															class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
														/>
													) : (
														<div class="absolute inset-0 flex items-center justify-center">
															<span class="font-sans text-[10px] sm:text-xs uppercase tracking-[0.22em] text-navy-300">
																Photo
															</span>
														</div>
													)}
													<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-700/75 via-navy-700/0 to-navy-700/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
													<div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-center pb-5 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300">
														<span class="font-sans text-[11px] font-bold uppercase tracking-[0.22em] text-white">
															View profile →
														</span>
													</div>
												</div>

												<div class="p-5 sm:p-6">
													<h3 class="font-display text-xl sm:text-2xl font-medium text-navy-600">
														{fullName}
													</h3>
													{m.hebrewName && (
														<p
															lang="he"
															dir="rtl"
															class="mt-1 text-lg text-gold-500 font-medium"
															style="font-family: var(--font-hebrew);"
														>
															{m.hebrewName}
														</p>
													)}
													{m.role && (
														<p class="mt-2 font-sans text-[11px] sm:text-xs font-bold uppercase tracking-[0.22em] text-navy-400">
															{m.role}
														</p>
													)}
												</div>
											</button>
										);
									})}
								</div>
							</div>
						</section>
					);
				})}

				{team.map((m) => {
					const fullName = [m.firstName, m.lastName].filter(Boolean).join(" ");
					const bioText = m.bio ? ricosToPlainText(m.bio) : "";
					const id = dialogId(m);
					const titleId = `${id}-title`;

					return (
						<dialog
							id={id}
							aria-labelledby={titleId}
							class="team-dialog w-[min(56rem,calc(100vw-2rem))] max-h-[calc(100vh-2rem)] overflow-hidden rounded-2xl bg-white p-0 shadow-[0_40px_80px_-30px_rgba(15,23,42,0.55)]"
						>
							<div class="relative grid md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
								<button
									type="button"
									data-dialog-close
									aria-label="Close"
									class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-navy-600 shadow-[0_8px_20px_-10px_rgba(15,23,42,0.4)] ring-1 ring-black/5 transition hover:bg-white hover:text-navy-700 focus-visible:outline-2 focus-visible:outline-gold-500"
								>
									<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
									</svg>
								</button>

								<div
									class="relative aspect-square w-full overflow-hidden md:aspect-auto md:min-h-[24rem] bg-navy-50"
									style={m.photoUrl ? `` : `background: linear-gradient(135deg, #eaedf3 0%, #c8cfdc 50%, #fbeaa8 100%);`}
								>
									{m.photoUrl ? (
										<img
											src={m.photoUrl}
											alt={fullName}
											class="h-full w-full object-cover"
										/>
									) : (
										<div class="absolute inset-0 flex items-center justify-center">
											<span class="font-sans text-xs uppercase tracking-[0.22em] text-navy-300">
												Photo
											</span>
										</div>
									)}
								</div>

								<div class="overflow-y-auto p-6 sm:p-8 md:p-10 max-h-[calc(100vh-2rem)] md:max-h-[min(85vh,40rem)]">
									<h3 id={titleId} class="font-display text-2xl sm:text-3xl md:text-[2rem] font-medium text-navy-600 leading-tight">
										{fullName}
									</h3>
									{m.hebrewName && (
										<p
											lang="he"
											dir="rtl"
											class="mt-2 text-xl text-gold-500 font-medium"
											style="font-family: var(--font-hebrew);"
										>
											{m.hebrewName}
										</p>
									)}
									{m.role && (
										<p class="mt-3 font-sans text-xs font-bold uppercase tracking-[0.22em] text-navy-400">
											{m.role}
										</p>
									)}
									{m.email && (
										<a
											href={`mailto:${m.email}`}
											class="mt-2 inline-flex items-center text-sm font-medium text-navy-600 hover:text-gold-500 transition-colors"
										>
											{m.email}
										</a>
									)}
									{bioText && (
										<div class="mt-5 sm:mt-6 border-t border-navy-50 pt-5 sm:pt-6">
											<p class="text-[0.9375rem] sm:text-base leading-relaxed text-navy-500 whitespace-pre-line">
												{bioText}
											</p>
										</div>
									)}
								</div>
							</div>
						</dialog>
					);
				})}
			</>
		)}
	</main>
	<Footer />
</Layout>

<style>
	/* Center the dialog reliably. Browsers' default UA centering for
	   showModal() depends on `margin: auto` + auto-positioning, which
	   Tailwind preflight (or scoped resets) can shadow — making the
	   dialog land in the top-left. Forcing inset:0 + margin:auto gives
	   centering regardless of resets. */
	dialog.team-dialog {
		position: fixed;
		inset: 0;
		margin: auto;
	}
	dialog.team-dialog::backdrop {
		background-color: rgba(15, 23, 42, 0.6);
		backdrop-filter: blur(4px);
	}
	body:has(dialog[open]) {
		overflow: hidden;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-team-trigger]").forEach((trigger) => {
		const id = trigger.dataset.teamTrigger;
		if (!id) return;
		const dialog = document.getElementById(id) as HTMLDialogElement | null;
		if (!dialog) return;

		trigger.addEventListener("click", () => {
			if (typeof dialog.showModal === "function") {
				dialog.showModal();
			} else {
				dialog.setAttribute("open", "");
			}
		});

		dialog.querySelector<HTMLButtonElement>("[data-dialog-close]")?.addEventListener("click", () => {
			dialog.close();
		});

		// Backdrop click — when the user clicks the dimmed area outside the
		// inner card, the click target is the <dialog> element itself.
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close();
		});
	});
</script>
