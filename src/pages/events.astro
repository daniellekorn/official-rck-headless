---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import EventArchive from "../components/EventArchive.astro";
import Flyer from "../components/Flyer.astro";
import { getFlyers, uniqueSubCategories } from "../lib/flyers";
import { getPastEvents } from "../lib/past-events";

// Lowercased to match normalized tags, so shared links survive tag-case changes in the CMS.
const selectedSub = Astro.url.searchParams.get("sub")?.toLowerCase() ?? null;

const allEvents = await getFlyers("events");
const subCategories = uniqueSubCategories(allEvents);

const pastEvents = await getPastEvents();

const gridFlyers = selectedSub
	? allEvents.filter((f) => f.subCategory?.includes(selectedSub))
	: allEvents;
---

<Layout>
	<Nav />

	<PageHeader
		titleGold="Upcoming"
		titleNavy="Events"
	/>

	<section class="py-10 sm:py-14 bg-white">
		<div class="container-page">
			{subCategories.length > 0 && (
				<div class="relative z-20 mb-10 flex justify-center" data-filter-bar>
					<div class="relative" data-dropdown>
						<button
							type="button"
							data-dropdown-toggle
							aria-expanded="false"
							aria-haspopup="true"
							class="filter-select inline-flex items-center gap-2 rounded-sm px-4 py-2 text-sm font-medium text-navy-600 transition-colors"
						>
							<span class="text-navy-400">Category:</span>
							<span class="capitalize">{selectedSub ?? "All"}</span>
							<svg
								class="filter-caret h-3 w-3 transition-transform"
								viewBox="0 0 12 12"
								fill="none"
								aria-hidden="true"
							>
								<path
									d="M2.5 4.5 6 8l3.5-3.5"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</button>
						<div
							data-dropdown-menu
							class="absolute left-1/2 top-full z-30 mt-2 hidden min-w-44 -translate-x-1/2 overflow-y-auto rounded-md bg-white p-1.5 ring-1 ring-navy-100 shadow-[0_18px_40px_-18px_rgba(7,23,58,0.35)]"
						>
							<a
								href="/events"
								class:list={[
									"filter-option flex items-center gap-2.5 rounded-sm px-2.5 py-1.5 text-sm font-medium text-navy-600 transition-colors",
									!selectedSub && "is-active",
								]}
							>
								<span class="filter-option-dot" aria-hidden="true"></span>
								All
							</a>
							{subCategories.map((sub) => (
								<a
									href={`/events?sub=${encodeURIComponent(sub)}`}
									class:list={[
										"filter-option flex items-center gap-2.5 rounded-sm px-2.5 py-1.5 text-sm font-medium capitalize text-navy-600 transition-colors",
										selectedSub === sub && "is-active",
									]}
								>
									<span class="filter-option-dot" aria-hidden="true"></span>
									{sub}
								</a>
							))}
						</div>
					</div>
				</div>
			)}

			{gridFlyers.length > 0 ? (
				<div class="relative" data-flyers-carousel>
					<div
						class="flyers-track flex gap-5 sm:gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory px-1 pb-2"
						data-flyers-track
					>
						{gridFlyers.map((flyer) => (
							<div class="w-[260px] sm:w-[320px] md:w-[380px] shrink-0 snap-start">
								<div class="rounded-md overflow-hidden bg-white ring-1 ring-navy-100 shadow-sm">
									<Flyer
										imageUrl={flyer.imageUrl}
										pdfUrl={flyer.pdfUrl}
										title={flyer.title}
									/>
									{flyer.title && (
										<div class="p-4">
											<p class="font-medium text-navy-700 text-sm">{flyer.title}</p>
										</div>
									)}
								</div>
							</div>
						))}
					</div>

					{gridFlyers.length > 1 && (
						<>
							<button
								type="button"
								data-flyers-prev
								aria-label="Previous event"
								class="absolute left-1 sm:-left-4 top-1/2 -translate-y-1/2 z-10 flex h-11 w-11 items-center justify-center rounded-sm bg-white/95 text-navy-600 ring-1 ring-navy-100 shadow-[0_10px_24px_-12px_rgba(7,23,58,0.4)] transition-colors hover:bg-gold-400"
							>
								<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</button>
							<button
								type="button"
								data-flyers-next
								aria-label="Next event"
								class="absolute right-1 sm:-right-4 top-1/2 -translate-y-1/2 z-10 flex h-11 w-11 items-center justify-center rounded-sm bg-white/95 text-navy-600 ring-1 ring-navy-100 shadow-[0_10px_24px_-12px_rgba(7,23,58,0.4)] transition-colors hover:bg-gold-400"
							>
								<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
									<path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</button>
						</>
					)}
				</div>
			) : (
				<p class="text-center text-navy-400 py-16">
					{selectedSub
						? `No events for "${selectedSub}" yet.`
						: "Stay tuned for upcoming events!"}
				</p>
			)}
		</div>
	</section>

	<EventArchive events={pastEvents} />

	{/* Discoverable cross-link to the youth page — events split by audience,
	    so someone who lands here first still finds youth-specific content.
	    Sits at the foot of the page as a hand-off, after upcoming + past. */}
	<section class="py-12 sm:py-16">
		<div class="container-page">
			<a
				href="/youth"
				class="group relative flex flex-col gap-4 overflow-hidden rounded-md bg-navy-700 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8 ring-1 ring-navy-600 transition-all hover:ring-gold-400/70 hover:shadow-[0_20px_50px_-24px_rgba(214,162,30,0.55)]"
				data-reveal="up"
			>
				<span
					class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-sm bg-gold-500/15 blur-2xl transition-opacity group-hover:opacity-100 sm:opacity-70"
					aria-hidden="true"
				></span>
				<div class="relative">
					<h2 class="font-display text-2xl sm:text-3xl font-medium text-white">
						Looking for Youth Programming?
					</h2>
					<p class="mt-2 max-w-xl text-sm sm:text-base leading-relaxed text-white/70">
						Click here for all youth and teen learning and programs.
					</p>
				</div>
				<span
					class="relative inline-flex shrink-0 items-center gap-2 self-start rounded-sm bg-gold-500 px-5 py-2.5 text-sm font-semibold text-navy-700 transition-colors group-hover:bg-gold-400 sm:self-auto"
				>
					Explore Youth Programming
				</span>
			</a>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	/* Dropdown trigger: white pill, gold ring while open. */
	.filter-select {
		background-color: #fff;
		box-shadow: inset 0 0 0 1px var(--color-navy-200, #cbd5e1);
	}
	.filter-select:hover {
		background-color: var(--color-navy-50, #f8fafc);
	}
	[data-dropdown].is-open .filter-select {
		box-shadow: inset 0 0 0 1.5px var(--color-gold-500);
	}
	[data-dropdown].is-open .filter-caret {
		transform: rotate(180deg);
	}

	/* Dropdown menu options: single-select, so the selected row gets a filled dot. */
	.filter-option:hover {
		background-color: var(--color-navy-50, #f8fafc);
	}
	.filter-option-dot {
		display: inline-flex;
		width: 0.5rem;
		height: 0.5rem;
		flex-shrink: 0;
		border-radius: 9999px;
		box-shadow: inset 0 0 0 1.5px var(--color-navy-200, #cbd5e1);
		transition: background-color 0.15s, box-shadow 0.15s;
	}
	.filter-option.is-active {
		color: var(--color-navy-900, #0f172a);
		font-weight: 600;
	}
	.filter-option.is-active .filter-option-dot {
		background-color: var(--color-gold-400);
		box-shadow: none;
	}

	/* Same native horizontal-scroll carousel as community.astro's Member
	   Spotlight — overflow-x + scroll-snap gives trackpad/wheel scrolling and
	   touch swipe for free; the scrollbar is hidden since it's not the
	   primary way anyone will actually scroll it. */
	.flyers-track {
		scrollbar-width: none;
	}
	.flyers-track::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	const bar = document.querySelector<HTMLElement>("[data-filter-bar]");
	const dropdown = bar?.querySelector<HTMLElement>("[data-dropdown]");
	const toggle = dropdown?.querySelector<HTMLButtonElement>("[data-dropdown-toggle]");
	const menu = dropdown?.querySelector<HTMLElement>("[data-dropdown-menu]");

	if (bar && dropdown && toggle && menu) {
		const close = () => {
			dropdown.classList.remove("is-open");
			menu.classList.add("hidden");
			toggle.setAttribute("aria-expanded", "false");
		};
		const open = () => {
			dropdown.classList.add("is-open");
			menu.classList.remove("hidden");
			toggle.setAttribute("aria-expanded", "true");
		};

		toggle.addEventListener("click", () => {
			dropdown.classList.contains("is-open") ? close() : open();
		});
		document.addEventListener("click", (e) => {
			if (!(e.target instanceof Node) || !bar.contains(e.target)) close();
		});
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") close();
		});
	}

	// Flyers carousel: same infinite-loop technique as community.astro's Member
	// Spotlight — clone the full card set once before and once after the real
	// ones, so there's always more (visually identical) content to scroll into
	// in either direction. Once scroll drifts a full "real set" width past
	// either edge, jump back by that width with no animation; since the clone
	// is pixel-identical at that position, the jump is invisible. Skipped for
	// 4 or fewer flyers — a short row doesn't need to loop, and looping a row
	// that barely fills the viewport made the wrap-around too noticeable.
	const LOOP_MIN = 4;
	document.querySelectorAll<HTMLElement>("[data-flyers-carousel]").forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>("[data-flyers-track]");
		if (!track) return;

		const originals = Array.from(track.children) as HTMLElement[];
		if (originals.length <= LOOP_MIN) return;

		const cloneSet = () =>
			originals.map((el) => {
				const clone = el.cloneNode(true) as HTMLElement;
				clone.setAttribute("aria-hidden", "true");
				clone.setAttribute("inert", "");
				return clone;
			});
		track.prepend(...cloneSet());
		track.append(...cloneSet());

		const firstReal = originals[0];
		const firstAfterClone = track.children[track.children.length - originals.length] as HTMLElement;
		const realWidth = firstAfterClone.getBoundingClientRect().left - firstReal.getBoundingClientRect().left;
		const startOffset = firstReal.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;

		// The track has scroll-smooth, which a plain `scrollLeft =` assignment
		// would inherit — the initial jump to the real cards must use
		// scrollTo({ behavior: "instant" }) to override that.
		track.scrollTo({ left: startOffset, behavior: "instant" });

		// Only re-anchor once scrolling has fully settled (debounced on every
		// `scroll` tick) — correcting mid-gesture fights whatever's driving the
		// scroll (momentum, swipe, or the arrow buttons' own smooth scrollBy)
		// and shows up as stutter. EDGE_SLACK absorbs the sub-pixel gap between
		// the getBoundingClientRect-derived thresholds and the browser's own
		// rounded settled position.
		const EDGE_SLACK = 4;
		const SETTLE_DELAY = 120;
		let settleTimer: ReturnType<typeof setTimeout> | undefined;
		track.addEventListener("scroll", () => {
			clearTimeout(settleTimer);
			settleTimer = setTimeout(() => {
				if (track.scrollLeft >= startOffset + realWidth - EDGE_SLACK) {
					track.scrollTo({ left: track.scrollLeft - realWidth, behavior: "instant" });
				} else if (track.scrollLeft <= startOffset - EDGE_SLACK) {
					track.scrollTo({ left: track.scrollLeft + realWidth, behavior: "instant" });
				}
			}, SETTLE_DELAY);
		}, { passive: true });
	});

	// Flyers carousel: arrow buttons nudge native scroll by one card's width.
	// Trackpad/wheel scrolling and touch swipe already work with no JS at all
	// (plain overflow-x + scroll-snap) — this just adds a click target. Never
	// disabled: with more than LOOP_MIN flyers the carousel above loops
	// infinitely in both directions; at or below that count there's nothing to
	// loop, so an arrow at either end just stops scrolling, same as any plain
	// scroll container.
	document.querySelectorAll<HTMLElement>("[data-flyers-carousel]").forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>("[data-flyers-track]");
		const prevBtn = carousel.querySelector<HTMLButtonElement>("[data-flyers-prev]");
		const nextBtn = carousel.querySelector<HTMLButtonElement>("[data-flyers-next]");
		if (!track) return;

		const scrollByCard = (dir: 1 | -1) => {
			const card = track.firstElementChild as HTMLElement | null;
			const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
			const delta = card ? card.getBoundingClientRect().width + gap : track.clientWidth * 0.8;
			track.scrollBy({ left: dir * delta, behavior: "smooth" });
		};

		prevBtn?.addEventListener("click", () => scrollByCard(-1));
		nextBtn?.addEventListener("click", () => scrollByCard(1));
	});
</script>
