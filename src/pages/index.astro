---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import SplitFeature from "../components/SplitFeature.astro";
import JoinUs from "../components/JoinUs.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import Footer from "../components/Footer.astro";

import { getHomePage } from "../lib/homepage";
import { getHomepageSlides } from "../lib/homepage-slides";
import { getJoinUsCards } from "../lib/join-us-cards";

const [homepage, slides, joinUsCards] = await Promise.all([
	getHomePage(),
	getHomepageSlides(),
	getJoinUsCards(),
]);

// Defaults to keep the page rendering identically before the CMS is populated.
const uniqueImpactful = {
	eyebrowGold: homepage?.uniqueImpactfulEyebrowGold ?? "UNIQUE",
	eyebrowNavy: homepage?.uniqueImpactfulEyebrowNavy ?? "IMPACTFUL",
	subheadLine1: homepage?.uniqueImpactfulTitleLine1 ?? "A Community Kollel",
	subheadLine2: homepage?.uniqueImpactfulTitleLine2 ?? "in Israel",
	body:
		homepage?.uniqueImpactfulBody ??
		"Where the depth of Torah meets the warmth of community, the Ra'anana Community Kollel is building something distinct in Israel — inspiring Jewish growth, meaningful connection, and a vibrant Torah-centered home for the Anglo community and beyond.",
	imageUrl: homepage?.uniqueImpactfulImageUrl,
};

const torahVision = {
	eyebrowGold: homepage?.torahVisionEyebrowGold ?? "TORAH",
	eyebrowNavy: homepage?.torahVisionEyebrowNavy ?? "VISION",
	subheadLine1: homepage?.torahVisionTitleLine1 ?? "A Kollel Dedicated to",
	subheadLine2: homepage?.torahVisionTitleLine2 ?? "Torah and Growth",
	body:
		homepage?.torahVisionBody ??
		"At RCK, we believe that everyone can grow — grow in their connection to Torah, Hashem, self, and community. Everyone can learn. Everyone can connect.",
	imageUrl: homepage?.torahVisionImageUrl,
};
---

<Layout>
	<Nav />
	<main>
		<Hero
			eyebrow={homepage?.heroEyebrow}
			title={homepage?.heroTitle}
			subtitle={homepage?.heroSubtitle}
			imageUrl={homepage?.heroImageUrl}
			primaryCtaLabel={homepage?.heroPrimaryCtaLabel}
			primaryCtaHref={homepage?.heroPrimaryCtaHref}
			secondaryCtaLabel={homepage?.heroSecondaryCtaLabel}
			secondaryCtaHref={homepage?.heroSecondaryCtaHref}
		/>

		<SplitFeature
			eyebrowGold={uniqueImpactful.eyebrowGold}
			eyebrowNavy={uniqueImpactful.eyebrowNavy}
			subheadLine1={uniqueImpactful.subheadLine1}
			subheadLine2={uniqueImpactful.subheadLine2}
			subheadAccent="line2"
			body={uniqueImpactful.body}
			imageOn="left"
			imageUrl={uniqueImpactful.imageUrl}
		/>

		<JoinUs cards={joinUsCards.map((c) => ({ title: c.title, subtitle: c.subtitle, href: c.href, icon: c.icon }))} />

		<SplitFeature
			eyebrowGold={torahVision.eyebrowGold}
			eyebrowNavy={torahVision.eyebrowNavy}
			subheadLine1={torahVision.subheadLine1}
			subheadLine2={torahVision.subheadLine2}
			subheadAccent="line2"
			body={torahVision.body}
			imageOn="left"
			imageUrl={torahVision.imageUrl}
		/>

		<WhoWeAre
			title={homepage?.whoWeAreTitle}
			hebrew={homepage?.whoWeAreHebrew}
			body={homepage?.whoWeAreBody}
			slides={slides.map((s) => ({ title: s.title, caption: s.caption, imageUrl: s.imageUrl }))}
		/>
	</main>
	<Footer />
</Layout>
