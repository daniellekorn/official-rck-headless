---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import SplitFeature from "../components/SplitFeature.astro";
import JoinUs from "../components/JoinUs.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import SectionPager from "../components/SectionPager.astro";
import Footer from "../components/Footer.astro";

// Right-edge section pager (desktop). ids/themes are mirrored onto the
// section wrappers below so the dots can scroll-spy and recolor per section.
const pagerSections = [
	{ id: "welcome", label: "Welcome" },
	{ id: "about", label: "About" },
	{ id: "join", label: "Join Us" },
	{ id: "vision", label: "Vision" },
	{ id: "history", label: "History" },
];

import { getHomepage, normalizeImageOn, normalizeAccentLine } from "../lib/homepage";
import { getHistory } from "../lib/history";

const [homepage, history] = await Promise.all([
	getHomepage(),
	getHistory(),
]);

// The two stacked "image + text" bands. Named by position, not content
// (see design-log/019). Defaults keep the page rendering identically before
// the CMS is populated.
const imageTextSection1 = {
	eyebrowGold: homepage?.imageTextSection1EyebrowGold ?? "UNIQUE",
	eyebrowNavy: homepage?.imageTextSection1EyebrowNavy ?? "IMPACTFUL",
	subheadLine1: homepage?.imageTextSection1TitleLine1 ?? "A Community Kollel",
	subheadLine2: homepage?.imageTextSection1TitleLine2 ?? "in Israel",
	body:
		homepage?.imageTextSection1Body ??
		"Where the depth of Torah meets the warmth of community, RCK is building something distinct in Israel — inspiring Jewish growth, meaningful connection, and a vibrant Torah-centered home for the Anglo community and beyond.",
	imageUrl: homepage?.imageTextSection1ImageUrl,
	imageOn: normalizeImageOn(homepage?.imageTextSection1ImageOn, "left"),
	accentLine: normalizeAccentLine(homepage?.imageTextSection1AccentLine, "line2"),
};

const imageTextSection2 = {
	eyebrowGold: homepage?.imageTextSection2EyebrowGold ?? "TORAH",
	eyebrowNavy: homepage?.imageTextSection2EyebrowNavy ?? "VISION",
	subheadLine1: homepage?.imageTextSection2TitleLine1 ?? "A Kollel Dedicated to",
	subheadLine2: homepage?.imageTextSection2TitleLine2 ?? "Torah and Growth",
	body:
		homepage?.imageTextSection2Body ??
		"At RCK, we believe that everyone can grow — grow in their connection to Torah, Hashem, self, and community. Everyone can learn. Everyone can connect.",
	imageUrl: homepage?.imageTextSection2ImageUrl,
	imageOn: normalizeImageOn(homepage?.imageTextSection2ImageOn, "right"),
	accentLine: normalizeAccentLine(homepage?.imageTextSection2AccentLine, "line2"),
};
---

<Layout>
	<Nav />
	<SectionPager sections={pagerSections} />
	<main>
		<div id="welcome" data-pager-section data-pager-theme="dark">
			<Hero
				eyebrow={homepage?.heroEyebrow}
				subtitle={homepage?.heroSubtitle}
				imageUrl={homepage?.heroImageUrl}
				primaryCtaLabel={homepage?.heroPrimaryCtaLabel}
				primaryCtaHref={homepage?.heroPrimaryCtaHref}
				secondaryCtaLabel={homepage?.heroSecondaryCtaLabel}
				secondaryCtaHref={homepage?.heroSecondaryCtaHref}
			/>
		</div>

		<div id="about" data-pager-section data-pager-theme="light" data-section-reveal class="scroll-mt-24">
			<SplitFeature
				eyebrowGold={imageTextSection1.eyebrowGold}
				eyebrowNavy={imageTextSection1.eyebrowNavy}
				subheadLine1={imageTextSection1.subheadLine1}
				subheadLine2={imageTextSection1.subheadLine2}
				subheadAccent={imageTextSection1.accentLine}
				body={imageTextSection1.body}
				imageOn={imageTextSection1.imageOn}
				imageUrl={imageTextSection1.imageUrl}
				rays
			/>
		</div>

		<div id="join" data-pager-section data-pager-theme="dark" data-section-reveal class="scroll-mt-24">
			<JoinUs
				cards={[
					{ title: homepage?.joinUsCard1Title, subtitle: homepage?.joinUsCard1Subtitle, href: homepage?.joinUsCard1Href, icon: homepage?.joinUsCard1Icon as "book" | "reader" | "people" | "minyan" | undefined },
					{ title: homepage?.joinUsCard2Title, subtitle: homepage?.joinUsCard2Subtitle, href: homepage?.joinUsCard2Href, icon: homepage?.joinUsCard2Icon as "book" | "reader" | "people" | "minyan" | undefined },
					{ title: homepage?.joinUsCard3Title, subtitle: homepage?.joinUsCard3Subtitle, href: homepage?.joinUsCard3Href, icon: homepage?.joinUsCard3Icon as "book" | "reader" | "people" | "minyan" | undefined },
				].filter((c) => c.title)}
			/>
		</div>

		<div id="vision" data-pager-section data-pager-theme="light" data-section-reveal class="scroll-mt-24">
			<SplitFeature
				eyebrowGold={imageTextSection2.eyebrowGold}
				eyebrowNavy={imageTextSection2.eyebrowNavy}
				subheadLine1={imageTextSection2.subheadLine1}
				subheadLine2={imageTextSection2.subheadLine2}
				subheadAccent={imageTextSection2.accentLine}
				body={imageTextSection2.body}
				imageOn={imageTextSection2.imageOn}
				imageUrl={imageTextSection2.imageUrl}
				rays
			/>
		</div>

		<div id="history" data-pager-section data-pager-theme="dark" data-section-reveal class="scroll-mt-24">
			<WhoWeAre
				title={homepage?.whoWeAreTitle}
				hebrew={homepage?.whoWeAreHebrew}
				body={homepage?.whoWeAreBody}
				entries={history.map((h) => ({ year: h.year, title: h.title, caption: h.caption, imageUrl: h.imageUrl }))}
			/>
		</div>
	</main>
	<Footer />
</Layout>

<script>
	// Motion-driven section reveal: each wrapper glides up as it enters view.
	// Transform-only (no opacity) so it layers over — rather than fights — the
	// per-element CSS reveals (data-reveal) already inside each section.
	import { animate, inView } from "motion";

	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const wrappers = document.querySelectorAll<HTMLElement>("[data-section-reveal]");

	if (!reduce && wrappers.length) {
		wrappers.forEach((el) => {
			el.style.transform = "translateY(56px)";
			el.style.willChange = "transform";
		});
		inView(
			"[data-section-reveal]",
			(element) => {
				animate(
					element,
					{ transform: ["translateY(56px)", "translateY(0px)"] },
					{ duration: 0.9, ease: [0.16, 1, 0.3, 1] },
				);
			},
			{ amount: 0.18 },
		);
	}
</script>
