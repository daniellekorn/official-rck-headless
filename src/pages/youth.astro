---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import SectionPager from "../components/SectionPager.astro";
import Flyer from "../components/Flyer.astro";
import { getYouthPrograms } from "../lib/youth-programs";
import { ricosToPlainText } from "../lib/ricos";

// Each program is its own stacked section: always a title + description and a
// contact rabbi, optionally a photo and/or a flyer. See design log #017.
const programs = await getYouthPrograms();

// Right-edge section pager — one dot per program, jumping to its anchor.
const pagerSections = programs.map((p) => ({ id: p.slug, label: p.title }));
---

<Layout>
	<Nav />
	{programs.length > 1 && <SectionPager sections={pagerSections} />}

	<PageHeader
		titleGold="Youth"
		titleNavy="Programming"
		subtitle="Chaburos, teen learning, and programs that build the next generation of bnei and bnos Torah in Ra'anana — each led by a rabbi you can reach directly."
	/>

	{programs.length > 0 ? (
		<div>
			{programs.map((program, i) => {
				const description = program.description ? ricosToPlainText(program.description) : "";
				const hasPhotos = program.galleryUrls.length > 0;
				const hasContact = Boolean(program.contactName || program.contactEmail);
				// Pre-filled, locked subject for the Contact page so the office knows
				// which program (and rabbi) the inquiry is about.
				const inquirySubject = program.contactName
					? `For ${program.contactName}: Inquiry about ${program.title}`
					: `Inquiry about ${program.title}`;
				// Alternate a warm off-white band against white for rhythm.
				const banded = i % 2 === 1;
				// Alternate the flyer's side per program for a more stylish rhythm.
				const flyerLeft = i % 2 === 0;

				return (
					<section
						id={program.slug}
						data-pager-section
						data-pager-theme="light"
						class:list={["scroll-mt-28 py-16 sm:py-20 md:py-24", banded && "bg-mist"]}
					>
						<div class="container-page">
							{/* Header */}
							<div data-reveal="up">
								<h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] font-medium uppercase text-navy-600">
									{program.title}
								</h2>
								<span class="gold-rule-sm mt-5" aria-hidden="true"></span>
							</div>

							{/* Flyer + description/contact — two columns, alternating sides.
							    Every program shows a flyer slot; one without an uploaded
							    image renders a "coming soon" placeholder (see #031).
							    A program with no description collapses to one centered
							    column — a lone contact card next to a tall flyer reads
							    as a half-empty page, not a layout. */}
							<div
								class:list={[
									"mt-10 sm:mt-12",
									description
										? "grid items-start gap-10 md:gap-14 lg:gap-20 md:grid-cols-2"
										: "flex flex-col items-center gap-8",
								]}
							>
								<div
									class:list={["flex w-full justify-center", description && (flyerLeft ? "md:order-1" : "md:order-2")]}
									data-reveal={description ? (flyerLeft ? "left" : "right") : "up"}
								>
									<div
										class:list={[
											// Same cap regardless of whether the program also has a
											// photo gallery below — a program without one used to
											// get a bigger flyer, but that meant two programs of the
											// same type (e.g. Dor L'Dor for boys vs. girls) rendered
											// at different sizes purely because one had photos.
											"w-full max-w-sm overflow-hidden rounded-md bg-navy-800 ring-1 ring-navy-100 shadow-[0_30px_64px_-34px_rgba(7,23,58,0.55)]",
										]}
									>
										<Flyer
											imageUrl={program.flyerImageUrl}
											pdfUrl={program.flyerPdfUrl}
											title={program.title}
											aspectRatio={program.flyerAspect}
										/>
									</div>
								</div>

								<div
									class:list={[description && (flyerLeft ? "md:order-2" : "md:order-1")]}
									data-reveal={description ? (flyerLeft ? "right" : "left") : "up"}
								>
									{description && (
										<p class="max-w-prose text-base md:text-[1.0625rem] leading-relaxed text-navy-500 whitespace-pre-line">
											{description}
										</p>
									)}

									{hasContact && (
										<div
											class:list={[
												"inline-flex flex-col gap-3 rounded-md bg-white p-5 sm:p-6 ring-1 ring-navy-100 shadow-[0_12px_30px_-20px_rgba(15,23,42,0.25)]",
												description && "mt-8",
											]}
										>
											<p class="font-sans text-[11px] font-bold uppercase tracking-[0.22em] text-navy-300">
												Program Contact
											</p>
											{program.contactName && (
												<p class="font-display text-xl font-medium text-navy-700">
													{program.contactName}
												</p>
											)}
											<div class="flex flex-wrap items-center gap-3">
												{program.contactEmail && (
													<a
														href={`mailto:${program.contactEmail}`}
														class="inline-flex items-center gap-2 text-sm font-medium text-navy-500 transition-colors hover:text-gold-600"
													>
														<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
															<rect x="3" y="5" width="18" height="14" rx="2" />
															<path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
														</svg>
														Email
													</a>
												)}
												<a
													href={`/contact?subject=${encodeURIComponent(inquirySubject)}`}
													class="inline-flex items-center gap-1.5 rounded-sm bg-gold-500 px-4 py-1.5 text-sm font-semibold text-navy-700 transition-colors hover:bg-gold-400"
												>
													Contact
												</a>
											</div>
										</div>
									)}
								</div>
							</div>

							{/* Program photos below, capped narrower than the full container —
							    at full page width these read as oversized next to the more
							    modestly-sized flyer/description content above them. */}
							{hasPhotos && (
								<div class="mt-12 sm:mt-14 mx-auto max-w-2xl" data-reveal="up" data-reveal-delay="120">
									<PhotoGallery images={program.galleryUrls} label={program.title} />
								</div>
							)}
						</div>
					</section>
				);
			})}
		</div>
	) : (
		<section class="py-24">
			<div class="container-page text-center">
				<p class="eyebrow text-gold-500">Coming soon</p>
				<h2 class="mt-3 font-display text-3xl md:text-4xl font-medium text-navy-600">
					Youth programming on the way
				</h2>
				<p class="mx-auto mt-4 max-w-xl text-base text-navy-500 leading-relaxed">
					Each program (added to the
					<code class="rounded bg-navy-50 px-1.5 py-0.5 text-sm">YouthPrograms</code>
					collection — title, description, contact rabbi, and an optional photo or
					flyer) will appear here automatically once the office adds it.
				</p>
			</div>
		</section>
	)}

	<Footer />
</Layout>
