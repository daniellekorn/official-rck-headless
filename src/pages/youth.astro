---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { getYouthPrograms, hasFlyer } from "../lib/youth-programs";
import { ricosToPlainText } from "../lib/ricos";

// Each program is its own stacked section: always a title + description and a
// contact rabbi, optionally a photo and/or a flyer. See design log #017.
const programs = await getYouthPrograms();
---

<Layout
	title="Youth Programming — RCK"
	description="Chaburos, teen learning, and youth programs at RCK — The Ra'anana Community Kollel. Each program with its own info and contact rabbi."
>
	<Nav />

	<PageHeader
		eyebrow="YOUTH"
		titleGold="Youth"
		titleNavy="Programming"
		subtitle="Chaburos, teen learning, and programs that build the next generation of bnei and bnos Torah in Ra'anana — each led by a rabbi you can reach directly."
	/>

	{programs.length > 0 ? (
		<div>
			{programs.map((program, i) => {
				const description = program.description ? ricosToPlainText(program.description) : "";
				const flyer = hasFlyer(program);
				const hasPhotos = program.galleryUrls.length > 0;
				const hasContact = Boolean(program.contactName || program.contactEmail);
				// Alternate a warm off-white band against white for rhythm.
				const banded = i % 2 === 1;

				return (
					<section class:list={["py-16 sm:py-20 md:py-24", banded && "bg-mist"]}>
						<div class="container-page">
							{/* Header: title block left, contact card right (stacks on mobile) */}
							<div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-12">
								<div data-reveal="up">
									<p class="eyebrow text-gold-500">
										{String(i + 1).padStart(2, "0")} · Youth Program
									</p>
									<h2 class="mt-3 font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] font-medium uppercase text-navy-600">
										{program.title}
									</h2>
									<span class="mt-5 block h-[2px] w-14 bg-gold-400" aria-hidden="true"></span>
								</div>

								{hasContact && (
									<div
										class="w-full md:w-auto md:shrink-0 flex flex-col gap-3 rounded-2xl bg-white p-5 sm:p-6 ring-1 ring-navy-100 shadow-[0_12px_30px_-20px_rgba(15,23,42,0.25)]"
										data-reveal="up"
										data-reveal-delay="120"
									>
										<p class="font-sans text-[11px] font-bold uppercase tracking-[0.22em] text-navy-300">
											Program Contact
										</p>
										{program.contactName && (
											<p class="font-display text-xl font-medium text-navy-700">
												{program.contactName}
											</p>
										)}
										<div class="flex flex-wrap items-center gap-3">
											{program.contactEmail && (
												<a
													href={`mailto:${program.contactEmail}`}
													class="inline-flex items-center gap-2 text-sm font-medium text-navy-500 transition-colors hover:text-gold-600"
												>
													<svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
														<rect x="3" y="5" width="18" height="14" rx="2" />
														<path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round" />
													</svg>
													Email
												</a>
											)}
											<a
												href="/contact"
												class="inline-flex items-center gap-1.5 rounded-full bg-gold-500 px-4 py-1.5 text-sm font-semibold text-navy-700 transition-colors hover:bg-gold-400"
											>
												Contact
												<svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
													<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
												</svg>
											</a>
										</div>
									</div>
								)}
							</div>

							{description && (
								<p
									class="mt-8 max-w-3xl text-base md:text-[1.0625rem] leading-relaxed text-navy-500 whitespace-pre-line"
									data-reveal="up"
									data-reveal-delay="160"
								>
									{description}
								</p>
							)}

							{/* Gallery: adaptive — feature / pair / mosaic / slideshow */}
							{hasPhotos && (
								<div class="mt-10 sm:mt-12" data-reveal="up" data-reveal-delay="200">
									<PhotoGallery images={program.galleryUrls} label={program.title} />
								</div>
							)}

							{/* Flyer: contained frame, not full bleed */}
							{flyer && (
								<div class="mt-10 max-w-sm" data-reveal="up" data-reveal-delay="200">
									<div class="overflow-hidden rounded-2xl bg-navy-800 ring-1 ring-navy-100 shadow-lg">
										<div class="relative aspect-[3/4]">
											{program.flyerImageUrl ? (
												<img
													src={program.flyerImageUrl}
													alt={`${program.title} flyer`}
													loading="lazy"
													class="absolute inset-0 h-full w-full object-contain"
												/>
											) : program.flyerEmbedUrl ? (
												<iframe
													src={program.flyerEmbedUrl}
													title={`${program.title} flyer`}
													loading="lazy"
													allow="fullscreen"
													class="absolute inset-0 h-full w-full border-0"
												/>
											) : program.flyerPdfUrl ? (
												<iframe
													src={`https://docs.google.com/viewer?url=${encodeURIComponent(program.flyerPdfUrl)}&embedded=true`}
													title={`${program.title} flyer`}
													loading="lazy"
													class="absolute inset-0 h-full w-full border-0"
												/>
											) : null}
										</div>
									</div>
								</div>
							)}
						</div>
					</section>
				);
			})}
		</div>
	) : (
		<section class="py-24">
			<div class="container-page text-center">
				<p class="eyebrow text-gold-500">Coming soon</p>
				<h2 class="mt-3 font-display text-3xl md:text-4xl font-medium text-navy-600">
					Youth programming on the way
				</h2>
				<p class="mx-auto mt-4 max-w-xl text-base text-navy-500 leading-relaxed">
					Each program (added to the
					<code class="rounded bg-navy-50 px-1.5 py-0.5 text-sm">YouthPrograms</code>
					collection — title, description, contact rabbi, and an optional photo or
					flyer) will appear here automatically once the office adds it.
				</p>
			</div>
		</section>
	)}

	<Footer />
</Layout>
