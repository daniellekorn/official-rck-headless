---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import PageHeader from "../components/PageHeader.astro";
import Footer from "../components/Footer.astro";
import { getContactInfo } from "../lib/contact-info";
import { googleMapsUrl } from "../lib/maps";

const contact = await getContactInfo();

const mapSrc = contact?.address
	? `https://maps.google.com/maps?q=${encodeURIComponent(contact.address)}&output=embed&z=15`
	: null;

// When arriving from a program's "Contact" button (e.g. the Youth page), the
// subject is supplied via ?subject= and shown locked so the inquiry stays
// tied to that program/rabbi. `readonly` (not `disabled`) keeps the value in
// the form submission so the office still receives it.
const prefillSubject = Astro.url.searchParams.get("subject")?.trim() ?? "";
const lockedSubject = prefillSubject.length > 0;

const field =
	"mt-1.5 w-full rounded-sm border border-navy-200 bg-white px-3.5 py-2.5 text-navy-700 placeholder-navy-300 transition-colors focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-200";
const label = "block text-sm font-medium text-navy-600";
---

<Layout>
	<Nav />
	<main>
		<PageHeader eyebrow="Get in Touch" titleNavy="Contact Us" />

		<section class="pt-10 pb-2 text-center">
			<div class="container-page">
				<p
					class="mx-auto max-w-2xl font-display text-2xl sm:text-3xl md:text-[2rem] font-medium leading-snug text-navy-600"
					data-reveal="up"
				>
					Want to get involved? Looking to learn?
					<span class="mt-2 block text-gold-500">We want to hear from you!</span>
				</p>
			</div>
		</section>

		<section class="py-14 sm:py-20">
			<div class="container-page">
				<div class="grid gap-10 md:gap-14 lg:grid-cols-12 items-start">
					<!-- Contact info -->
					<div class="lg:col-span-5" data-reveal="left">
						<h2 class="font-display text-2xl md:text-3xl font-medium uppercase text-navy-600">
							Reach Us
						</h2>
						<span class="gold-rule-sm mt-4" aria-hidden="true"></span>

						<div class="mt-7 flex flex-col gap-5">
							{contact?.phone && (
								<a
									href={`tel:${contact.phone.replace(/[\s\-]/g, "")}`}
									class="group flex items-center gap-4 text-navy-600 transition-colors hover:text-gold-600"
								>
									<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm bg-gold-100 text-gold-600 transition-colors group-hover:bg-gold-500 group-hover:text-white">
										<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
											<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.9.7A2 2 0 0 1 22 16.9Z" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
									<span>
										<span class="block text-xs font-semibold uppercase tracking-widest text-navy-400">Phone</span>
										<span class="text-base font-medium">{contact.phone}</span>
									</span>
								</a>
							)}

							{contact?.email && (
								<a
									href={`mailto:${contact.email}`}
									class="group flex items-center gap-4 text-navy-600 transition-colors hover:text-gold-600"
								>
									<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm bg-gold-100 text-gold-600 transition-colors group-hover:bg-gold-500 group-hover:text-white">
										<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
											<rect x="2" y="4" width="20" height="16" rx="2" />
											<path d="m2 7 10 7 10-7" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
									<span>
										<span class="block text-xs font-semibold uppercase tracking-widest text-navy-400">Email</span>
										<span class="text-base font-medium break-all">{contact.email}</span>
									</span>
								</a>
							)}

							{contact?.address && (
								<div class="flex items-start gap-4 text-navy-600">
									<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-sm bg-gold-100 text-gold-600">
										<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
											<path d="M12 21s-8-7.3-8-12a8 8 0 1 1 16 0c0 4.7-8 12-8 12Z" stroke-linecap="round" stroke-linejoin="round" />
											<circle cx="12" cy="9" r="2.5" />
										</svg>
									</span>
									<span>
										<span class="block text-xs font-semibold uppercase tracking-widest text-navy-400">Address</span>
										<address class="not-italic">
											<a href={googleMapsUrl(contact.address)} target="_blank" rel="noopener noreferrer" class="text-base font-medium leading-snug hover:text-gold-600 hover:underline">
												{contact.address}
											</a>
										</address>
									</span>
								</div>
							)}

							{mapSrc && (
								<div class="mt-1 w-full max-w-xs overflow-hidden rounded-md ring-1 ring-navy-100 shadow-sm">
									<iframe
										src={mapSrc}
										class="block aspect-square w-full"
										style="border:0;"
										loading="lazy"
										referrerpolicy="no-referrer-when-downgrade"
										title="RCK location map"
										aria-label="Map showing RCK location"
									></iframe>
								</div>
							)}
						</div>
					</div>

					<!-- Form -->
					<div class="lg:col-span-7" data-reveal="up" data-reveal-delay="120">
						<form
							data-contact-form
							novalidate
							class="rounded-md bg-mist p-6 sm:p-8 ring-1 ring-navy-100"
						>
							<div class="grid gap-5 sm:grid-cols-2">
								<div>
									<label class={label} for="firstName">First name *</label>
									<input class={field} id="firstName" name="firstName" type="text" autocomplete="given-name" required />
									<p class="mt-1 hidden text-sm text-red-600" data-error-for="firstName"></p>
								</div>
								<div>
									<label class={label} for="lastName">Last name *</label>
									<input class={field} id="lastName" name="lastName" type="text" autocomplete="family-name" required />
									<p class="mt-1 hidden text-sm text-red-600" data-error-for="lastName"></p>
								</div>
								<div>
									<label class={label} for="email">Email *</label>
									<input class={field} id="email" name="email" type="email" autocomplete="email" required />
									<p class="mt-1 hidden text-sm text-red-600" data-error-for="email"></p>
								</div>
								<div>
									<label class={label} for="phone">Phone *</label>
									<input class={field} id="phone" name="phone" type="tel" autocomplete="tel" required />
									<p class="mt-1 hidden text-sm text-red-600" data-error-for="phone"></p>
								</div>
								<div class="sm:col-span-2">
									<label class={label} for="subject">Subject</label>
									<input
										class={lockedSubject ? `${field.replace("bg-white", "bg-navy-50")} cursor-not-allowed text-navy-500` : field}
										id="subject"
										name="subject"
										type="text"
										autocomplete="off"
										placeholder="What's this about?"
										value={prefillSubject || undefined}
										readonly={lockedSubject || undefined}
										aria-readonly={lockedSubject || undefined}
										title={lockedSubject ? "Subject set from the program you're contacting" : undefined}
									/>
								</div>
								<div class="sm:col-span-2">
									<label class={label} for="message">Message</label>
									<textarea class={`${field} resize-y min-h-32`} id="message" name="message" rows="5"></textarea>
								</div>
							</div>

							<!-- Honeypot: hidden from users, catches bots. -->
							<div class="hidden" aria-hidden="true">
								<label>Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
							</div>

							<div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-4">
								<button
									type="submit"
									data-submit
									class="inline-flex items-center justify-center rounded-sm bg-gold-500 px-7 py-3 text-sm font-semibold uppercase tracking-[0.16em] text-navy-700 shadow-sm transition-all hover:bg-gold-400 hover:shadow-md disabled:cursor-not-allowed disabled:opacity-60"
								>
									<span data-submit-label>Send Message</span>
								</button>
								<p class="text-sm" role="status" aria-live="polite" data-form-status></p>
							</div>
						</form>
					</div>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
	if (form) {
		const btn = form.querySelector<HTMLButtonElement>("[data-submit]");
		const btnLabel = form.querySelector<HTMLElement>("[data-submit-label]");
		const status = form.querySelector<HTMLElement>("[data-form-status]");
		const fieldErrors = form.querySelectorAll<HTMLElement>("[data-error-for]");

		const clearErrors = () => {
			fieldErrors.forEach((el) => {
				el.textContent = "";
				el.classList.add("hidden");
			});
			if (status) {
				status.textContent = "";
				status.className = "text-sm";
			}
		};

		const showFieldErrors = (errs: Record<string, string>) => {
			Object.entries(errs).forEach(([name, msg]) => {
				const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
				if (el) {
					el.textContent = msg;
					el.classList.remove("hidden");
				}
			});
		};

		const setStatus = (msg: string, ok: boolean) => {
			if (!status) return;
			status.textContent = msg;
			status.className = `text-sm ${ok ? "text-green-700" : "text-red-600"}`;
		};

		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			clearErrors();

			const data = Object.fromEntries(new FormData(form).entries());

			if (btn) btn.disabled = true;
			if (btnLabel) btnLabel.textContent = "Sending…";

			try {
				const res = await fetch("/api/contact", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(data),
				});
				const body = await res.json().catch(() => ({}));

				if (res.ok && body.ok) {
					form.reset();
					setStatus("Thank you! We'll be in touch soon.", true);
				} else if (res.status === 422 && body.fields) {
					showFieldErrors(body.fields);
					setStatus(body.error ?? "Please check the form.", false);
				} else if (body.code === "not_configured") {
					setStatus(
						"Sorry — our form isn't accepting messages right now. Please email us directly.",
						false,
					);
				} else {
					setStatus(body.error ?? "Something went wrong. Please try again.", false);
				}
			} catch {
				setStatus("Network error. Please try again.", false);
			} finally {
				if (btn) btn.disabled = false;
				if (btnLabel) btnLabel.textContent = "Send Message";
			}
		});
	}
</script>
