---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	lang?: "en" | "he";
}

const {
	title = "RCK — The Ra'anana Community Kollel",
	description = "A home for Torah, community and growth in Ra'anana, Israel.",
	lang = "en",
} = Astro.props;

const dir = lang === "he" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Oswald:wght@500&family=Heebo:wght@400;500;700;800&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-paper text-ink">
		<slot />
	</body>
</html>
