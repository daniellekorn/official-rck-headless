---
import "../styles/global.css";
import Lightbox from "../components/Lightbox.astro";
import { getThemeSettings, buildThemeStyle } from "../lib/theme";

interface Props {
	lang?: "en" | "he";
}

// Title, description, canonical, and social tags are owned by the Wix dashboard
// (SEO & GEO → SEO Settings) and injected into <head> automatically. Don't add
// them here, or the page will ship duplicate tags.
const { lang = "en" } = Astro.props;

const dir = lang === "he" ? "rtl" : "ltr";

// Client-editable brand colors (ThemeSettings collection). Returns "" when the
// row is empty/unset, so the code defaults in global.css stand. See design-log/028.
const themeStyle = buildThemeStyle(await getThemeSettings());

// Sitewide ReligiousOrganization structured data. Wix's dashboard SEO settings
// already auto-inject a thin LocalBusiness + WebSite JSON-LD block on the
// homepage — this is intentionally separate and richer (founder, founding
// date, socials) and renders on every page, so the two coexist rather than
// one replacing the other.
const orgJsonLd = {
	"@context": "https://schema.org",
	"@type": "ReligiousOrganization",
	name: "RCK – Ra'anana Community Kollel",
	alternateName: "Raanana Community Kollel",
	foundingDate: "1998",
	founder: "Rabbi Dovid Horwitz",
	address: {
		"@type": "PostalAddress",
		streetAddress: "Ahuza St 198",
		addressLocality: "Ra'anana",
		addressCountry: "IL",
	},
	telephone: "+972587945168",
	email: "rckollel@gmail.com",
	sameAs: [
		"https://www.facebook.com/raanana.kollel",
		"https://www.youtube.com/@Rckollel",
		"https://chat.whatsapp.com/Ls2B6uarLZ8Eekn08aZSfc",
	],
};
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Not literally "favicon.png" — Wix's platform reserves /favicon.* and
		     serves its own default icon there regardless of what's deployed, so
		     the tab icon is wired to this filename instead. -->
		<link rel="icon" type="image/png" href="/site-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Oswald:wght@500&family=Heebo:wght@400;500;700;800&family=Frank+Ruhl+Libre:wght@500;700&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
		{themeStyle && <style is:inline set:html={themeStyle}></style>}
		<!-- Dynamic pages fill this slot with Wix-resolved SEO tags. Static pages
		     leave it empty and rely on Wix's automatic tag injection. -->
		<slot name="seo-tags" />
	</head>
	<body class="bg-paper text-ink">
		<slot />
		<Lightbox />
		<script>
			// Scroll-reveal: fade + slide elements in as they enter the viewport.
			// Elements opt in with data-reveal="left|right|up"; data-reveal-delay
			// (ms) staggers siblings. See the [data-reveal] rules in global.css.
			(() => {
				const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
				if (!els.length) return;
				if (typeof IntersectionObserver === "undefined") {
					els.forEach((el) => el.classList.add("is-revealed"));
					return;
				}
				const reveal = (el: HTMLElement) => {
					const delay = Number(el.dataset.revealDelay ?? 0);
					if (delay) {
						el.style.transitionDelay = `${delay}ms`;
						// Clear the delay once the animation has played so a later
						// re-paint (e.g. resize) doesn't re-stagger.
						el.addEventListener(
							"transitionend",
							() => {
								el.style.transitionDelay = "";
							},
							{ once: true },
						);
					}
					el.classList.add("is-revealed");
				};
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							reveal(entry.target as HTMLElement);
							observer.unobserve(entry.target);
						});
					},
					{ threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
				);
				els.forEach((el) => observer.observe(el));
			})();
		</script>
	</body>
</html>
