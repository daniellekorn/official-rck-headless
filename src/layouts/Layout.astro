---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	lang?: "en" | "he";
}

const {
	title = "RCK — The Ra'anana Community Kollel",
	description = "A home for Torah, community and growth in Ra'anana, Israel.",
	lang = "en",
} = Astro.props;

const dir = lang === "he" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&family=Oswald:wght@500&family=Heebo:wght@400;500;700;800&display=swap"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-paper text-ink">
		<slot />
		<script>
			// Scroll-reveal: fade + slide elements in as they enter the viewport.
			// Elements opt in with data-reveal="left|right|up"; data-reveal-delay
			// (ms) staggers siblings. See the [data-reveal] rules in global.css.
			(() => {
				const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
				if (!els.length) return;
				if (typeof IntersectionObserver === "undefined") {
					els.forEach((el) => el.classList.add("is-revealed"));
					return;
				}
				const reveal = (el: HTMLElement) => {
					const delay = Number(el.dataset.revealDelay ?? 0);
					if (delay) {
						el.style.transitionDelay = `${delay}ms`;
						// Clear the delay once the animation has played so a later
						// re-paint (e.g. resize) doesn't re-stagger.
						el.addEventListener(
							"transitionend",
							() => {
								el.style.transitionDelay = "";
							},
							{ once: true },
						);
					}
					el.classList.add("is-revealed");
				};
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							reveal(entry.target as HTMLElement);
							observer.unobserve(entry.target);
						});
					},
					{ threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
				);
				els.forEach((el) => observer.observe(el));
			})();
		</script>
	</body>
</html>
